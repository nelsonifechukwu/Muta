From 8ed6102672b7c65f7669ac1c890c6c33c028895e Mon Sep 17 00:00:00 2001
From: iitimii <timiiowolabi@gmail.com>
Date: Sun, 9 Aug 2026 07:49:54 +0100
Subject: [PATCH 01/16] L1: add bundle_prefix to llama_model_params and
 --bundle-prefix flag

Assisted-by: Claude Fable 5
---
 common/arg.cpp      | 7 +++++++
 common/common.cpp   | 4 ++++
 common/common.h     | 2 ++
 include/llama.h     | 3 +++
 src/llama-model.cpp | 1 +
 5 files changed, 17 insertions(+)

diff --git a/common/arg.cpp b/common/arg.cpp
index 4cb853c..a3addb1 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -2826,6 +2826,13 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
             params.check_tensors = true;
         }
     ));
+    add_opt(common_arg(
+        {"--bundle-prefix"}, "STR",
+        "load only the sub-model with this tensor/KV name prefix from a bundle GGUF (default: unset)",
+        [](common_params & params, const std::string & value) {
+            params.bundle_prefix = value;
+        }
+    ));
     add_opt(common_arg(
         {"--override-kv"}, "KEY=TYPE:VALUE,...",
         "advanced option to override model metadata by key. to specify multiple overrides, either use comma-separated values.\n"
diff --git a/common/common.cpp b/common/common.cpp
index ffe3e77..f6d61bd 100644
--- a/common/common.cpp
+++ b/common/common.cpp
@@ -1610,6 +1610,10 @@ struct llama_model_params common_model_params_to_llama(common_params & params) {
     mparams.use_extra_bufts = !params.no_extra_bufts;
     mparams.no_host         = params.no_host;
 
+    if (!params.bundle_prefix.empty()) {
+        mparams.bundle_prefix = params.bundle_prefix.c_str();
+    }
+
     if (params.kv_overrides.empty()) {
         mparams.kv_overrides = NULL;
     } else {
diff --git a/common/common.h b/common/common.h
index 4811345..71724ae 100644
--- a/common/common.h
+++ b/common/common.h
@@ -567,6 +567,8 @@ struct common_params {
     bool no_kv_offload     = false; // disable KV offloading
     bool warmup            = true;  // warmup run
     bool check_tensors     = false; // validate tensor data
+
+    std::string bundle_prefix = ""; // sub-model prefix for bundle GGUFs (empty = normal load)
     bool no_op_offload     = false; // globally disable offload host tensor operations to device
     bool no_extra_bufts    = false; // disable extra buffer types (used for weight repacking)
     bool no_host           = false; // bypass host buffer allowing extra buffers to be used
diff --git a/include/llama.h b/include/llama.h
index a144989..405ee4f 100644
--- a/include/llama.h
+++ b/include/llama.h
@@ -331,6 +331,9 @@ extern "C" {
         // override key-value pairs of the model meta data
         const struct llama_model_kv_override * kv_overrides;
 
+        // load only the sub-model with this tensor/KV name prefix from a bundle GGUF (NULL = normal load)
+        const char * bundle_prefix;
+
         // Keep the booleans together to avoid misalignment during copy-by-value.
         bool vocab_only;      // only load the vocabulary, no weights
         bool check_tensors;   // validate model tensor data
diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index 4cc1c0a..a3578ee 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -2448,6 +2448,7 @@ llama_model_params llama_model_default_params() {
         /*.progress_callback           =*/ nullptr,
         /*.progress_callback_user_data =*/ nullptr,
         /*.kv_overrides                =*/ nullptr,
+        /*.bundle_prefix               =*/ nullptr,
         /*.vocab_only                  =*/ false,
         /*.check_tensors               =*/ false,
         /*.use_extra_bufts             =*/ true,
-- 
