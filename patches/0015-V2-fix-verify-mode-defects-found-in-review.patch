From fbcdbc94e860da47483c2f406582252cd8a8dddf Mon Sep 17 00:00:00 2001
From: iitimii <timiiowolabi@gmail.com>
Date: Sun, 9 Aug 2026 11:50:26 +0100
Subject: [PATCH 15/16] V2: fix verify-mode defects found in review

- hard cap random_cut segments at seg_max+16 so whitespace-free runs
  cannot grow into full-vocab all-logits batches
- never splice acceptance inside a UTF-8 codepoint
- treat empty-rendering control tokens like EOG corrections
- honor the front draft's error/limit exits (no busy loop)
- reset committed state when a sync ingest fails mid-way
- force front re-ingest after non-whitespace-led corrections (seam)
- peek cuts require the buffer to end on non-whitespace

Assisted-by: Claude Fable 5
---
 tools/duo/duo.cpp | 45 ++++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 40 insertions(+), 5 deletions(-)

diff --git a/tools/duo/duo.cpp b/tools/duo/duo.cpp
index b98a272..371965e 100644
--- a/tools/duo/duo.cpp
+++ b/tools/duo/duo.cpp
@@ -192,7 +192,7 @@ static void print_usage() {
            "  --seg-min N [24]  --seg-max N [96]\n"
            "  --seg-min-expert N --seg-max-expert N   expert-only segment budgets [same]\n"
            "  --p-front F [0.5] --p-expert F [1-p_front]   random mode author probabilities (sum to 1)\n"
-           "  --draft N [16] --draft-max N [48]       verify mode: adaptive front draft length\n"
+           "  --draft N [16] --draft-max N [24]       verify mode: adaptive front draft length\n"
            "  --repair-min N [12]                     verify mode: expert repair span after rejection\n"
            "  --verify-rule logprob|greedy [logprob]  verify mode acceptance rule\n"
            "  --accept-threshold F [-3.0]             logprob rule: accept while expert lp >= F\n"
@@ -345,8 +345,12 @@ static bool sync_to(duo_model & m, const std::string & target, bool parse_specia
     }
 
     const std::string delta = target.substr(m.committed_text.size());
-    std::vector<llama_token> toks = common_tokenize(m.vocab, delta, /*add_special*/ m.committed_text.empty() ? false : false, parse_special);
+    std::vector<llama_token> toks = common_tokenize(m.vocab, delta, /*add_special*/ false, parse_special);
     if (!toks.empty() && !decode_tokens(m, toks)) {
+        // a partial ingest leaves the memory ahead of the bookkeeping; reset both to empty
+        llama_memory_seq_rm(llama_get_memory(m.ctx.get()), 0, 0, -1);
+        m.committed_text.clear();
+        m.committed_tokens.clear();
         return false;
     }
     m.committed_tokens.insert(m.committed_tokens.end(), toks.begin(), toks.end());
@@ -469,8 +473,13 @@ static seg_stats gen_segment(duo_model & m, const gen_opts & opts) {
         const bool ws_start = !piece.empty() && (piece[0] == ' ' || piece[0] == '\n' || piece[0] == '\t');
 
         // peek cut: commit buf without decoding this token
+        if (opts.random_cut && !buf.empty() && (int) buf_toks.size() >= opts.seg_max + 16) {
+            // hard cap: whitespace-free runs (CJK, formulas, URLs) must not grow unbounded
+            st.cut = "cap";
+            break;
+        }
         if (opts.random_cut && opts.seg_min > 0 && ws_start && !buf.empty()) {
-            if ((int) buf_toks.size() >= opts.seg_min) {
+            if ((int) buf_toks.size() >= opts.seg_min && !isspace((unsigned char) buf.back())) {
                 st.cut = "rand";
                 break;
             }
@@ -865,6 +874,15 @@ static std::string run_verify_turn(duo_state & s, const std::string & user) {
                 }
                 accepted++;
             }
+            // never splice inside a UTF-8 codepoint: if the first rejected piece starts with a
+            // continuation byte, retreat until the boundary is a codepoint boundary
+            while (accepted > 0 && accepted < m) {
+                const std::string next = common_token_to_piece(ex.ctx.get(), d[accepted], false);
+                if (next.empty() || ((unsigned char) next[0] & 0xC0) != 0x80) {
+                    break;
+                }
+                accepted--;
+            }
             n_accepted += accepted;
             n_rounds++;
 
@@ -894,7 +912,10 @@ static std::string run_verify_turn(duo_state & s, const std::string & user) {
                 const float * crow = accepted == 0 ? prev_row.data()
                                                    : llama_get_logits_ith(ex.ctx.get(), accepted - 1);
                 const llama_token c = argmax_row(crow, n_vocab);
-                const bool c_ends = llama_vocab_is_eog(ex.vocab, c);
+                const std::string c_piece = common_token_to_piece(ex.ctx.get(), c, false);
+                // EOG or any control token that renders as no text ends the turn instead of
+                // silently desyncing text from state
+                const bool c_ends = llama_vocab_is_eog(ex.vocab, c) || c_piece.empty();
 
                 // rollback to the checkpoint, then re-decode accepted prefix (+ correction) in one batch
                 llama_memory_seq_rm(mem, 0, -1, -1);
@@ -905,7 +926,7 @@ static std::string run_verify_turn(duo_state & s, const std::string & user) {
                 for (int i = 0; i < accepted; i++) {
                     acc_text += common_token_to_piece(ex.ctx.get(), d[i], false);
                 }
-                const std::string c_text = c_ends ? "" : common_token_to_piece(ex.ctx.get(), c, false);
+                const std::string c_text = c_ends ? "" : c_piece;
 
                 const int n_redo = accepted + (c_ends ? 0 : 1);
                 if (n_redo > 0) {
@@ -953,6 +974,15 @@ static std::string run_verify_turn(duo_state & s, const std::string & user) {
                     continue;
                 }
 
+                // a non-whitespace-led correction can create a seam the front's incremental
+                // tokenizer would encode non-canonically; force it to re-ingest from scratch
+                if (!c_text.empty() && strchr(" \n\t", c_text[0]) == nullptr) {
+                    llama_memory_seq_rm(llama_get_memory(fr.ctx.get()), 0, 0, -1);
+                    fr.committed_text.clear();
+                    fr.committed_tokens.clear();
+                    fr.n_full_resync++;
+                }
+
                 // expert repair span, then hand the pen back to the front;
                 // repair grows with consecutive rejects so hostile stretches degrade toward expert-alone speed
                 consec_rejects = std::min(consec_rejects + 1, 3);
@@ -982,6 +1012,11 @@ static std::string run_verify_turn(duo_state & s, const std::string & user) {
             }
         }
 
+        if (dst.turn_done && dst.cut != "eos" && turn_open) {
+            // front hit its token limit or a decode error; do not spin on an empty draft
+            turn_open = false;
+        }
+
         if (front_eos && turn_open) {
             if (!p.closer_expert) {
                 turn_open = false;
-- 
