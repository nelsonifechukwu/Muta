---
 tools/duo/duo.cpp | 76 +++++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 73 insertions(+), 3 deletions(-)

diff --git a/tools/duo/duo.cpp b/tools/duo/duo.cpp
index 58be975..e71c078 100644
--- a/tools/duo/duo.cpp
+++ b/tools/duo/duo.cpp
@@ -30,6 +30,7 @@
 #include <fstream>
 #include <iostream>
 #include <string>
+#include <unistd.h>
 #include <vector>
 
 struct duo_params {
@@ -66,6 +67,7 @@ struct duo_params {
     bool selftest_seams = false;
     bool route_only     = false;
     bool quiet          = false;
+    int  stream         = -1;   // -1 auto (on in chat), 0 off, 1 on
 };
 
 struct duo_model {
@@ -76,6 +78,7 @@ struct duo_model {
     const llama_vocab * vocab = nullptr;
     common_chat_templates_ptr tmpls;
     bool append_only = false;
+    const char * color = "\033[36m";
 
     // committed = rendered prompt + ingested transcript; always in sync with the context state
     std::string              committed_text;
@@ -99,6 +102,52 @@ struct seg_stats {
 
 static FILE * g_json = nullptr;
 
+// live token streaming to stdout; model switches shown via color (TTY) or [name] tags
+struct stream_state {
+    bool on    = false;
+    bool color = false;
+    const void * last_author = nullptr;
+};
+static stream_state g_stream;
+
+static void stream_begin(const void * author, const char * name, const char * color_code) {
+    if (!g_stream.on || g_stream.last_author == author) {
+        return;
+    }
+    if (g_stream.color) {
+        printf("\033[0m%s", color_code);
+    } else {
+        printf("%s[%s] ", g_stream.last_author ? "\n" : "", name);
+    }
+    fflush(stdout);
+    g_stream.last_author = author;
+}
+
+static void stream_piece(const std::string & piece) {
+    if (g_stream.on) {
+        fwrite(piece.data(), 1, piece.size(), stdout);
+        fflush(stdout);
+    }
+}
+
+static void stream_marker(const char * text) {
+    if (g_stream.on) {
+        printf(g_stream.color ? "\033[0;2m%s\033[0m" : "%s", text);
+        fflush(stdout);
+        if (g_stream.color && g_stream.last_author) {
+            g_stream.last_author = nullptr; // force color re-emit for the next author
+        }
+    }
+}
+
+static void stream_end_turn() {
+    if (g_stream.on) {
+        printf(g_stream.color ? "\033[0m\n" : "\n");
+        fflush(stdout);
+        g_stream.last_author = nullptr;
+    }
+}
+
 static void jtrace(const char * fmt, ...) {
     if (!g_json) {
         return;
@@ -130,6 +179,7 @@ static void print_usage() {
            "  --seg-min-expert N --seg-max-expert N   expert-only segment budgets [same]\n"
            "  --route-only            print route scores only, do not answer\n"
            "  -q, --quiet             suppress library logs (traces stay)\n"
+           "  --stream / --no-stream  live token output with per-model colors [auto: on in chat]\n"
            "\n"
            "with no -p and no --prompts-file, reads chat turns from stdin\n"
            "  --closer expert|either  [expert]\n"
@@ -173,6 +223,8 @@ static bool parse_args(int argc, char ** argv, duo_params & p) {
         else if (arg == "--seg-max-expert")  { p.seg_max_expert = atoi(need("--seg-max-expert")); }
         else if (arg == "--route-only")      { p.route_only = true; }
         else if (arg == "-q" || arg == "--quiet") { p.quiet = true; }
+        else if (arg == "--stream")          { p.stream = 1; }
+        else if (arg == "--no-stream")       { p.stream = 0; }
         else if (arg == "--closer")          { p.closer_expert = std::string(need("--closer")) == "expert"; }
         else if (arg == "--carry-draft")     { p.carry_draft = true; }
         else if (arg == "-n" || arg == "--n-predict") { p.n_predict = atoi(need("-n")); }
@@ -400,6 +452,11 @@ static seg_stats gen_segment(duo_model & m, const gen_opts & opts) {
                 for (double v : lp_window) mean += v;
                 mean /= (double) lp_window.size();
                 if (mean < opts.conf_threshold && last_boundary != std::string::npos) {
+                    if (buf.size() > last_boundary) {
+                        char marker[64];
+                        snprintf(marker, sizeof(marker), " [[conf-cut -%zuch]] ", buf.size() - last_boundary);
+                        stream_marker(marker);
+                    }
                     buf.resize(last_boundary);
                     st.cut = "conf";
                     break;
@@ -428,6 +485,8 @@ static seg_stats gen_segment(duo_model & m, const gen_opts & opts) {
             st.turn_done = true;
             break;
         }
+        stream_begin(&m, m.name.c_str(), m.color);
+        stream_piece(piece);
         buf += piece;
         buf_toks.push_back(tok);
     }
@@ -535,6 +594,7 @@ static std::string run_router_turn(duo_state & s, const std::string & user) {
             author = "front+expert";
             if (!p.carry_draft) {
                 transcript.clear();
+                stream_marker("\n[[draft discarded; expert restarts]]\n");
             }
             std::string target = render_prompt(s.expert, s.sys_expert, s.history, user, false) + transcript;
             if (!sync_to(s.expert, target, true)) {
@@ -676,6 +736,12 @@ int main(int argc, char ** argv) {
     duo_state s;
     s.p = p;
     s.expert.append_only = true;
+    s.front.color  = "\033[36m";   // cyan
+    s.expert.color = "\033[33m";   // yellow
+
+    const bool interactive = p.prompt.empty() && p.prompts_file.empty();
+    g_stream.on    = !p.route_only && (p.stream == 1 || (p.stream == -1 && interactive));
+    g_stream.color = isatty(STDOUT_FILENO);
 
     fprintf(stderr, "loading front  ('%s') from %s\n", p.front_prefix.c_str(), p.bundle.c_str());
     if (!load_duo_model(s.front, p, "front", p.front_prefix, p.ctx_front, p.temp_front, p.top_p_front)) {
@@ -711,8 +777,12 @@ int main(int argc, char ** argv) {
         }
         std::string answer = p.mode == "codraft" ? run_codraft_turn(s, user)
                                                  : run_router_turn(s, user);
-        printf("%s\n", answer.c_str());
-        fflush(stdout);
+        if (g_stream.on) {
+            stream_end_turn();  // answer already streamed
+        } else {
+            printf("%s\n", answer.c_str());
+            fflush(stdout);
+        }
 
         if (p.selftest_seams && p.mode == "codraft") {
             selftest_seams(s);
@@ -720,7 +790,7 @@ int main(int argc, char ** argv) {
         s.history.push_back({ user, answer });
     };
 
-    if (p.prompt.empty() && p.prompts_file.empty()) {
+    if (interactive) {
         // interactive chat on stdin
         fprintf(stderr, "\nchat mode (%s): type a message and press enter; /exit or Ctrl-D to quit\n", p.mode.c_str());
         std::string line;
