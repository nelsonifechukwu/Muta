                 res_mib(r->info.streamed_bytes), (double) r->params.disk_gbps);
     }
 
+    // One graph is built and executed per ubatch, and the gate walks the whole
+    // ring in every one of them, so a prompt costs the ring walk once per ubatch
+    // rather than once in total. That is the design, not a leak: the window is
+    // what bounds RAM, and it holds W+1 units whether the walk runs once or a
