diff --git a/src/llama-residency.cpp b/src/llama-residency.cpp
index 2c11fd6..968a8b8 100644
--- a/src/llama-residency.cpp
+++ b/src/llama-residency.cpp
@@ -18,6 +18,7 @@
 #include <mutex>
 #include <string>
 #include <thread>
+#include <unordered_map>
 #include <vector>
 
 #ifdef __has_include
@@ -135,6 +136,16 @@ struct llama_residency {
     int head_unit = -1;
     int misc_unit = -1;
 
+    // graph gate (S2): every mapped weight tensor pointer -> its unit id, built
+    // once at init so the callback never parses a tensor name while a graph runs.
+    std::unordered_map<const ggml_tensor *, int32_t> unit_of;
+
+    // the unit the last gate fired on, i.e. the ring position the window is
+    // currently anchored at. Written by the ASK half of the callback and read
+    // back by its POST half, both on the scheduler's compute thread; atomic so
+    // that a reader on any other thread is still well defined.
+    std::atomic<int32_t> gate_unit{-1};
+
     llama_residency_info info = {};
 
     // the manager thread and its FIFO. every verb runs here and only here.
@@ -360,6 +371,54 @@ static bool res_build_units(llama_residency * r, const llama_model * model) {
     r->info.head_tied  = !has_output_weight;
     r->info.head_bytes = r->head_unit >= 0 ? r->units[r->head_unit].bytes : 0;
 
+    // ---- the graph gate's node -> unit map ---------------------------------
+    //
+    // Classification repeats the pass above, but against the FINAL unit ids:
+    // the ordering loop puts blk.il at unit id il (the hole check above is what
+    // makes that identity safe), the head next and misc last. Every entry is
+    // cross-checked against the unit's own extent, so an id that ever stopped
+    // agreeing with the table is a load-time error rather than a silent
+    // mis-gate at 30 tokens per second.
+    r->unit_of.reserve(model->tensors_by_name.size() * 2);
+
+    for (const auto & it : model->tensors_by_name) {
+        const std::string        & name = it.first;
+        const struct ggml_tensor * t    = it.second;
+
+        if (t == nullptr || t->data == nullptr) {
+            continue;
+        }
+
+        int     il   = -1;
+        int32_t unit = -1;
+
+        if (sscanf(name.c_str(), "blk.%d.", &il) == 1 && il >= 0) {
+            unit = il;
+        } else if (name == "token_embd.weight" || name == "output.weight") {
+            unit = r->head_unit;
+        } else {
+            unit = r->misc_unit;
+        }
+
+        if (unit < 0 || unit >= (int32_t) r->units.size()) {
+            LLAMA_LOG_ERROR("residency: tensor '%s' resolved to unit %d, outside the %zu-unit table\n",
+                    name.c_str(), unit, r->units.size());
+            return false;
+        }
+
+        const size_t off = (size_t) ((const uint8_t *) t->data - r->base);
+        const auto & un  = r->units[unit];
+
+        if (off < un.off_min || off + ggml_nbytes(t) > un.off_max) {
+            LLAMA_LOG_ERROR("residency: tensor '%s' at [%zu, %zu) is not inside unit %s's extent "
+                    "[%zu, %zu) -- the unit id space and the node map disagree\n",
+                    name.c_str(), off, off + ggml_nbytes(t), un.name.c_str(), un.off_min, un.off_max);
+            return false;
+        }
+
+        r->unit_of[t] = unit;
+    }
+
     return true;
 }
 
