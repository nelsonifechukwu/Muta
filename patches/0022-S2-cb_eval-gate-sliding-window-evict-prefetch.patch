+            "(the ring walks once per ubatch graph -- expected, not a bug)\n",
+            res_mib(r->info.streamed_bytes));
+
     if (!chosen.head_pinned && head_bytes > 0) {
         if (r->params.disk_gbps > 0.0f) {
             LLAMA_LOG_WARN("residency: HEAD IS STREAMED: +%.3f s/token for the head alone "
@@ -980,14 +1049,126 @@ void llama_residency_free(struct llama_residency * res) {
     delete res;
 }
 
+// ---------------------------------------------------------------------------
+// the graph gate
+// ---------------------------------------------------------------------------
+
+static int32_t res_lookup(const llama_residency * r, const ggml_tensor * t) {
+    if (t == nullptr) {
+        return -1;
+    }
+    const auto it = r->unit_of.find(t);
+    return it == r->unit_of.end() ? -1 : it->second;
+}
+
+// Which unit's weights does this node read? Pointer lookups only: every source
+// of the node, and each source's view base, is tried against the map built at
+// init. One level of view_src is enough because ggml collapses a view of a view
+// onto the ultimate base at creation time (ggml.c:1777-1779).
+//
+// The head is the one ambiguity, and it is not a corner case: with tied
+// embeddings token_embd.weight IS the output matrix (models/qwen35.cpp:52
+// creates the head with TENSOR_DUPLICATED and the loader hands back the tensor
+// that already exists), so one pointer appears twice in every graph -- in the
+// GGML_OP_GET_ROWS embedding lookup at the very start, and in the
+// GGML_OP_MUL_MAT logits projection at the very end. Only the matmul is the
+// head's real use. Gating on the lookup would fire the head's window logic at
+// the wrong end of the graph: the head sits last in the ring, so its window
+// wraps to ring[0], and the wrap would happen BEFORE the first layer instead of
+// after the last one, evicting most of the ring on the way in and again on the
+// way out. So for the head unit, anything that is not a matmul resolves to "no
+// unit"; the lookup is then served by demand faults over the few rows it reads
+// (2100 B per token at n_embd 2560, q6_K), which is correct and cheap.
+static int32_t res_unit_of_node(const llama_residency * r, const ggml_tensor * t) {
+    if (t == nullptr) {
+        return -1;
+    }
+
+    for (int i = 0; i < GGML_MAX_SRC; i++) {
+        const ggml_tensor * src = t->src[i];
+        if (src == nullptr) {
+            continue;
+        }
+
+        int32_t u = res_lookup(r, src);
+        if (u < 0 && src->view_src != nullptr) {
+            u = res_lookup(r, src->view_src);
+        }
+        if (u < 0) {
+            continue;
+        }
+        if (u == r->head_unit && t->op != GGML_OP_MUL_MAT) {
+            continue; // see above: the embedding lookup is not the head's use
+        }
+        return u;
+    }
+
+    return -1;
+}
+
+// The scheduler's eval callback, and the only thing that drives the ring during
+// real execution. Its contract (ggml/src/ggml-backend.cpp:1730-1767):
+//
+//   ASK(t, true)  is called on node after node in a coalescing loop. Returning
+//                 false lets the scheduler swallow the node into the current
+//                 chunk; returning true ends the chunk AT t, so nodes [j0..j1]
+//                 -- t included -- are computed, the backend is synchronized,
+//                 and POST(t, false) follows. Returning false from POST aborts
+//                 the graph, so POST here always returns true.
+//
+// The gate anchors on POST for the ordering it buys: at the POST of the first
+// node that touches unit N, every node ahead of it in the graph has run, so all
+// of unit N-1 is provably finished and safe to evict, while unit N itself is in
+// the window and stays. ASK is the filter, not the event -- the scheduler's
+// lookahead means ASK can probe well ahead of what has executed, so the only
+// safe test there is "is this a streamed unit the graph has not already gated
+// on", which is exactly the coalescing rule that makes one gate per unit.
+//
+// There is no graph-start signal in this contract, and the gate does not need
+// one. llama_residency_on_gate_post() is idempotent and absolute rather than
+// incremental: it evicts every resident streamed unit OUTSIDE [u, u+W] and
+// prefetches everything inside it that is missing, computed from u alone. A
+// missed boundary, a graph that starts mid-ring, a KV-shift graph that gates
+// not at all, a prefill ubatch that stops early -- none of them can leave the
+// ring in a state the next gate does not correct, because the next gate does
+// not consult the previous one. gate_unit carries across graphs on purpose: it
+// makes the first gate of graph G+1 fire iff its unit differs from the last one
+// graph G gated on, which is the normal case (a graph ends on the last ring
+// unit and the next one starts on the first). The single degenerate case is a
+// ring of exactly one unit, where the window is the whole ring anyway and there
+// is nothing for a gate to move.
 bool llama_residency_sched_eval_cb(struct ggml_tensor * t, bool ask, void * user_data) {
-    GGML_UNUSED(t);
-    GGML_UNUSED(user_data);
+    llama_residency * r = (llama_residency *) user_data;
 
-    // S1b installs the seam only. ASK -> false (no node is observed yet),
-    // POST -> true (never abort the graph). Node -> unit resolution and the
-    // llama_residency_on_gate_post() call land in S2/B3.
-    return !ask;
+    if (r == nullptr || r->ring.empty()) {
+        return !ask; // nothing streams: coalesce through, never abort
+    }
+
+    if (!ask) {
+        // POST. Runs on the compute thread; on_gate_post takes the manager lock
+        // only to append to its queue and never issues a syscall.
+        const int32_t u = r->gate_unit.load(std::memory_order_relaxed);
+        if (u >= 0) {
+            llama_residency_on_gate_post(r, (int) u);
+        }
+        return true;
+    }
+
+    const int32_t u = res_unit_of_node(r, t);
+
+    // no unit (activations only), misc, or a unit the ledger pinned: nothing to
+    // slide, so let the scheduler keep coalescing.
+    if (u < 0 || r->units[u].pinned) {
+        return false;
+    }
+
+    if (u == r->gate_unit.load(std::memory_order_relaxed)) {
+        return false; // already gated on this unit, this is a later node of it
+    }
+
+    r->gate_unit.store(u, std::memory_order_relaxed);
+
+    return true;
 }
 
 void llama_residency_suspend(struct llama_residency * res) {
@@ -995,6 +1176,11 @@ void llama_residency_suspend(struct llama_residency * res) {
         return;
     }
 
+    // the ring is about to be emptied, so the anchor the gate would compare
+    // against is meaningless: forget it, and let the first gate after a resume
+    // fire whatever unit it lands on.
+    res->gate_unit.store(-1, std::memory_order_relaxed);
+
     {
         std::lock_guard<std::mutex> lk(res->mtx);
         res->q.clear();
