-            const int ext_cap = std::min(3 * p.seg_max, p.n_predict / 2);
             const std::string fprompt = render_prompt(front, s.sys_front, s.history, user, false);
             while (s.mid->state.load(std::memory_order_acquire) != TS_READY &&
-                   n_tokens + p.seg_min <= ext_cap) {
+                   n_tokens + p.seg_min <= front_cap) {
                 if (!sync_to(front, fprompt + transcript, true)) {
