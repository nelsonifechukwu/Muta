-        // mlocks only the range this model actually uses (grow_to(offs+size) over the
-        // bundle mapping, llama-model-loader.cpp:1594), so a bundle member locks its own
-        // ~100 MiB, not the whole file; everything past its last tensor is unmapped and
-        // fadvise-discarded right after (llama-model-loader.cpp:1729-1745).
+        // Load-time half of tier policy: keep this tier's weights unswappable.
+        //
+        // The locked range is HEADER-INCLUSIVE, which is not obvious: the loader grows the
+        // lock from the MAPPING BASE (grow_to(weight->offs + n_size),
+        // llama-model-loader.cpp:1594), so a bundle member locks its own tensor span PLUS
+        // everything in the file ahead of it -- the shared bundle header/KV, which for a
+        // trio bundle holds two 248k-token vocab arrays. Measured (S3.3):
+        //   muta-trio.gguf  front m0.  127,389,760 B = 121.5 MiB  ( 98.9 MiB weights + 22.6 MiB header)
+        //   muta-duo-q.gguf front m0.  560,670,336 B = 534.7 MiB  (513.8 MiB weights + 20.9 MiB header)
+        // C4's ledger cross-term mlock_front_mib must use the LOCK RANGE above, not the
+        // model's tensor span, or it under-counts by the header. What the lock does NOT
+        // cover is the rest of the bundle: everything past this model's last tensor is
+        // unmapped and fadvise-discarded right after the load
+        // (llama-model-loader.cpp:1729-1745).
+        //
         // If the lock is refused (EPERM/ENOMEM) llama.cpp warns and carries on with a
-        // plain mmap -- degraded residency, identical output.
+        // plain mmap -- degraded residency, identical output. NOTE: -q suppresses that
+        // warning (the quiet callback passes only ERROR), so a run that must ASSERT
+        // residency has to drop -q.
         mparams.load_mode = LLAMA_LOAD_MODE_MMAP_MLOCK;
     }
 
@@ -816,6 +828,11 @@ static seg_stats gen_segment(duo_model & m, const gen_opts & opts) {
         }
 
         common_sampler_accept(m.smpl.get(), tok, true);
+        // TTFT is stamped HERE, not after the decode below: every cut check has passed, so
+        // this token is part of the answer, and the llama_decode that follows is prefill for
+        // the NEXT token -- charging it to the first one would inflate G11's headline number
+        // by a whole decode step.
+        ttft_note_first_token();
         llama_token t = tok;
         if (llama_decode(m.ctx.get(), llama_batch_get_one(&t, 1)) != 0) {
             fprintf(stderr, "error: %s decode failed mid-segment\n", m.name.c_str());
@@ -825,7 +842,6 @@ static seg_stats gen_segment(duo_model & m, const gen_opts & opts) {
         }
         stream_begin(&m, m.name.c_str(), m.color);
         stream_piece(piece);
-        ttft_note_first_token();
         buf += piece;
         buf_toks.push_back(tok);
     }
@@ -978,8 +994,15 @@ struct duo_state {
     // while the state it references is still alive -- no detached thread, no
     // use-after-free, and no std::terminate from a joinable ~thread().
     struct loader_joiner {
-        std::thread th;
+        std::thread        th;
+        std::atomic<bool> * stop = nullptr;   // -> loader_stop, declared above, so still alive here
         ~loader_joiner() {
+            // request the skip BEFORE joining, exactly as the normal teardown path does:
+            // otherwise an early return would sit through every remaining tier load just to
+            // exit. Set on the error paths too -- there is nothing left to load for.
+            if (stop) {
+                stop->store(true, std::memory_order_release);
+            }
             if (th.joinable()) {
                 th.join();
             }
@@ -1011,19 +1034,27 @@ static duo_tier * tier_acquire(duo_state & s, duo_tier * t, const char * why) {
     }
     if (st != TS_FAILED) {
         const int64_t t0 = ggml_time_us();
-        if (g_trace) {
-            fprintf(stderr, "[tier] waiting for %s (loading)%s%s\n",
-                    tier_role_name(t->role), why ? " reason=" : "", why ? why : "");
-        }
+        bool waited = false;
         {
             std::unique_lock<std::mutex> lk(s.tier_mu);
-            s.tier_cv.wait(lk, [&] {
-                const tier_state cur = t->state.load(std::memory_order_acquire);
-                return cur == TS_READY || cur == TS_FAILED;
-            });
+            // re-check UNDER the lock before announcing a wait: the tier can turn READY
+            // between the fast path above and this point, and a "waiting for mid" line that
+            // is immediately followed by generation is a lie in the G11 evidence
+            st = t->state.load(std::memory_order_acquire);
+            if (st != TS_READY && st != TS_FAILED) {
+                waited = true;
+                if (g_trace) {
+                    fprintf(stderr, "[tier] waiting for %s (loading)%s%s\n",
+                            tier_role_name(t->role), why ? " reason=" : "", why ? why : "");
+                }
+                s.tier_cv.wait(lk, [&] {
+                    const tier_state cur = t->state.load(std::memory_order_acquire);
+                    return cur == TS_READY || cur == TS_FAILED;
+                });
+            }
         }
         st = t->state.load(std::memory_order_acquire);
-        if (g_trace && st == TS_READY) {
+        if (g_trace && waited && st == TS_READY) {
             fprintf(stderr, "[tier] %s acquired wait_ms=%.1f\n",
                     tier_role_name(t->role), (ggml_time_us() - t0) / 1e3);
         }
@@ -1206,15 +1237,18 @@ static void tier_load_bg(duo_state & s, duo_tier * t, const char * name, bool ch
     if (!ok) {
         s.loader_failed.store(true, std::memory_order_release);
     }
-    // publish LAST: everything above is ordered before the release store, so a consumer
-    // that acquires TS_READY sees a fully constructed model/ctx/sampler/templates
-    tier_publish(s, *t, ok ? TS_READY : TS_FAILED);
+    // Trace BEFORE publishing. Publishing wakes a waiter that immediately prints its own
+    // "[tier] X acquired" line, so tracing afterwards races the consumer and can print the
+    // cause after the effect -- unreadable in exactly the overlap traces G11 is read from.
     if (g_trace) {
         fprintf(stderr, "[tier] %s %s load_ms=%.1f\n", tier_role_name(t->role),
                 ok ? "ready" : "FAILED", load_ms);
     }
     jtrace("{\"type\":\"tier\",\"name\":\"%s\",\"state\":\"%s\",\"load_ms\":%.1f}",
            tier_role_name(t->role), ok ? "ready" : "failed", load_ms);
+    // publish LAST: everything above is ordered before the release store, so a consumer
+    // that acquires TS_READY sees a fully constructed model/ctx/sampler/templates
+    tier_publish(s, *t, ok ? TS_READY : TS_FAILED);
 }
 
 // the whole background thread: easy then mid, serialized, in registry order
@@ -1273,6 +1307,17 @@ static std::string run_router_turn(duo_state & s, const std::string & user) {
     std::string opener_text;
     int64_t opener_us = 0;
 
+    // Budget ceiling for EVERYTHING the front writes this turn -- the opener and any
+    // overlap-extension segments together. Two limits:
+    //   3*seg_max   - a pathologically slow tier load must not let the 135M write the
+    //                 whole answer;
+    //   n_predict/2 - so the ROUTED tier always gets at least half the answer budget.
+    // Both halves are load-bearing and both were found by measurement: at -n 128 the
+    // 3*seg_max cap alone let opener+extensions consume all 128 tokens and hand the expert
+    // a zero budget, and the opener ALONE could do the same at -n 64 while it was still
+    // clamped to p.n_predict.
+    const int front_cap = std::min(3 * p.seg_max, p.n_predict / 2);
+
     // ---- TTFT opener: the front speaks before the route is known (first turn only) ----
     // The front is the mlocked always-resident tier, so its first token lands at 135M
     // latency while the routing decode (and, from C3, a tier load) still has to happen.
@@ -1280,7 +1325,7 @@ static std::string run_router_turn(duo_state & s, const std::string & user) {
     // it as a carry-draft with an exact delta tokenization.
     if (opener_enabled(s) && s.history.empty()) {
         if (sync_to(front, render_prompt(front, s.sys_front, s.history, user, false), true)) {
-            gen_opts oopts = { p.seg_min, p.seg_max, p.n_predict, /*conf*/ true,
+            gen_opts oopts = { p.seg_min, p.seg_max, front_cap, /*conf*/ true,
                                p.conf_window, p.conf_threshold, /*eos_ends*/ false };
             seg_stats ost = gen_segment(front, oopts);
             transcript  = ost.text;
@@ -1391,31 +1436,39 @@ static std::string run_router_turn(duo_state & s, const std::string & user) {
         // ---- hard path: the mid tier answers, but it may still be loading ----
         //
         // G11's overlap mechanism. If an opener already ran, the front does not go quiet
