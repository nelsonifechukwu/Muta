From 5eed58b8e2fbd1a5914e35f2fe52555ed71bef02 Mon Sep 17 00:00:00 2001
From: iitimii <timiiowolabi@gmail.com>
Date: Sun, 9 Aug 2026 07:52:50 +0100
Subject: [PATCH 04/16] L4: route vocab and model metadata reads through bundle
 prefix

Assisted-by: Claude Fable 5
---
 src/llama-model.cpp |  8 +++++++-
 src/llama-vocab.cpp | 14 +++++++-------
 2 files changed, 14 insertions(+), 8 deletions(-)

diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index a3578ee..76f9cce 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -1072,7 +1072,13 @@ void llama_model_base::load_hparams(llama_model_loader & ml) {
         if (type == GGUF_TYPE_ARRAY) {
             continue;
         }
-        const char * name = gguf_get_key(ctx, i);
+        std::string name = gguf_get_key(ctx, i);
+        if (!ml.bundle_prefix.empty()) {
+            if (name.compare(0, ml.bundle_prefix.size(), ml.bundle_prefix) != 0) {
+                continue;
+            }
+            name = name.substr(ml.bundle_prefix.size());
+        }
         const std::string value = gguf_kv_to_str(ctx, i);
         gguf_kv.emplace(name, value);
     }
diff --git a/src/llama-vocab.cpp b/src/llama-vocab.cpp
index 4a01dfd..f05c617 100644
--- a/src/llama-vocab.cpp
+++ b/src/llama-vocab.cpp
@@ -1978,7 +1978,7 @@ void llama_vocab::impl::load(llama_model_loader & ml, const LLM_KV & kv) {
             type = LLAMA_VOCAB_TYPE_BPE;
 
             // read bpe merges and populate bpe ranks
-            const int merges_keyidx = gguf_find_key(ctx, kv(LLM_KV_TOKENIZER_MERGES).c_str());
+            const int merges_keyidx = gguf_find_key(ctx, ml.resolve_key(kv(LLM_KV_TOKENIZER_MERGES)).c_str());
             // Kimi-K2 uses custom tokenization without traditional BPE merges
             const bool is_kimi_k2 = (tokenizer_pre == "kimi-k2");
 
@@ -2026,7 +2026,7 @@ void llama_vocab::impl::load(llama_model_loader & ml, const LLM_KV & kv) {
             special_pad_id  = 0;
             special_mask_id = LLAMA_TOKEN_NULL;
 
-            const int precompiled_charsmap_keyidx = gguf_find_key(ctx, kv(LLM_KV_TOKENIZER_PRECOMPILED_CHARSMAP).c_str());
+            const int precompiled_charsmap_keyidx = gguf_find_key(ctx, ml.resolve_key(kv(LLM_KV_TOKENIZER_PRECOMPILED_CHARSMAP)).c_str());
             if (precompiled_charsmap_keyidx != -1) {
                 const gguf_type pc_type = gguf_get_arr_type(ctx, precompiled_charsmap_keyidx);
                 GGML_ASSERT(pc_type == GGUF_TYPE_INT8 || pc_type == GGUF_TYPE_UINT8);
@@ -2076,7 +2076,7 @@ void llama_vocab::impl::load(llama_model_loader & ml, const LLM_KV & kv) {
             type = LLAMA_VOCAB_TYPE_BPE;
 
             // read bpe merges and populate bpe ranks
-            const int merges_keyidx = gguf_find_key(ctx, kv(LLM_KV_TOKENIZER_MERGES).c_str());
+            const int merges_keyidx = gguf_find_key(ctx, ml.resolve_key(kv(LLM_KV_TOKENIZER_MERGES)).c_str());
             if (merges_keyidx == -1) {
                 throw std::runtime_error("cannot find tokenizer merges in model file\n");
             }
@@ -2402,7 +2402,7 @@ void llama_vocab::impl::load(llama_model_loader & ml, const LLM_KV & kv) {
         ml.get_key(LLM_KV_TOKENIZER_REMOVE_EXTRA_WS, remove_extra_whitespaces, false);
     }
 
-    const int token_idx = gguf_find_key(ctx, kv(LLM_KV_TOKENIZER_LIST).c_str());
+    const int token_idx = gguf_find_key(ctx, ml.resolve_key(kv(LLM_KV_TOKENIZER_LIST)).c_str());
     if (token_idx == -1) {
         throw std::runtime_error("cannot find tokenizer vocab in model file\n");
     }
@@ -2410,7 +2410,7 @@ void llama_vocab::impl::load(llama_model_loader & ml, const LLM_KV & kv) {
     const uint32_t n_tokens = gguf_get_arr_n(ctx, token_idx);
 
     const float * scores = nullptr;
-    const int score_idx = gguf_find_key(ctx, kv(LLM_KV_TOKENIZER_SCORES).c_str());
+    const int score_idx = gguf_find_key(ctx, ml.resolve_key(kv(LLM_KV_TOKENIZER_SCORES)).c_str());
     if (score_idx != -1) {
         const uint32_t n_scores = gguf_get_arr_n(ctx, score_idx);
         if (n_scores < n_tokens) {
@@ -2420,7 +2420,7 @@ void llama_vocab::impl::load(llama_model_loader & ml, const LLM_KV & kv) {
     }
 
     const int * toktypes = nullptr;
-    const int toktype_idx = gguf_find_key(ctx, kv(LLM_KV_TOKENIZER_TOKEN_TYPE).c_str());
+    const int toktype_idx = gguf_find_key(ctx, ml.resolve_key(kv(LLM_KV_TOKENIZER_TOKEN_TYPE)).c_str());
     if (toktype_idx != -1) {
         const uint32_t n_toktypes = gguf_get_arr_n(ctx, toktype_idx);
         if (n_toktypes < n_tokens) {
@@ -2582,7 +2582,7 @@ void llama_vocab::impl::load(llama_model_loader & ml, const LLM_KV & kv) {
 
         // suppress tokens
         {
-            const int suppress_idx = gguf_find_key(ctx, kv(LLM_KV_TOKENIZER_SUPPRESS_TOKENS).c_str());
+            const int suppress_idx = gguf_find_key(ctx, ml.resolve_key(kv(LLM_KV_TOKENIZER_SUPPRESS_TOKENS)).c_str());
             if (suppress_idx != -1) {
                 const int n = gguf_get_arr_n(ctx, suppress_idx);
                 const int32_t * data = (const int32_t *) gguf_get_arr_data(ctx, suppress_idx);
-- 
