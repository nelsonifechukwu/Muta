+
+    // ---- staged startup (S3.3) ----
+    //
+    // Exactly one background thread loads every non-front tier, serially: serialized
+    // loads bound the RAM spike (one model's transient allocations at a time) and keep
+    // the loader from fighting the decode threads for cores more than necessary.
+    //
+    // Ownership rule that makes this safe without locking the models themselves:
+    //   - the MAIN thread writes front's state (before the loader thread exists);
+    //   - the LOADER thread is the only writer of every other tier's state and of that
+    //     tier's duo_model, and it publishes with a release store under tier_mu;
+    //   - the main thread only touches a tier's duo_model after an ACQUIRE load has
+    //     observed TS_READY, which orders the whole construction before that use.
+    // So no duo_model is ever written by two threads, and no context is ever decoded
+    // from two threads (the loader never decodes).
+    std::mutex              tier_mu;
+    std::condition_variable tier_cv;
+    bool                    mid_checkpoint = false;  // mid needs seq 1 (verify modes)
+    std::atomic<bool>       loader_stop { false };   // teardown: skip tiers not started yet
+    std::atomic<bool>       loader_failed { false }; // a background load failed
+
+    // Declared LAST on purpose: members are destroyed in reverse declaration order, so
+    // this joiner runs BEFORE tiers/tier_mu/tier_cv are destroyed. That makes every
+    // early return from main() (bad flags, load error, --route-only) join the loader
+    // while the state it references is still alive -- no detached thread, no
+    // use-after-free, and no std::terminate from a joinable ~thread().
+    struct loader_joiner {
+        std::thread th;
+        ~loader_joiner() {
+            if (th.joinable()) {
+                th.join();
+            }
+        }
+    } loader;
 };
 
+// publish a terminal (or intermediate) tier state. The store happens UNDER the mutex so a
+// waiter that already holds it cannot miss the notify and sleep forever; release ordering
+// publishes everything the loader wrote into the tier before this point.
+static void tier_publish(duo_state & s, duo_tier & t, tier_state st) {
+    {
+        std::lock_guard<std::mutex> lk(s.tier_mu);
+        t.state.store(st, std::memory_order_release);
+    }
+    s.tier_cv.notify_all();
+}
+
+// block until `t` is loaded, then hand it back; nullptr means "this tier will never be
+// ready" (absent from the registry, or its background load failed). Prints ONE trace line
+// when it actually has to wait -- the cv does the sleeping, nothing spins.
+static duo_tier * tier_acquire(duo_state & s, duo_tier * t, const char * why) {
+    if (!t) {
+        return nullptr;
+    }
+    tier_state st = t->state.load(std::memory_order_acquire);
+    if (st == TS_READY) {
+        return t;
+    }
+    if (st != TS_FAILED) {
+        const int64_t t0 = ggml_time_us();
+        if (g_trace) {
+            fprintf(stderr, "[tier] waiting for %s (loading)%s%s\n",
+                    tier_role_name(t->role), why ? " reason=" : "", why ? why : "");
+        }
+        {
+            std::unique_lock<std::mutex> lk(s.tier_mu);
+            s.tier_cv.wait(lk, [&] {
+                const tier_state cur = t->state.load(std::memory_order_acquire);
+                return cur == TS_READY || cur == TS_FAILED;
+            });
+        }
+        st = t->state.load(std::memory_order_acquire);
+        if (g_trace && st == TS_READY) {
+            fprintf(stderr, "[tier] %s acquired wait_ms=%.1f\n",
+                    tier_role_name(t->role), (ggml_time_us() - t0) / 1e3);
+        }
+    }
+    if (st != TS_READY) {
+        fprintf(stderr, "error: tier '%s' failed to load; cannot continue this turn\n",
+                tier_role_name(t->role));
+        return nullptr;
+    }
+    return t;
+}
