+// ---------- background tier loader ----------
+
+// TEST-ONLY hook: MUTA_SLOW_LOAD_MS=<n> sleeps n ms before each BACKGROUND tier load so
+// the not-ready fallbacks (front answers while easy loads; opener extends while mid loads)
+// can be exercised on a machine where a load wins the race by default. Deliberately not a
+// --flag and not in --help: it exists to make gate evidence reproducible, nothing else.
+static void tier_slow_load_hook() {
+    const char * env = getenv("MUTA_SLOW_LOAD_MS");
+    if (!env) {
+        return;
+    }
+    const int ms = atoi(env);
+    if (ms > 0) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(ms));
+    }
+}
+
+// one background load, start to publish. Runs ONLY on the loader thread.
+static void tier_load_bg(duo_state & s, duo_tier * t, const char * name, bool checkpoint_seq) {
+    if (!t) {
+        return;
+    }
+    if (s.loader_stop.load(std::memory_order_acquire)) {
+        // teardown started before this tier's load did. Publish a terminal state anyway:
+        // leaving it TS_UNLOADED would strand any future waiter.
+        tier_publish(s, *t, TS_FAILED);
+        return;
+    }
+    tier_publish(s, *t, TS_LOADING);
+    tier_slow_load_hook();
+    if (s.loader_stop.load(std::memory_order_acquire)) {
+        // re-check after the (test-only) delay: teardown may have arrived while sleeping.
+        // Once llama_model_load_from_file is entered there is no safe way to abort it, so
+        // this is the last point where a not-yet-started load can be skipped.
+        tier_publish(s, *t, TS_FAILED);
+        return;
+    }
+
+    const int64_t t0 = ggml_time_us();
+    if (!s.p.quiet) {
+        fprintf(stderr, "loading %-6s ('%s') from %s\n", name, t->prefix.c_str(), t->file.c_str());
+    }
+    const bool ok = load_duo_model(t->m, s.p, name, t->file, t->prefix,
+                                   tier_ctx_resolved(*t, s.p), t->temp, t->top_p,
+                                   checkpoint_seq, t->policy);
+    const double load_ms = (ggml_time_us() - t0) / 1e3;
+    if (!ok) {
+        s.loader_failed.store(true, std::memory_order_release);
+    }
+    // publish LAST: everything above is ordered before the release store, so a consumer
+    // that acquires TS_READY sees a fully constructed model/ctx/sampler/templates
+    tier_publish(s, *t, ok ? TS_READY : TS_FAILED);
+    if (g_trace) {
+        fprintf(stderr, "[tier] %s %s load_ms=%.1f\n", tier_role_name(t->role),
+                ok ? "ready" : "FAILED", load_ms);
+    }
+    jtrace("{\"type\":\"tier\",\"name\":\"%s\",\"state\":\"%s\",\"load_ms\":%.1f}",
+           tier_role_name(t->role), ok ? "ready" : "failed", load_ms);
+}
+
+// the whole background thread: easy then mid, serialized, in registry order
+static void tier_loader_main(duo_state & s) {
+    // easy ALWAYS gets a checkpoint sequence: it is hybrid, hence append-only, and the
+    // checkpoint is what lets its answer be provisional enough to conf-escalate to mid
+    tier_load_bg(s, s.easy, "easy", /*checkpoint_seq*/ true);
+    // "expert" is mid's model name of record (trace/stream tags); the tier is "mid"
+    tier_load_bg(s, s.mid, "expert", s.mid_checkpoint);
+}
