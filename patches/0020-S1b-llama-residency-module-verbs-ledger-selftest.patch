+#pragma once
+
+#include "llama.h"
+
+#include <cstdint>
+
+// Internal entry points of the weight residency manager. The public C API is
+// in include/llama.h; what follows is llama.cpp internal and exists so the
+// module's own selftest -- and the graph gating that lands in S2/B3 -- can
+// drive the ring/window state machine directly.
+//
+// Unit ids are stable indices into the manager's unit table: one unit per
+// decoder block, one for the (tied) head, one for the always-pinned misc
+// tensors.
+
+// Number of units in the table.
+int llama_residency_n_units(const struct llama_residency * res);
+
+// Unit id of decoder block il, or of the head unit. -1 when absent.
+int llama_residency_unit_of_layer(const struct llama_residency * res, int il);
+int llama_residency_unit_head    (const struct llama_residency * res);
+
+// The ring/window state machine: unit `unit` has just been executed. Evicts
+// every resident streamed unit outside the window [unit, unit+W] and queues a
+// prefetch for the units inside it that are neither resident nor already
+// queued. Runs on the caller's thread (the compute thread in S2/B3): it only
+// takes the manager's lock and appends to its queue, it never issues a syscall.
+void llama_residency_on_gate_post(struct llama_residency * res, int unit);
+
+// Block until the manager thread has executed every queued verb. Test and
+// tier-switch scaffolding only; never call this from a compute thread.
+void llama_residency_drain(struct llama_residency * res);
