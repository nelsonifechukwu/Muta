diff --git a/src/llama-residency.cpp b/src/llama-residency.cpp
new file mode 100644
index 0000000..9c30ef7
--- /dev/null
+++ b/src/llama-residency.cpp
@@ -0,0 +1,1455 @@
+#include "llama-residency.h"
+
+#include "llama-impl.h"
+#include "llama-mmap.h"
+#include "llama-model.h"
+
+#include "ggml.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstring>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#ifdef __has_include
+    #if __has_include(<unistd.h>)
+        #include <unistd.h>
+        #include <fcntl.h>
+        #if defined(_POSIX_MAPPED_FILES)
+            #include <sys/mman.h>
+        #endif
+    #endif
+#endif
+
+#if defined(_POSIX_MAPPED_FILES)
+
+// ---------------------------------------------------------------------------
+// ground truth this module is built on (docs/DISCOVERY.md S0.3, task A3):
+//
+//   EVICT    raw madvise(addr, len, MADV_DONTNEED) -- NOT posix_madvise, whose
+//            POSIX_MADV_DONTNEED is advisory by definition and measured as a
+//            no-op -- followed by posix_fadvise(fd, off, len, POSIX_FADV_DONTNEED),
+//            strictly in that order: fadvise on pages that still carry a live
+//            PTE is a silent no-op. Both halves live in llama_mmap
+//            (discard_range / fadvise_discard), Linux-gated; on Darwin
+//            MADV_DONTNEED is advisory and there is no posix_fadvise at all, so
+//            eviction there is a documented no-op.
+//   PREFETCH an explicit touch loop (one volatile byte per page) at ~2.4 GB/s.
+//            MADV_WILLNEED is capped per call: 0.5% of a 256 MiB region in 10 s
+//            for one big call, ~16 MiB/s when chunked. So the touch loop is the
+//            mechanism and the completion signal; chunked WILLNEED is issued
+//            ahead of it as a hint only. A3 measured the touch loop on a
+//            mapping with default advice; the streaming load sets
+//            POSIX_MADV_RANDOM over the whole mapping (S1a), which costs the
+//            touch loop 14.6x (341.6 vs 4991.5 MiB/s, gate container, S1b) --
+//            see res_prefetch_hint() for how that is bought back per range.
+//   PAGE     runtime sysconf(_SC_PAGESIZE) always (4 KiB in the gate container,
+//            16 KiB on the Apple Silicon host).
+//
+// Alignment: eviction aligns INWARD (never touch a page shared with a unit that
+// is still wanted), prefetch aligns OUTWARD (a partial page still has to be
+// faulted in for the tensor bytes inside it to be usable).
+// ---------------------------------------------------------------------------
+
+enum res_unit_kind {
+    RES_UNIT_MISC  = 0, // output_norm / rope_freqs / any non-blk straggler: tiny, always pinned
+    RES_UNIT_LAYER = 1, // blk.N.*
+    RES_UNIT_HEAD  = 2, // token_embd.weight (tied head) or output.weight
+};
+
+enum res_state {
+    RES_EVICTED  = 0,
+    RES_QUEUED   = 1,
+    RES_RESIDENT = 2,
+};
+
+enum res_op_kind {
+    RES_OP_PIN      = 0,
+    RES_OP_PREFETCH = 1,
+    RES_OP_EVICT    = 2,
+};
+
+struct res_range {
+    size_t first; // offset into the mapping, inclusive
+    size_t last;  // offset into the mapping, exclusive
+};
+
+struct res_unit {
+    res_unit_kind kind = RES_UNIT_MISC;
+
+    int         layer = -1; // blk index for RES_UNIT_LAYER, -1 otherwise
+    std::string name;
+
+    std::vector<res_range> ranges; // sorted, merged, disjoint
+
+    size_t bytes    = 0; // sum of ggml_nbytes over the unit's tensors
+    size_t n_tensor = 0;
+    size_t off_min  = 0;
+    size_t off_max  = 0;
+
+    bool pinned  = false;
+    bool mlocked = false;
+};
+
+struct res_op {
+    res_op_kind kind;
+    int         unit;
+};
+
+struct llama_residency {
+    llama_residency_params params = {};
+
+    const llama_model * model    = nullptr;
+    llama_mmap        * mapping  = nullptr;
+    uint8_t           * base     = nullptr;
+    size_t              map_size = 0;
+    size_t              page     = 4096;
+
+    std::string path;
+    int         fd = -1;
+
+    std::vector<res_unit>                  units;
+    std::unique_ptr<std::atomic<uint8_t>[]> states;
+
+    std::vector<int> ring;       // streamed unit ids, execution order (head last)
+    std::vector<int> ring_pos;   // unit id -> ring index, -1 when not streamed
+    std::vector<int> cursor_pos; // unit id -> ring index the window starts at
+
+    int head_unit = -1;
+    int misc_unit = -1;
+
+    llama_residency_info info = {};
+
+    // the manager thread and its FIFO. every verb runs here and only here.
+    std::thread             thr;
+    std::mutex              mtx;
+    std::condition_variable cv_work;
+    std::condition_variable cv_idle;
+    std::deque<res_op>      q;
+    bool                    stop      = false;
+    bool                    busy      = false;
+    bool                    suspended = false;
+};
+
+// keeps the touch loop from being optimized away
+static volatile uint8_t g_res_sink = 0;
+
+static double res_mib(uint64_t bytes) {
+    return (double) bytes / (1024.0 * 1024.0);
+}
+
+static double res_mib_signed(int64_t bytes) {
+    return (double) bytes / (1024.0 * 1024.0);
+}
+
+static size_t res_align_down(size_t off, size_t page) {
+    return off & ~(page - 1);
+}
+
+static size_t res_align_up(size_t off, size_t page) {
+    return (off + page - 1) & ~(page - 1);
+}
+
+// execution order key: misc first (it is never in the ring), then blk.0..blk.L-1,
+// then the head, which is used last (the logits matmul).
+static int res_exec_order(const res_unit & u) {
+    switch (u.kind) {
+        case RES_UNIT_MISC:  return -1;
+        case RES_UNIT_LAYER: return u.layer;
+        case RES_UNIT_HEAD:  return 1 << 24;
+    }
+    return -1;
+}
+
+// ---------------------------------------------------------------------------
+// unit table
+// ---------------------------------------------------------------------------
+
+static bool res_build_units(llama_residency * r, const llama_model * model) {
+    const llama_mmaps & maps = model->mappings();
+
+    if (maps.size() != 1) {
+        LLAMA_LOG_ERROR("residency: expected exactly 1 mapping, got %zu (mmap, single-file models only)\n",
+                maps.size());
+        return false;
+    }
+
+    r->mapping  = maps[0].get();
+    r->base     = (uint8_t *) r->mapping->addr();
+    r->map_size = r->mapping->size();
+
+    if (r->base == nullptr || r->map_size == 0) {
+        LLAMA_LOG_ERROR("%s", "residency: the model mapping is empty\n");
+        return false;
+    }
+
+    std::vector<res_unit>               units;
+    std::vector<std::vector<res_range>> raw;
+
+    int              misc_idx = -1;
+    int              head_idx = -1;
+    std::vector<int> layer_idx; // blk index -> slot in `units`
+
+    bool has_output_weight = false;
+
+    for (const auto & it : model->tensors_by_name) {
+        const std::string        & name = it.first;
+        const struct ggml_tensor * t    = it.second;
+
+        if (t == nullptr || t->data == nullptr) {
+            continue;
+        }
+
+        const uint8_t * data = (const uint8_t *) t->data;
+        if (data < r->base || data >= r->base + r->map_size) {
+            LLAMA_LOG_ERROR("residency: tensor '%s' is not backed by the model mapping "
+                    "(the manager only handles fully mmap'ed models)\n", name.c_str());
+            return false;
+        }
+
+        const size_t off = (size_t) (data - r->base);
+        const size_t len = ggml_nbytes(t);
+
+        if (off + len > r->map_size) {
+            LLAMA_LOG_ERROR("residency: tensor '%s' runs past the mapping (%zu + %zu > %zu)\n",
+                    name.c_str(), off, len, r->map_size);
+            return false;
+        }
+
+        if (name == "output.weight") {
+            has_output_weight = true;
+        }
+
+        int slot = -1;
+        int il   = -1;
+
+        if (sscanf(name.c_str(), "blk.%d.", &il) == 1 && il >= 0) {
+            if ((int) layer_idx.size() <= il) {
+                layer_idx.resize(il + 1, -1);
+            }
+            if (layer_idx[il] < 0) {
+                layer_idx[il] = (int) units.size();
+                units.push_back({});
+                raw.push_back({});
+                units.back().kind  = RES_UNIT_LAYER;
+                units.back().layer = il;
+                units.back().name  = "blk." + std::to_string(il);
+            }
+            slot = layer_idx[il];
+        } else if (name == "token_embd.weight" || name == "output.weight") {
+            if (head_idx < 0) {
+                head_idx = (int) units.size();
+                units.push_back({});
+                raw.push_back({});
+                units.back().kind = RES_UNIT_HEAD;
+                units.back().name = "head";
+            }
+            slot = head_idx;
+        } else {
+            if (misc_idx < 0) {
+                misc_idx = (int) units.size();
+                units.push_back({});
+                raw.push_back({});
+                units.back().kind = RES_UNIT_MISC;
+                units.back().name = "misc";
+            }
+            slot = misc_idx;
+        }
+
+        raw[slot].push_back({ off, off + len });
+        units[slot].bytes    += len;
+        units[slot].n_tensor += 1;
+    }
+
+    if (units.empty()) {
+        LLAMA_LOG_ERROR("%s", "residency: no mapped tensors found\n");
+        return false;
+    }
+
+    // sort + merge each unit's intervals
+    for (size_t u = 0; u < units.size(); u++) {
+        auto & rs = raw[u];
+        std::sort(rs.begin(), rs.end(), [](const res_range & a, const res_range & b) {
+            return a.first < b.first;
+        });
+
+        std::vector<res_range> merged;
+        for (const auto & rg : rs) {
+            if (!merged.empty() && rg.first <= merged.back().last) {
+                merged.back().last = std::max(merged.back().last, rg.last);
+            } else {
+                merged.push_back(rg);
+            }
+        }
+
+        units[u].ranges  = merged;
+        units[u].off_min = merged.front().first;
+        units[u].off_max = merged.back().last;
+
+        size_t merged_bytes = 0;
+        for (const auto & rg : merged) {
+            merged_bytes += rg.last - rg.first;
+        }
+
+        if (merged_bytes != units[u].bytes) {
+            LLAMA_LOG_ERROR("residency: unit %s has overlapping tensors (merged %zu vs sum %zu)\n",
+                    units[u].name.c_str(), merged_bytes, units[u].bytes);
+            return false;
+        }
+
+        // the mapping is whole-file-at-0, so mapping offset == file offset. every
+        // tensor sits behind the gguf header, so a unit starting at 0 would mean
+        // that assumption broke.
+        if (units[u].off_min == 0) {
+            LLAMA_LOG_ERROR("residency: unit %s starts at mapping offset 0 -- the mapping is not "
+                    "whole-file-at-0\n", units[u].name.c_str());
+            return false;
+        }
+
+        const size_t extent = units[u].off_max - units[u].off_min;
+        if ((double) extent > 1.05 * (double) units[u].bytes) {
+            LLAMA_LOG_WARN("residency: unit %s is fragmented: extent %.1f MiB vs %.1f MiB of tensors "
+                    "in %zu ranges\n", units[u].name.c_str(), res_mib(extent), res_mib(units[u].bytes),
+                    merged.size());
+        }
+    }
+
+    // a hole in the blk.N numbering would break the greedy pin order
+    for (size_t il = 0; il < layer_idx.size(); il++) {
+        if (layer_idx[il] < 0) {
+            LLAMA_LOG_ERROR("residency: decoder block %zu is missing from the tensor table\n", il);
+            return false;
+        }
+    }
+
+    // final unit id space: blk.0..blk.L-1, then head, then misc
+    std::vector<res_unit> ordered;
+    ordered.reserve(units.size());
+
+    for (size_t il = 0; il < layer_idx.size(); il++) {
+        ordered.push_back(units[layer_idx[il]]);
+    }
+    if (head_idx >= 0) {
+        r->head_unit = (int) ordered.size();
+        ordered.push_back(units[head_idx]);
+    }
+    if (misc_idx >= 0) {
+        r->misc_unit = (int) ordered.size();
+        ordered.push_back(units[misc_idx]);
+    }
+
+    r->units = std::move(ordered);
+
+    r->info.head_tied  = !has_output_weight;
+    r->info.head_bytes = r->head_unit >= 0 ? r->units[r->head_unit].bytes : 0;
+
+    return true;
+}
+
+// ---------------------------------------------------------------------------
+// ledger
+// ---------------------------------------------------------------------------
+
+struct res_plan {
+    bool     feasible    = false;
+    bool     head_pinned = false;
+    uint32_t window      = 0;
+
+    int64_t b_layer_max    = 0;
+    int64_t window_term    = 0;
+    int64_t r_pin          = 0;
+    int64_t need           = 0; // bytes that must fit in r_pin before any layer is pinned
+    int     n_pinned_layer = 0;
+    int64_t pinned_bytes   = 0;
+    int64_t streamed_bytes = 0;
+};
+
+// One config of the two-step head-aware solve; `head_pinned` picks which.
+//
+//   head-pinned   R_pin = max_ram - mlock_front - resident_other
+//                         - ((W+1)*b_layer_max + b_layer_max) - reserve,
+//                 feasible iff R_pin >= head + misc; pin HEAD then blk.0,1,...
+//   head-streamed the window term becomes (W+1)*b_layer_max + head_bytes,
+//                 feasible iff R_pin >= misc; HEAD streams as the ring's last unit
+//
+// b_layer_max is the max over the STREAMED layers, which depends on how many
+// layers get pinned, which depends on b_layer_max: solved by iterating to a
+// fixed point. Each pass can only shrink b_layer_max (pinning more layers only
+// removes layers from the streamed set), so it terminates.
+static res_plan res_solve_one(const std::vector<int64_t> & layer_bytes,
+                              int64_t head_bytes, int64_t misc_bytes,
+                              const llama_residency_params & p,
+                              uint32_t W, bool head_pinned) {
+    res_plan pl;
+    pl.head_pinned = head_pinned;
+    pl.window      = W;
+
+    const int64_t mib = 1024 * 1024;
+
+    const int64_t budget =
+        (int64_t) p.max_ram_mib        * mib -
+        (int64_t) p.mlock_front_mib    * mib -
+        (int64_t) p.resident_other_mib * mib -
+        (int64_t) p.reserve_mib        * mib;
+
+    const int64_t n_layers = (int64_t) layer_bytes.size();
+
+    int64_t b = 0;
+    for (int64_t v : layer_bytes) {
+        b = std::max(b, v);
+    }
+
+    pl.need = misc_bytes + (head_pinned ? head_bytes : 0);
+
+    for (int pass = 0; pass < 16; pass++) {
+        pl.window_term = head_pinned
+            ? (int64_t) (W + 1) * b + b
+            : (int64_t) (W + 1) * b + head_bytes;
+
+        pl.b_layer_max = b;
+        pl.r_pin       = budget - pl.window_term;
+
+        if (p.pin_budget_mib >= 0) {
+            pl.r_pin = std::min<int64_t>(pl.r_pin, (int64_t) p.pin_budget_mib * mib);
+        }
+
+        if (pl.r_pin < pl.need) {
+            pl.feasible = false;
+            return pl;
+        }
+
+        const int64_t avail = pl.r_pin - pl.need;
+
+        int64_t sum    = 0;
+        int64_t pinned = 0;
+        while (pinned < n_layers && sum + layer_bytes[pinned] <= avail) {
+            sum += layer_bytes[pinned];
+            pinned++;
+        }
+
+        int64_t b_new = 0;
+        for (int64_t i = pinned; i < n_layers; i++) {
+            b_new = std::max(b_new, layer_bytes[i]);
+        }
+
+        pl.feasible       = true;
+        pl.n_pinned_layer = (int) pinned;
+        pl.pinned_bytes   = sum + pl.need;
+        pl.streamed_bytes = (head_pinned ? 0 : head_bytes);
+        for (int64_t i = pinned; i < n_layers; i++) {
+            pl.streamed_bytes += layer_bytes[i];
+        }
+
+        // b_new == 0 means every layer got pinned: the window term is moot, keep
+        // the b that produced this result rather than collapsing it to zero.
+        if (b_new == 0 || b_new == b) {
+            return pl;
+        }
+
+        b = b_new;
+    }
+
+    return pl;
+}
+
+static void res_log_infeasible(const res_plan & pl, const llama_residency_params & p, const char * what) {
+    const int64_t mib = 1024 * 1024;
+    const int64_t need_ram = pl.need + pl.window_term +
+        (int64_t) p.reserve_mib        * mib +
+        (int64_t) p.mlock_front_mib    * mib +
+        (int64_t) p.resident_other_mib * mib;
+
+    LLAMA_LOG_ERROR("residency:   %-14s R_pin = max_ram %.1f - mlock_front %.1f - resident_other %.1f"
+            " - window %.1f - reserve %.1f = %.1f MiB  <  required %.1f MiB\n",
+            what,
+            (double) p.max_ram_mib, (double) p.mlock_front_mib, (double) p.resident_other_mib,
+            res_mib_signed(pl.window_term), (double) p.reserve_mib,
+            res_mib_signed(pl.r_pin), res_mib_signed(pl.need));
+    LLAMA_LOG_ERROR("residency:   %-14s at W = %u this needs --max-ram-mib >= %.1f\n",
+            what, pl.window, res_mib_signed(std::max<int64_t>(need_ram, 0)));
+}
+
+static bool res_solve(llama_residency * r) {
+    std::vector<int64_t> layer_bytes;
+    for (const auto & u : r->units) {
+        if (u.kind == RES_UNIT_LAYER) {
+            layer_bytes.push_back((int64_t) u.bytes);
+        }
+    }
+
+    if (layer_bytes.empty()) {
+        LLAMA_LOG_ERROR("%s", "residency: the model has no decoder blocks to stream\n");
+        return false;
+    }
+
+    const int64_t head_bytes = r->head_unit >= 0 ? (int64_t) r->units[r->head_unit].bytes : 0;
+    const int64_t misc_bytes = r->misc_unit >= 0 ? (int64_t) r->units[r->misc_unit].bytes : 0;
+
+    const uint32_t W0 = std::max<uint32_t>(1, r->params.prefetch_layers);
+
+    res_plan chosen;
+    res_plan last_a;
+    res_plan last_b;
+
+    for (uint32_t W = W0; W >= 1; W--) {
+        const res_plan a = res_solve_one(layer_bytes, head_bytes, misc_bytes, r->params, W, true);
+        const res_plan b = res_solve_one(layer_bytes, head_bytes, misc_bytes, r->params, W, false);
+
+        last_a = a;
+        last_b = b;
+
+        // fewer streamed bytes is fewer seconds per token at every D > 0, so this
+        // is "min predicted s/token" whether or not D was measured.
+        if (a.feasible && b.feasible) {
+            chosen = a.streamed_bytes <= b.streamed_bytes ? a : b;
+        } else if (a.feasible) {
+            chosen = a;
+        } else if (b.feasible) {
+            chosen = b;
+        }
+
+        if (chosen.feasible) {
+            if (W != W0) {
+                LLAMA_LOG_WARN("residency: no plan fits at W = %u, reduced to W = %u\n", W0, W);
+            }
+            break;
+        }
+    }
+
+    if (!chosen.feasible) {
+        LLAMA_LOG_ERROR("%s", "residency: REFUSED -- no feasible plan, not even at W = 1\n");
+        res_log_infeasible(last_a, r->params, "head-pinned:");
+        res_log_infeasible(last_b, r->params, "head-streamed:");
+        return false;
+    }
+
+    // apply the plan to the unit table
+    int layer_seen = 0;
+    for (auto & u : r->units) {
+        switch (u.kind) {
+            case RES_UNIT_MISC:
+                u.pinned = true;
+                break;
+            case RES_UNIT_HEAD:
+                u.pinned = chosen.head_pinned;
+                break;
+            case RES_UNIT_LAYER:
+                u.pinned = layer_seen < chosen.n_pinned_layer;
+                layer_seen++;
+                break;
+        }
+    }
+
+    // the ring: streamed units in execution order, head last when it streams
+    r->ring.clear();
+    r->ring_pos.assign(r->units.size(), -1);
+    for (size_t u = 0; u < r->units.size(); u++) {
+        if (r->units[u].kind == RES_UNIT_LAYER && !r->units[u].pinned) {
+            r->ring_pos[u] = (int) r->ring.size();
+            r->ring.push_back((int) u);
+        }
+    }
+    if (r->head_unit >= 0 && !r->units[r->head_unit].pinned) {
+        r->ring_pos[r->head_unit] = (int) r->ring.size();
+        r->ring.push_back(r->head_unit);
+    }
+
+    // where the window starts when the posting unit is not itself in the ring
+    // (a pinned layer, or misc): at the first streamed unit after it.
+    r->cursor_pos.assign(r->units.size(), 0);
+    for (size_t u = 0; u < r->units.size(); u++) {
+        if (r->ring_pos[u] >= 0) {
+            r->cursor_pos[u] = r->ring_pos[u];
+            continue;
+        }
+        int pos = 0; // nothing after it: wrap to the head of the ring
+        for (size_t k = 0; k < r->ring.size(); k++) {
+            if (res_exec_order(r->units[r->ring[k]]) > res_exec_order(r->units[u])) {
+                pos = (int) k;
+                break;
+            }
+        }
+        r->cursor_pos[u] = pos;
+    }
+
+    r->info.window            = chosen.window;
+    r->info.head_pinned       = chosen.head_pinned;
+    r->info.b_layer_max       = (uint64_t) chosen.b_layer_max;
+    r->info.pinned_bytes      = (uint64_t) chosen.pinned_bytes;
+    r->info.streamed_bytes    = (uint64_t) chosen.streamed_bytes;
+    r->info.n_pinned_layers   = (uint32_t) chosen.n_pinned_layer;
+    r->info.n_streamed_layers = (uint32_t) ((int) layer_bytes.size() - chosen.n_pinned_layer);
+
+    // ---- startup log ----
+    int64_t b_min = layer_bytes[0];
+    int64_t b_max = layer_bytes[0];
+    int64_t b_sum = 0;
+    for (int64_t v : layer_bytes) {
+        b_min = std::min(b_min, v);
+        b_max = std::max(b_max, v);
+        b_sum += v;
+    }
+
+    LLAMA_LOG_INFO("residency: model = %s\n", r->path.c_str());
+    LLAMA_LOG_INFO("residency: mapping %.1f MiB, page %zu B, %zu units = %zu blk + head (%s) + misc (%.3f MiB)\n",
+            res_mib(r->map_size), r->page, r->units.size(), layer_bytes.size(),
+            r->head_unit < 0 ? "none" : (r->info.head_tied ? "tied" : "untied"),
+            res_mib((uint64_t) misc_bytes));
+    LLAMA_LOG_INFO("residency: b_layer min/avg/max = %.1f / %.1f / %.1f MiB, head = %.1f MiB\n",
+            res_mib((uint64_t) b_min), res_mib((uint64_t) (b_sum / (int64_t) layer_bytes.size())),
+            res_mib((uint64_t) b_max), res_mib((uint64_t) head_bytes));
+    LLAMA_LOG_INFO("residency: ledger: max_ram %.1f - mlock_front %.1f - resident_other %.1f"
+            " - window %.1f - reserve %.1f = R_pin %.1f MiB\n",
+            (double) r->params.max_ram_mib, (double) r->params.mlock_front_mib,
+            (double) r->params.resident_other_mib, res_mib_signed(chosen.window_term),
+            (double) r->params.reserve_mib, res_mib_signed(chosen.r_pin));
+    LLAMA_LOG_INFO("residency: config = %s\n", chosen.head_pinned ? "head-pinned" : "head-streamed");
+    LLAMA_LOG_INFO("residency: pinned   = %.1f MiB in %u units (%u blk%s + misc)\n",
+            res_mib(r->info.pinned_bytes),
+            (uint32_t) (r->info.n_pinned_layers + (chosen.head_pinned ? 1u : 0u) + (r->misc_unit >= 0 ? 1u : 0u)),
+            r->info.n_pinned_layers, chosen.head_pinned ? " + head" : "");
+    LLAMA_LOG_INFO("residency: streamed = %.1f MiB in %zu ring units (%u blk%s), W = %u, "
+            "window %.1f MiB, b_layer_max %.1f MiB\n",
+            res_mib(r->info.streamed_bytes), r->ring.size(), r->info.n_streamed_layers,
+            chosen.head_pinned ? "" : " + head", r->info.window,
+            res_mib_signed(chosen.window_term), res_mib(r->info.b_layer_max));
+
+    if (r->params.disk_gbps > 0.0f) {
+        LLAMA_LOG_INFO("residency: predicted s/token = %.3f (streamed %.1f MiB / %.3f GB/s)\n",
+                (double) r->info.streamed_bytes / ((double) r->params.disk_gbps * 1e9),
+                res_mib(r->info.streamed_bytes), (double) r->params.disk_gbps);
+    }
+
+    if (!chosen.head_pinned && head_bytes > 0) {
+        if (r->params.disk_gbps > 0.0f) {
+            LLAMA_LOG_WARN("residency: HEAD IS STREAMED: +%.3f s/token for the head alone "
+                    "(%.1f MiB / %.3f GB/s)\n",
+                    (double) head_bytes / ((double) r->params.disk_gbps * 1e9),
+                    res_mib((uint64_t) head_bytes), (double) r->params.disk_gbps);
+        } else {
+            LLAMA_LOG_WARN("residency: HEAD IS STREAMED: %.1f MiB re-read every token\n",
+                    res_mib((uint64_t) head_bytes));
+        }
+    }
+
+    return true;
+}
+
+// ---------------------------------------------------------------------------
+// verbs -- these run on the manager thread and nowhere else
+// ---------------------------------------------------------------------------
+
+// Hints issued just ahead of the touch loop; neither one moves a page on its own.
+//
+//  - POSIX_MADV_NORMAL undoes, for this unit's ranges only, the whole-mapping
+//    POSIX_MADV_RANDOM the streaming load sets (S1a). RANDOM is right for the
+//    mapping as a whole -- nothing may read ahead into a range the manager did
+//    not ask for -- but it also suppresses readahead and fault-around *inside*
+//    the range being prefetched, which turns a whole-unit sweep into one
+//    synchronous single-page fault per page. Measured on the gate VM: 341.6
+//    MiB/s with RANDOM left in place. The overshoot this re-admits is one
+//    readahead window past each range end, which the ring's slack absorbs.
+//  - MADV_WILLNEED is capped per call (A3 steps 4 and 4b: ~16 MiB/s chunked),
+//    so it is a queue-it-early hint, never the mechanism.
+static void res_prefetch_hint(llama_residency * r, const res_unit & u) {
+    const size_t chunk = 2u * 1024 * 1024;
+    const size_t end   = res_align_up(r->map_size, r->page);
+
+    for (const auto & rg : u.ranges) {
+        const size_t first = res_align_down(rg.first, r->page);
+        const size_t last  = std::min(res_align_up(rg.last, r->page), end);
+        if (last <= first) {
+            continue;
+        }
+
+        (void) posix_madvise(r->base + first, last - first, POSIX_MADV_NORMAL);
+
+#ifdef MADV_WILLNEED
+        for (size_t off = first; off < last; off += chunk) {
+            (void) madvise(r->base + off, std::min(chunk, last - off), MADV_WILLNEED);
+        }
+#endif
+    }
+}
+
+// THE prefetch mechanism: one volatile byte per page, outward aligned.
+static void res_touch(llama_residency * r, const res_unit & u) {
+    const volatile uint8_t * p = (const volatile uint8_t *) r->base;
+
+    uint8_t sink = 0;
+
+    for (const auto & rg : u.ranges) {
+        if (rg.last <= rg.first) {
+            continue;
+        }
+        // aligning the start down can never land inside the header range the
+        // loader munmap'ed: that munmap is aligned inward with the same page
+        // size, so it ends exactly at align_down(first tensor offset).
+        for (size_t off = res_align_down(rg.first, r->page); off < rg.last; off += r->page) {
+            sink = (uint8_t) (sink ^ p[off]);
+        }
+        sink = (uint8_t) (sink ^ p[rg.last - 1]); // the trailing partial page
+    }
+
+    g_res_sink = (uint8_t) (g_res_sink ^ sink);
+}
+
+static void res_unlock(llama_residency * r, res_unit & u) {
+    if (!u.mlocked) {
+        return;
+    }
+    for (const auto & rg : u.ranges) {
+        const size_t first = res_align_up  (rg.first, r->page);
+        const size_t last  = res_align_down(rg.last,  r->page);
+        if (last > first) {
+            (void) munlock(r->base + first, last - first);
+        }
+    }
+    u.mlocked = false;
+}
+
+static void res_do_evict(llama_residency * r, res_unit & u) {
+    res_unlock(r, u);
+
+    // inward aligned inside llama_mmap, and strictly in this order: the fadvise
+    // is a silent no-op while the range still has live PTEs (S0.3 step 3b).
+    for (const auto & rg : u.ranges) {
+        r->mapping->discard_range(rg.first, rg.last);
+        r->mapping->fadvise_discard(r->fd, rg.first, rg.last);
+    }
+}
+
+static void res_do_mlock(llama_residency * r, res_unit & u) {
+    if (u.mlocked) {
+        return;
+    }
+    for (const auto & rg : u.ranges) {
+        const size_t first = res_align_up  (rg.first, r->page);
+        const size_t last  = res_align_down(rg.last,  r->page);
+        if (last <= first) {
+            continue;
+        }
+        if (mlock(r->base + first, last - first) != 0) {
+            LLAMA_LOG_WARN("residency: mlock(%s) failed: %s -- degrading to an unlocked pin "
+                    "(still never evicted, but reclaimable under pressure)\n",
+                    u.name.c_str(), strerror(errno));
+            res_unlock(r, u);
+            return;
+        }
+        u.mlocked = true; // so a failure halfway through still unlocks what took
+    }
+}
+
+static void res_exec(llama_residency * r, const res_op & op) {
+    res_unit & u = r->units[op.unit];
+
+    switch (op.kind) {
+        case RES_OP_PIN:
+            {
+                res_prefetch_hint(r, u);
+                res_touch(r, u);
+                if (r->params.mlock_pins) {
+                    res_do_mlock(r, u);
+                }
+                r->states[op.unit].store(RES_RESIDENT);
+                if (r->params.verbose) {
+                    LLAMA_LOG_INFO("residency: pin      %-8s %.1f MiB\n", u.name.c_str(), res_mib(u.bytes));
+                }
+            } break;
+
+        case RES_OP_PREFETCH:
+            {
+                res_prefetch_hint(r, u);
+                res_touch(r, u);
+                // an evict queued behind this prefetch already moved the unit to
+                // EVICTED; it runs next, so let it win.
+                uint8_t expected = RES_QUEUED;
+                r->states[op.unit].compare_exchange_strong(expected, (uint8_t) RES_RESIDENT);
+                if (r->params.verbose) {
+                    LLAMA_LOG_INFO("residency: prefetch %-8s %.1f MiB\n", u.name.c_str(), res_mib(u.bytes));
+                }
+            } break;
+
+        case RES_OP_EVICT:
+            {
+                res_do_evict(r, u);
+                if (r->params.verbose) {
+                    LLAMA_LOG_INFO("residency: evict    %-8s %.1f MiB\n", u.name.c_str(), res_mib(u.bytes));
+                }
+            } break;
+    }
+}
+
+static void res_worker(llama_residency * r) {
+    std::unique_lock<std::mutex> lk(r->mtx);
+
+    while (true) {
+        if (r->q.empty()) {
+            r->busy = false;
+            r->cv_idle.notify_all();
+        }
+
+        r->cv_work.wait(lk, [r] { return r->stop || !r->q.empty(); });
+
+        if (r->stop) {
+            break;
+        }
+
+        const res_op op = r->q.front();
+        r->q.pop_front();
+        r->busy = true;
+
+        lk.unlock();
+        res_exec(r, op);
+        lk.lock();
+    }
+
+    r->busy = false;
+    r->cv_idle.notify_all();
+}
+
+// caller must hold r->mtx
+static void res_enqueue(llama_residency * r, res_op_kind kind, int unit) {
+    switch (kind) {
+        case RES_OP_PIN:
+        case RES_OP_PREFETCH:
+            r->states[unit].store(RES_QUEUED);
+            break;
+        case RES_OP_EVICT:
+            // optimistic: the unit stops counting as resident the moment the
+            // evict is queued. the FIFO makes the syscalls follow in order.
+            r->states[unit].store(RES_EVICTED);
+            break;
+    }
+    r->q.push_back({ kind, unit });
+}
+
