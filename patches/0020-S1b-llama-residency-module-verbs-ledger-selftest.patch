+// public API
+// ---------------------------------------------------------------------------
+
+struct llama_residency_params llama_residency_default_params(void) {
+    struct llama_residency_params p = {
+        /*.max_ram_mib        =*/ 2048,
+        /*.prefetch_layers    =*/ 2,
+        /*.pin_budget_mib     =*/ -1,
+        /*.reserve_mib        =*/ 640,
+        /*.mlock_front_mib    =*/ 0,
+        /*.resident_other_mib =*/ 0,
+        /*.disk_gbps          =*/ 0.0f,
+        /*.mlock_pins         =*/ false,
+        /*.verbose            =*/ false,
+    };
+    return p;
+}
+
+struct llama_residency * llama_residency_init(
+        const struct llama_model    * model,
+                     const char     * path_model,
+        struct llama_residency_params params) {
+    if (model == nullptr || path_model == nullptr) {
+        LLAMA_LOG_ERROR("%s", "residency: model and path_model are required\n");
+        return nullptr;
+    }
+
+    llama_residency * r = new llama_residency();
+
+    r->params = params;
+    r->model  = model;
+    r->path   = path_model;
+    r->page   = (size_t) sysconf(_SC_PAGESIZE);
+
+    if (r->page == 0 || (r->page & (r->page - 1)) != 0) {
+        LLAMA_LOG_ERROR("residency: sysconf(_SC_PAGESIZE) returned %zu, expected a power of two\n", r->page);
+        delete r;
+        return nullptr;
+    }
+
+    if (!res_build_units(r, model) || !res_solve(r)) {
+        delete r;
+        return nullptr;
+    }
+
+    // the module's own descriptor: the page cache is per-inode so any fd works,
+    // and owning one keeps eviction independent of the loader's lifetime.
+    r->fd = open(path_model, O_RDONLY);
+    if (r->fd < 0) {
+        LLAMA_LOG_ERROR("residency: open(%s) failed: %s\n", path_model, strerror(errno));
+        delete r;
+        return nullptr;
+    }
+
+    r->states.reset(new std::atomic<uint8_t>[r->units.size()]);
+    for (size_t u = 0; u < r->units.size(); u++) {
+        r->states[u].store(RES_EVICTED);
+    }
+
+    r->thr = std::thread(res_worker, r);
+
+    // install the pins and the first window; the manager thread does the work,
+    // init does not block on it.
+    {
+        std::lock_guard<std::mutex> lk(r->mtx);
+        for (size_t u = 0; u < r->units.size(); u++) {
+            if (r->units[u].pinned) {
+                res_enqueue(r, RES_OP_PIN, (int) u);
+            }
+        }
+        const size_t n = std::min<size_t>(r->params.prefetch_layers, r->ring.size());
+        for (size_t k = 0; k < n; k++) {
+            res_enqueue(r, RES_OP_PREFETCH, r->ring[k]);
+        }
+    }
+    r->cv_work.notify_all();
+
+    return r;
+}
+
+void llama_residency_free(struct llama_residency * res) {
+    if (res == nullptr) {
+        return;
+    }
+
+    {
+        std::lock_guard<std::mutex> lk(res->mtx);
+        res->stop = true;
+        res->q.clear();
+    }
+    res->cv_work.notify_all();
+
+    if (res->thr.joinable()) {
+        res->thr.join();
+    }
+
+    for (auto & u : res->units) {
+        res_unlock(res, u);
+    }
+
+    if (res->fd >= 0) {
+        close(res->fd);
+        res->fd = -1;
+    }
+
+    delete res;
+}
+
+bool llama_residency_sched_eval_cb(struct ggml_tensor * t, bool ask, void * user_data) {
+    GGML_UNUSED(t);
+    GGML_UNUSED(user_data);
+
+    // S1b installs the seam only. ASK -> false (no node is observed yet),
+    // POST -> true (never abort the graph). Node -> unit resolution and the
+    // llama_residency_on_gate_post() call land in S2/B3.
+    return !ask;
+}
+
+void llama_residency_suspend(struct llama_residency * res) {
+    if (res == nullptr) {
+        return;
+    }
+
+    {
+        std::lock_guard<std::mutex> lk(res->mtx);
+        res->q.clear();
+        res->suspended = true;
+        for (size_t u = 0; u < res->units.size(); u++) {
+            if (res->units[u].kind == RES_UNIT_MISC) {
+                continue; // a few KiB, and the model is unusable without it
+            }
+            res_enqueue(res, RES_OP_EVICT, (int) u);
+        }
+    }
+    res->cv_work.notify_all();
+
+    llama_residency_drain(res);
+
+    LLAMA_LOG_INFO("residency: suspended, %.1f MiB evicted (pin flags kept for resume)\n",
+            res_mib(res->info.pinned_bytes + res->info.streamed_bytes));
+}
+
+void llama_residency_resume_async(struct llama_residency * res) {
+    if (res == nullptr) {
+        return;
+    }
+
+    {
+        std::lock_guard<std::mutex> lk(res->mtx);
+        res->suspended = false;
+        for (size_t u = 0; u < res->units.size(); u++) {
+            if (res->units[u].pinned) {
+                res_enqueue(res, RES_OP_PIN, (int) u);
+            }
+        }
+        const size_t n = std::min<size_t>(res->params.prefetch_layers, res->ring.size());
+        for (size_t k = 0; k < n; k++) {
+            if (res->states[res->ring[k]].load() == RES_EVICTED) {
+                res_enqueue(res, RES_OP_PREFETCH, res->ring[k]);
+            }
+        }
+    }
+    res->cv_work.notify_all();
+}
+
+struct llama_residency_info llama_residency_get_info(const struct llama_residency * res) {
+    if (res == nullptr) {
+        struct llama_residency_info empty = {};
+        return empty;
+    }
+    return res->info;
+}
+
+// ---------------------------------------------------------------------------
+// internal API (llama-residency.h)
+// ---------------------------------------------------------------------------
+
+int llama_residency_n_units(const struct llama_residency * res) {
+    return res == nullptr ? 0 : (int) res->units.size();
+}
+
+int llama_residency_unit_of_layer(const struct llama_residency * res, int il) {
+    if (res == nullptr) {
+        return -1;
+    }
+    for (size_t u = 0; u < res->units.size(); u++) {
+        if (res->units[u].kind == RES_UNIT_LAYER && res->units[u].layer == il) {
+            return (int) u;
+        }
+    }
+    return -1;
+}
+
+int llama_residency_unit_head(const struct llama_residency * res) {
+    return res == nullptr ? -1 : res->head_unit;
+}
+
+void llama_residency_on_gate_post(struct llama_residency * res, int unit) {
+    if (res == nullptr || unit < 0 || unit >= (int) res->units.size() || res->ring.empty()) {
+        return;
+    }
+
+    const int  n            = (int) res->ring.size();
+    const int  pos          = res->cursor_pos[unit];
+    const int  W            = (int) std::min<size_t>(res->params.prefetch_layers, (size_t) (n - 1));
+    // a unit that is itself in the ring has just executed and is already
+    // resident; one that is not (a pinned layer, misc) leaves the window's first
+    // unit still to be loaded.
+    const bool self_in_ring = res->ring_pos[unit] >= 0;
+
+    std::lock_guard<std::mutex> lk(res->mtx);
+
+    if (res->suspended) {
+        return;
+    }
+
+    // 1. evict every resident streamed unit outside the window [pos, pos+W]
+    for (int k = W + 1; k < n; k++) {
+        const int cand = res->ring[(pos + k) % n];
+        if (res->units[cand].pinned) {
+            continue;
+        }
+        if (res->states[cand].load() != RES_EVICTED) {
+            res_enqueue(res, RES_OP_EVICT, cand);
+        }
+    }
+
+    // 2. prefetch what the window wants and does not have
+    for (int k = self_in_ring ? 1 : 0; k <= W; k++) {
+        const int cand = res->ring[(pos + k) % n];
+        if (res->units[cand].pinned) {
+            continue;
+        }
+        if (res->states[cand].load() == RES_EVICTED) {
+            res_enqueue(res, RES_OP_PREFETCH, cand);
+        }
+    }
+
+    res->cv_work.notify_all();
+}
+
+void llama_residency_drain(struct llama_residency * res) {
+    if (res == nullptr) {
+        return;
+    }
+    std::unique_lock<std::mutex> lk(res->mtx);
+    res->cv_idle.wait(lk, [res] { return res->stop || (res->q.empty() && !res->busy); });
+}
+
+// ---------------------------------------------------------------------------
+// selftest
+// ---------------------------------------------------------------------------
+
+#if defined(__APPLE__)
+typedef char res_mincore_t;
+#else
+typedef unsigned char res_mincore_t;
+#endif
+
+// resident bytes over the unit's INWARD-aligned pages -- the granularity
+// eviction operates on, so a boundary page a neighbouring unit owns is never
+// counted against this unit.
+static bool res_mincore_unit(llama_residency * r, const res_unit & u, size_t * resident, size_t * total) {
+    std::vector<res_mincore_t> vec;
+
+    *resident = 0;
+    *total    = 0;
+
+    for (const auto & rg : u.ranges) {
+        const size_t first = res_align_up  (rg.first, r->page);
+        const size_t last  = res_align_down(rg.last,  r->page);
+        if (last <= first) {
+            continue;
+        }
+
+        const size_t n = (last - first) / r->page;
+        vec.assign(n, 0);
+
+        if (mincore(r->base + first, last - first, vec.data()) != 0) {
+            LLAMA_LOG_WARN("residency: mincore(%s) failed: %s\n", u.name.c_str(), strerror(errno));
+            return false;
+        }
+
+        *total += last - first;
+        for (size_t i = 0; i < n; i++) {
+            if (vec[i] & 1) {
+                *resident += r->page;
+            }
+        }
+    }
+
+    return true;
+}
+
+static double res_resident_pct(llama_residency * r, const res_unit & u) {
+    size_t resident = 0;
+    size_t total    = 0;
+    if (!res_mincore_unit(r, u, &resident, &total) || total == 0) {
+        return -1.0;
+    }
+    return 100.0 * (double) resident / (double) total;
+}
+
+static void res_log_env(void) {
+    FILE * f = fopen("/sys/fs/cgroup/memory.current", "rb");
+    if (f != nullptr) {
+        char line[128];
+        if (fgets(line, sizeof(line), f) != nullptr) {
+            LLAMA_LOG_INFO("residency selftest: cgroup memory.current = %s", line);
+        }
+        fclose(f);
+    }
+
+    f = fopen("/proc/self/smaps_rollup", "rb");
+    if (f != nullptr) {
+        char line[256];
+        while (fgets(line, sizeof(line), f) != nullptr) {
+            if (strncmp(line, "Rss:", 4) == 0 || strncmp(line, "Pss:", 4) == 0) {
+                LLAMA_LOG_INFO("residency selftest: smaps_rollup %s", line);
+            }
+        }
+        fclose(f);
+    }
+}
+
+bool llama_residency_selftest(struct llama_residency * res) {
+    if (res == nullptr) {
+        LLAMA_LOG_ERROR("%s", "residency selftest: no manager\n");
+        return false;
+    }
+
+    llama_residency * r = res;
+
+#if defined(__linux__)
+    const bool evict_hard = true;
+#else
+    // A3: MADV_DONTNEED is advisory on Darwin (mincore stayed 100% resident
+    // through every eviction step) and there is no posix_fadvise at all, so the
+    // eviction assertions are informational there.
+    const bool evict_hard = false;
+#endif
+
+    bool ok  = true;
+    char msg[512];
+
+    auto report = [&](bool cond, bool hard, const char * text) {
+        if (cond) {
+            return;
+        }
+        if (hard) {
+            LLAMA_LOG_ERROR("residency selftest: FAIL %s\n", text);
+            ok = false;
+        } else {
+            LLAMA_LOG_WARN("residency selftest: warn %s (informational on this platform)\n", text);
+        }
+    };
+
+    LLAMA_LOG_INFO("%s", "residency selftest: begin\n");
+
+    // ---- 1. table sanity --------------------------------------------------
+
+    size_t                 n_streamed  = 0;
+    size_t                 table_bytes = 0;
+    std::vector<res_range> all;
+
+    for (const auto & un : r->units) {
+        table_bytes += un.bytes;
+        if (!un.pinned) {
+            n_streamed++;
+        }
+        for (const auto & rg : un.ranges) {
+            if (rg.last <= rg.first || rg.last > r->map_size) {
+                snprintf(msg, sizeof(msg), "unit %s has range [%zu, %zu) in a %zu B mapping",
+                        un.name.c_str(), rg.first, rg.last, r->map_size);
+                report(false, true, msg);
+            }
+            all.push_back(rg);
+        }
+    }
+
+    snprintf(msg, sizeof(msg), "no streamed units at this budget -- nothing to test");
+    report(n_streamed >= 1 && !r->ring.empty(), true, msg);
+
+    std::sort(all.begin(), all.end(), [](const res_range & a, const res_range & b) {
+        return a.first < b.first;
+    });
+    for (size_t i = 1; i < all.size(); i++) {
+        if (all[i].first < all[i - 1].last) {
+            snprintf(msg, sizeof(msg), "ranges overlap: [%zu, %zu) and [%zu, %zu)",
+                    all[i - 1].first, all[i - 1].last, all[i].first, all[i].last);
+            report(false, true, msg);
+            break;
+        }
+    }
+
+    size_t tensor_bytes = 0;
+    size_t n_mapped     = 0;
+    for (const auto & it : r->model->tensors_by_name) {
+        if (it.second == nullptr || it.second->data == nullptr) {
+            continue;
+        }
+        tensor_bytes += ggml_nbytes(it.second);
+        n_mapped++;
+    }
+    snprintf(msg, sizeof(msg), "table covers %zu B, ggml_nbytes sums to %zu B", table_bytes, tensor_bytes);
+    report(tensor_bytes == table_bytes, true, msg);
+
+    LLAMA_LOG_INFO("residency selftest: table: %zu units over %zu tensors, %.1f MiB, "
+            "%zu streamed, %zu merged ranges\n",
+            r->units.size(), n_mapped, res_mib(table_bytes), n_streamed, all.size());
+
+    if (r->ring.empty()) {
+        LLAMA_LOG_INFO("%s", "residency selftest: end (no ring)\n");
+        return false;
+    }
+
+    // ---- 2. let the init pins and the first window land --------------------
+
+    llama_residency_drain(r);
+
+    // ---- 3. pins are resident ---------------------------------------------
+
+    {
+        size_t resident = 0;
+        size_t total    = 0;
+        for (const auto & un : r->units) {
+            if (!un.pinned) {
+                continue;
+            }
+            size_t ru = 0;
+            size_t tu = 0;
+            if (res_mincore_unit(r, un, &ru, &tu)) {
+                resident += ru;
+                total    += tu;
+            }
+        }
+        const double pct = total ? 100.0 * (double) resident / (double) total : 0.0;
+        LLAMA_LOG_INFO("residency selftest: pins resident %.2f%% (%.1f / %.1f MiB)\n",
+                pct, res_mib(resident), res_mib(total));
+        snprintf(msg, sizeof(msg), "pins resident %.2f%%, want >= 99.00%%", pct);
+        report(pct >= 99.0, true, msg);
+    }
+
+    // ---- 4. touch -> evict -------------------------------------------------
+
+    const int  probe = r->ring[r->ring.size() / 2];
+    res_unit & pu    = r->units[probe];
+
+    {
+        std::lock_guard<std::mutex> lk(r->mtx);
+        res_enqueue(r, RES_OP_PREFETCH, probe);
+    }
+    r->cv_work.notify_all();
+    llama_residency_drain(r);
+
+    double pct = res_resident_pct(r, pu);
+    LLAMA_LOG_INFO("residency selftest: probe %s touched: %.2f%% resident\n", pu.name.c_str(), pct);
+    snprintf(msg, sizeof(msg), "touch left %s at %.2f%% resident, want >= 95.00%%", pu.name.c_str(), pct);
+    report(pct >= 95.0, true, msg);
+
+    {
+        std::lock_guard<std::mutex> lk(r->mtx);
+        res_enqueue(r, RES_OP_EVICT, probe);
+    }
+    r->cv_work.notify_all();
+    llama_residency_drain(r);
+
+    pct = res_resident_pct(r, pu);
+    LLAMA_LOG_INFO("residency selftest: probe %s evicted: %.2f%% resident\n", pu.name.c_str(), pct);
+    snprintf(msg, sizeof(msg), "evict left %s at %.2f%% resident, want <= 5.00%%", pu.name.c_str(), pct);
+    report(pct <= 5.0, evict_hard, msg);
+
+    // ---- 5. prefetch bandwidth --------------------------------------------
+
+    {
+        const auto t0 = std::chrono::steady_clock::now();
+        {
+            std::lock_guard<std::mutex> lk(r->mtx);
+            res_enqueue(r, RES_OP_PREFETCH, probe);
+        }
+        r->cv_work.notify_all();
+        llama_residency_drain(r);
+        const auto t1 = std::chrono::steady_clock::now();
+
+        const double ms = std::chrono::duration<double, std::milli>(t1 - t0).count();
+        pct = res_resident_pct(r, pu);
+        LLAMA_LOG_INFO("residency selftest: prefetch %s: %.1f MiB in %.2f ms = %.1f MiB/s, %.2f%% resident%s\n",
+                pu.name.c_str(), res_mib(pu.bytes), ms, ms > 0.0 ? res_mib(pu.bytes) * 1000.0 / ms : 0.0,
+                pct, evict_hard ? "" : " (warm: nothing was actually evicted on this platform)");
+        snprintf(msg, sizeof(msg), "prefetch left %s at %.2f%% resident, want >= 95.00%%", pu.name.c_str(), pct);
+        report(pct >= 95.0, true, msg);
+    }
+
+    // ---- 6. simulated ring walk, 2 full cycles -----------------------------
+
+    const int    n     = (int) r->ring.size();
+    const int    W     = (int) std::min<size_t>(r->params.prefetch_layers, (size_t) (n - 1));
+    const size_t limit = (size_t) (W + 2) * (size_t) r->info.b_layer_max +
+                         (r->info.head_pinned ? 0 : (size_t) r->info.head_bytes);
+    // inward-aligned eviction leaves up to one partial page at each end of every
+    // streamed range, and readahead can overshoot a range end.
+    const size_t slack = 8u * 1024 * 1024 + 2 * r->page * (size_t) n;
+
+    size_t worst_state = 0;
+    size_t worst_core  = 0;
+
+    for (int step = 0; step < 2 * n; step++) {
+        const int u = r->ring[step % n];
+
+        llama_residency_on_gate_post(r, u);
+        llama_residency_drain(r);
+
+        size_t by_state = 0;
+        size_t by_core  = 0;
+
+        for (int k = 0; k < n; k++) {
+            const int cand = r->ring[k];
+            if (r->states[cand].load() == RES_RESIDENT) {
+                by_state += r->units[cand].bytes;
+            }
+            size_t ru = 0;
+            size_t tu = 0;
+            if (res_mincore_unit(r, r->units[cand], &ru, &tu)) {
+                by_core += ru;
+            }
+        }
+
+        worst_state = std::max(worst_state, by_state);
+        worst_core  = std::max(worst_core,  by_core);
+
+        if (by_state > limit) {
+            snprintf(msg, sizeof(msg), "ring step %d (%s): %.1f MiB tracked resident > limit %.1f MiB",
+                    step, r->units[u].name.c_str(), res_mib(by_state), res_mib(limit));
+            report(false, true, msg);
+            break;
+        }
+        if (by_core > limit + slack) {
+            snprintf(msg, sizeof(msg), "ring step %d (%s): %.1f MiB actually resident > limit %.1f MiB",
+                    step, r->units[u].name.c_str(), res_mib(by_core), res_mib(limit + slack));
+            report(false, evict_hard, msg);
+            if (evict_hard) {
+                break;
+            }
+        }
+    }
+
+    LLAMA_LOG_INFO("residency selftest: ring walk %d steps over %d units: peak tracked %.1f MiB, "
+            "peak resident %.1f MiB, limit %.1f MiB (+%.1f MiB slack)%s\n",
+            2 * n, n, res_mib(worst_state), res_mib(worst_core), res_mib(limit), res_mib(slack),
+            evict_hard ? "" : " -- resident column informational on Darwin");
+
+    // ---- 7. environment ----------------------------------------------------
+
+    res_log_env();
+
+    llama_residency_drain(r);
+
+    LLAMA_LOG_INFO("residency selftest: end (%s)\n", ok ? "all asserts held" : "failures above");
+
+    return ok;
+}
