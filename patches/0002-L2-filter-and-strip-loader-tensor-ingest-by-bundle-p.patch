From b17b532e0a61a8ca386849e2194c5f780ba91ff2 Mon Sep 17 00:00:00 2001
From: iitimii <timiiowolabi@gmail.com>
Date: Sun, 9 Aug 2026 07:51:15 +0100
Subject: [PATCH 02/16] L2: filter and strip loader tensor ingest by bundle
 prefix

Assisted-by: Claude Fable 5
---
 src/llama-model-loader.cpp | 24 +++++++++++++++++++++++-
 src/llama-model-loader.h   | 11 ++++++++++-
 src/llama.cpp              |  3 ++-
 3 files changed, 35 insertions(+), 3 deletions(-)

diff --git a/src/llama-model-loader.cpp b/src/llama-model-loader.cpp
index 71bc9f7..75a3bab 100644
--- a/src/llama-model-loader.cpp
+++ b/src/llama-model-loader.cpp
@@ -528,8 +528,12 @@ llama_model_loader::llama_model_loader(
         bool no_alloc,
         bool load_mtp,
         const llama_model_kv_override * param_overrides_p,
-        const llama_model_tensor_buft_override * param_tensor_buft_overrides_p)
+        const llama_model_tensor_buft_override * param_tensor_buft_overrides_p,
+        const char * bundle_prefix)
         : metadata(meta), set_tensor_data(set_tensor_data), set_tensor_data_ud(set_tensor_data_ud) {
+    if (bundle_prefix != nullptr) {
+        this->bundle_prefix = bundle_prefix;
+    }
     int trace = 0;
     if (getenv("LLAMA_TRACE")) {
         trace = atoi(getenv("LLAMA_TRACE"));
@@ -571,6 +575,12 @@ llama_model_loader::llama_model_loader(
         // so we build a unified tensors index for weights.
         for (ggml_tensor * cur = ggml_get_first_tensor(ctx); cur; cur = ggml_get_next_tensor(ctx, cur)) {
             std::string tensor_name = std::string(cur->name);
+            if (!this->bundle_prefix.empty()) {
+                if (tensor_name.compare(0, this->bundle_prefix.size(), this->bundle_prefix) != 0) {
+                    continue;
+                }
+                tensor_name = tensor_name.substr(this->bundle_prefix.size());
+            }
             // make sure there is no duplicated tensor names
             if (weights_map.find(tensor_name) != weights_map.end()) {
                 throw std::runtime_error(format("invalid model: tensor '%s' is duplicated", ggml_get_name(cur)));
@@ -579,11 +589,17 @@ llama_model_loader::llama_model_loader(
             n_bytes    += ggml_nbytes(cur);
             weights_map.emplace(tensor_name, llama_tensor_weight(files.back().get(), 0, metadata, cur));
         }
+        if (!this->bundle_prefix.empty() && weights_map.empty()) {
+            throw std::runtime_error(format("no tensors with bundle prefix '%s' in %s", this->bundle_prefix.c_str(), fname.c_str()));
+        }
         uint16_t n_split = 0;
         get_key(llm_kv(LLM_KV_SPLIT_COUNT), n_split, false);
 
         // Load additional GGML contexts
         if (n_split > 1) {
+            if (!this->bundle_prefix.empty()) {
+                throw std::runtime_error("bundle_prefix is not supported for split GGUFs");
+            }
             // make sure the main file is loaded first
             uint16_t idx = 0;
             const std::string kv_split_no = llm_kv(LLM_KV_SPLIT_NO);
@@ -681,6 +697,12 @@ llama_model_loader::llama_model_loader(
         // Save tensors data offset info of the main file.
         for (ggml_tensor * cur = ggml_get_first_tensor(ctx); cur; cur = ggml_get_next_tensor(ctx, cur)) {
             std::string tensor_name = std::string(cur->name);
+            if (!this->bundle_prefix.empty()) {
+                if (tensor_name.compare(0, this->bundle_prefix.size(), this->bundle_prefix) != 0) {
+                    continue;
+                }
+                tensor_name = tensor_name.substr(this->bundle_prefix.size());
+            }
             // make sure there is no duplicated tensor names
             if (weights_map.find(tensor_name) != weights_map.end()) {
                 throw std::runtime_error(format("invalid model: tensor '%s' is duplicated", ggml_get_name(cur)));
diff --git a/src/llama-model-loader.h b/src/llama-model-loader.h
index d6b31c2..7d26d1b 100644
--- a/src/llama-model-loader.h
+++ b/src/llama-model-loader.h
@@ -101,6 +101,14 @@ struct llama_model_loader {
     std::string arch_name;
     LLM_KV      llm_kv    = LLM_KV(LLM_ARCH_UNKNOWN);
 
+    // sub-model prefix for bundle GGUFs; empty = normal load
+    std::string bundle_prefix;
+
+    // map a requested KV name to its on-file name
+    std::string resolve_key(const std::string & key) const {
+        return bundle_prefix.empty() ? key : bundle_prefix + key;
+    }
+
     size_t size_done = 0;
     size_t size_data = 0;
     std::vector<std::pair<size_t, size_t>> mmaps_used;
@@ -133,7 +141,8 @@ struct llama_model_loader {
         bool no_alloc,
         bool load_mtp,
         const llama_model_kv_override * param_overrides_p,
-        const llama_model_tensor_buft_override * param_tensor_buft_overrides_p);
+        const llama_model_tensor_buft_override * param_tensor_buft_overrides_p,
+        const char * bundle_prefix = nullptr);
 
     template<typename T>
     typename std::enable_if<std::is_integral<T>::value, bool>::type
diff --git a/src/llama.cpp b/src/llama.cpp
index d6e0bbf..d1de2ab 100644
--- a/src/llama.cpp
+++ b/src/llama.cpp
@@ -305,7 +305,8 @@ static std::pair<int, llama_model *> llama_model_load(struct gguf_context * meta
         const std::string & fname, std::vector<std::string> & splits, FILE * file, llama_model_params & params) {
     try {
         llama_model_loader ml(metadata, set_tensor_data, set_tensor_data_ud, fname, splits, file, params.load_mode,
-            params.check_tensors, params.no_alloc, params.load_mtp, params.kv_overrides, params.tensor_buft_overrides);
+            params.check_tensors, params.no_alloc, params.load_mtp, params.kv_overrides, params.tensor_buft_overrides,
+            params.bundle_prefix);
 
         ml.print_info();
         std::unique_ptr<llama_model> model_ptr(llama_model_create(ml, params));
-- 
