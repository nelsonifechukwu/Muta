{
  "_comment": "60-expression verifier golden set (TDD T8 acceptance: 100% verifier correctness). Cases are written the way a Qwen-class model and a WAEC student actually write answers — LaTeX fragments, boxed values, roots in either form, sets of roots, units. Roughly a third are NEGATIVE cases, because a verifier that says yes to everything passes a positive-only suite and is worse than no verifier at all.",
  "cases": [
    {"candidate": "2x", "expected": "x + x", "equivalent": true, "note": "trivial algebraic identity"},
    {"candidate": "\\boxed{4}", "expected": "4", "equivalent": true, "note": "boxed convention"},
    {"candidate": "The answer is \\boxed{-3}", "expected": "-3", "equivalent": true, "note": "boxed with prose"},
    {"candidate": "x^2 + 2x + 1", "expected": "(x+1)^2", "equivalent": true, "note": "expansion"},
    {"candidate": "(x+2)(x+3)", "expected": "x^2 + 5x + 6", "equivalent": true, "note": "factorised form"},
    {"candidate": "x^2 - 9", "expected": "(x-3)(x+3)", "equivalent": true, "note": "difference of squares"},
    {"candidate": "\\frac{1}{2}", "expected": "0.5", "equivalent": true, "note": "latex fraction vs decimal"},
    {"candidate": "0.75", "expected": "3/4", "equivalent": true, "note": "decimal vs fraction"},
    {"candidate": "\\frac{22}{7}", "expected": "22/7", "equivalent": true, "note": "latex vs plain fraction"},
    {"candidate": "\\dfrac{3}{6}", "expected": "1/2", "equivalent": true, "note": "unsimplified fraction"},
    {"candidate": "\\frac{x^2 - 1}{x - 1}", "expected": "x + 1", "equivalent": true, "note": "cancels"},
    {"candidate": "\\sqrt{16}", "expected": "4", "equivalent": true, "note": "surd evaluates"},
    {"candidate": "2\\sqrt{2}", "expected": "\\sqrt{8}", "equivalent": true, "note": "surd forms"},
    {"candidate": "\\sqrt{2}/2", "expected": "1/\\sqrt{2}", "equivalent": true, "note": "rationalised denominator"},
    {"candidate": "x = 2", "expected": "2x = 4", "equivalent": true, "note": "same equation, scaled"},
    {"candidate": "2", "expected": "x = 2", "equivalent": true, "note": "bare value vs solved equation"},
    {"candidate": "y = 3x + 2", "expected": "y - 3x = 2", "equivalent": true, "note": "rearranged"},
    {"candidate": "x = 2, x = 3", "expected": "3, 2", "equivalent": true, "note": "root set, order irrelevant"},
    {"candidate": "x = -1 or x = 4", "expected": "4, -1", "equivalent": true, "note": "'or' separated roots"},
    {"candidate": "12 cm", "expected": "12 cm", "equivalent": true, "note": "matching units"},
    {"candidate": "9.8 m", "expected": "9.80 m", "equivalent": true, "note": "trailing zero"},
    {"candidate": "50%", "expected": "0.5", "equivalent": true, "note": "percentage"},
    {"candidate": "2\\pi r", "expected": "2*pi*r", "equivalent": true, "note": "latex pi and implicit multiplication"},
    {"candidate": "\\pi r^2", "expected": "pi*r**2", "equivalent": true, "note": "area of a circle"},
    {"candidate": "\\sin^2(x) + \\cos^2(x)", "expected": "1", "equivalent": true, "note": "trig identity with superscript notation"},
    {"candidate": "2\\sin(x)\\cos(x)", "expected": "\\sin(2x)", "equivalent": true, "note": "double angle"},
    {"candidate": "\\frac{d}{dx}", "expected": "\\frac{d}{dx}", "equivalent": true, "note": "identical unparseable text falls back to string compare"},
    {"candidate": "3 \\times 4", "expected": "12", "equivalent": true, "note": "latex times"},
    {"candidate": "10 \\div 4", "expected": "2.5", "equivalent": true, "note": "latex div"},
    {"candidate": "\\frac{1}{2} + \\frac{1}{3}", "expected": "5/6", "equivalent": true, "note": "fraction addition"},
    {"candidate": "x^{2n}", "expected": "x**(2*n)", "equivalent": true, "note": "braced exponent must not split"},
    {"candidate": "(a+b)^2", "expected": "a^2 + 2ab + b^2", "equivalent": true, "note": "binomial expansion"},
    {"candidate": "8^{2/3}", "expected": "4", "equivalent": true, "note": "fractional index"},
    {"candidate": "2^{-3}", "expected": "1/8", "equivalent": true, "note": "negative index"},
    {"candidate": "\\log(1)", "expected": "0", "equivalent": true, "note": "log of one"},
    {"candidate": "|-7|", "expected": "7", "equivalent": true, "note": "absolute value"},
    {"candidate": "$x + 1$", "expected": "1 + x", "equivalent": true, "note": "dollar-delimited maths, commutativity"},
    {"candidate": "Therefore the answer is 42.", "expected": "42", "equivalent": true, "note": "prose with trailing full stop"},
    {"candidate": "0", "expected": "0.0", "equivalent": true, "note": "integer vs float zero"},
    {"candidate": "-\\frac{1}{4}", "expected": "-0.25", "equivalent": true, "note": "negative fraction"},

    {"candidate": "x + 1", "expected": "x - 1", "equivalent": false, "note": "sign error"},
    {"candidate": "4", "expected": "5", "equivalent": false, "note": "plain wrong"},
    {"candidate": "x = 2", "expected": "x = 3", "equivalent": false, "note": "wrong root"},
    {"candidate": "2, 3", "expected": "2, 4", "equivalent": false, "note": "one root wrong"},
    {"candidate": "2, 3", "expected": "2, 3, 5", "equivalent": false, "note": "missing a root"},
    {"candidate": "12 cm", "expected": "12 m", "equivalent": false, "note": "unit mismatch — the classic silent marking error"},
    {"candidate": "1/3", "expected": "0.333", "equivalent": false, "note": "rounded, and exact comparison is the default"},
    {"candidate": "3.14", "expected": "pi", "equivalent": false, "note": "approximation is not equality"},
    {"candidate": "x^2 + 2x + 1", "expected": "(x-1)^2", "equivalent": false, "note": "wrong factorisation"},
    {"candidate": "\\sqrt{16}", "expected": "-4", "equivalent": false, "note": "principal root only"},
    {"candidate": "2x", "expected": "x^2", "equivalent": false, "note": "double vs square, the commonest slip"},
    {"candidate": "\\frac{1}{2}", "expected": "\\frac{2}{1}", "equivalent": false, "note": "inverted fraction"},
    {"candidate": "y = 3x + 2", "expected": "y = 2x + 3", "equivalent": false, "note": "swapped coefficients"},
    {"candidate": "2\\sin(x)\\cos(x)", "expected": "\\sin(x)", "equivalent": false, "note": "wrong identity"},
    {"candidate": "0.5", "expected": "5", "equivalent": false, "note": "decimal point slip"},
    {"candidate": "8^{2/3}", "expected": "16/3", "equivalent": false, "note": "index misapplied"},
    {"candidate": "50%", "expected": "50", "equivalent": false, "note": "percentage vs raw number"},
    {"candidate": "(a+b)^2", "expected": "a^2 + b^2", "equivalent": false, "note": "the freshman's dream"},
    {"candidate": "-7", "expected": "7", "equivalent": false, "note": "sign dropped"},
    {"candidate": "x = 2, x = 3", "expected": "x = 2", "equivalent": false, "note": "one of two roots"}
  ]
}
