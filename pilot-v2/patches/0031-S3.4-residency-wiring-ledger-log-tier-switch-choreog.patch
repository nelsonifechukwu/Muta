+static llama_residency * duo_residency_init(duo_state & s, duo_tier & t,
+                                            const std::string & name, const std::string & file) {
+    llama_residency_params rp = duo_ledger_terms(s, t, name, /*log*/ true);
+
+    llama_residency * res = llama_residency_init(t.m.model.get(), file.c_str(), rp);
+    if (res) {
+        t.residency = res;
+        duo_residency_park(t, name);
+        return res;
+    }
+
+    // demote candidate: a resident tier that is not this one and was not pinned by
+    // the operator. Only easy is ever a candidate today; the loop keeps that a fact
+    // about the registry rather than about this code.
+    duo_tier * cand = nullptr;
+    for (auto & o : s.tiers) {
+        if (&o != &t && o.policy == POL_RESIDENT && o.state.load(std::memory_order_acquire) == TS_UNLOADED) {
+            cand = &o;
+            break;
+        }
+    }
+    if (!cand) {
+        return nullptr;
+    }
+    if (s.p.tier_policy_ovr.count(tier_role_name(cand->role))) {
+        fprintf(stderr, "[ledger] REFUSED: %s does not fit at --max-ram-mib %d and --tier-policy %s=resident "
+                "was given explicitly; not demoting. Raise --max-ram-mib, lower the tier context, "
+                "or drop the explicit policy.\n",
+                name.c_str(), s.p.max_ram_mib, tier_role_name(cand->role));
+        return nullptr;
+    }
+
+    fprintf(stderr, "[ledger] DEMOTE %s resident->streamed (%s's ledger refused at max_ram=%d MiB with %s resident)\n",
+            tier_role_name(cand->role), name.c_str(), s.p.max_ram_mib, tier_role_name(cand->role));
+    jtrace("{\"type\":\"ledger\",\"event\":\"demote\",\"tier\":\"%s\",\"reason\":\"%s refused\"}",
+           tier_role_name(cand->role), name.c_str());
+    // sticky by construction: the policy field is overwritten in place and never
+    // restored, and the ledger is not re-solved after startup. Re-promoting on the
+    // next favourable solve is exactly what would let the two policies oscillate
+    // turn by turn, so it is not offered.
+    cand->policy = POL_STREAMED;
+
+    rp  = duo_ledger_terms(s, t, name, /*log*/ true);
+    res = llama_residency_init(t.m.model.get(), file.c_str(), rp);
+    if (res) {
+        t.residency = res;
+        duo_residency_park(t, name);
+    }
+    return res;
+}
