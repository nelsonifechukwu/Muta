+// ---------- per-tier RAM facts, from metadata only ----------
+//
+// Reads one integer KV, tolerating the width the writer happened to use, and
+// taking the max over an array-valued key (per-layer head counts). Returns false
+// when the key is absent so callers can fall back.
+static bool gguf_kv_u32(const gguf_context * ctx, const std::string & key, uint32_t & out) {
+    const int64_t k = gguf_find_key(ctx, key.c_str());
+    if (k < 0) {
+        return false;
+    }
+    auto scalar = [&](gguf_type t, size_t i, uint32_t & v) -> bool {
+        switch (t) {
+            case GGUF_TYPE_UINT8:  v = ((const uint8_t  *) gguf_get_arr_data(ctx, k))[i]; return true;
+            case GGUF_TYPE_INT8:   v = (uint32_t) ((const int8_t   *) gguf_get_arr_data(ctx, k))[i]; return true;
+            case GGUF_TYPE_UINT16: v = ((const uint16_t *) gguf_get_arr_data(ctx, k))[i]; return true;
+            case GGUF_TYPE_INT16:  v = (uint32_t) ((const int16_t  *) gguf_get_arr_data(ctx, k))[i]; return true;
+            case GGUF_TYPE_UINT32: v = ((const uint32_t *) gguf_get_arr_data(ctx, k))[i]; return true;
+            case GGUF_TYPE_INT32:  v = (uint32_t) ((const int32_t  *) gguf_get_arr_data(ctx, k))[i]; return true;
+            default: return false;
+        }
+    };
+    const gguf_type kt = gguf_get_kv_type(ctx, k);
+    if (kt == GGUF_TYPE_ARRAY) {
+        const gguf_type at = gguf_get_arr_type(ctx, k);
+        const size_t    n  = gguf_get_arr_n(ctx, k);
+        uint32_t best = 0;
+        for (size_t i = 0; i < n; i++) {
+            uint32_t v = 0;
+            if (!scalar(at, i, v)) {
+                return false;
+            }
+            best = std::max(best, v);
+        }
+        out = best;
+        return n > 0;
+    }
+    switch (kt) {
+        case GGUF_TYPE_UINT8:  out = gguf_get_val_u8 (ctx, k); return true;
+        case GGUF_TYPE_INT8:   out = (uint32_t) gguf_get_val_i8 (ctx, k); return true;
+        case GGUF_TYPE_UINT16: out = gguf_get_val_u16(ctx, k); return true;
+        case GGUF_TYPE_INT16:  out = (uint32_t) gguf_get_val_i16(ctx, k); return true;
+        case GGUF_TYPE_UINT32: out = gguf_get_val_u32(ctx, k); return true;
+        case GGUF_TYPE_INT32:  out = (uint32_t) gguf_get_val_i32(ctx, k); return true;
+        case GGUF_TYPE_UINT64: out = (uint32_t) gguf_get_val_u64(ctx, k); return true;
+        case GGUF_TYPE_INT64:  out = (uint32_t) gguf_get_val_i64(ctx, k); return true;
+        default: return false;
+    }
+}
+
+// Per-tier weight span + context memory, computed from the GGUF header alone
+// (no_alloc, milliseconds). The KV arithmetic mirrors llama.cpp's own sizing --
+// llama_hparams::n_embd_k_gqa/n_embd_v_gqa for the attention layers, n_embd_r/
+// n_embd_s for the recurrent (Gated-DeltaNet) ones, F16 for K/V and F32 for the
+// recurrent state, kv cells = n_ctx_seq (== n_ctx here: duo builds kv_unified
+// contexts) and recurrent cells = n_seq_max. It has to be metadata-based rather
+// than read off a live context: the ledger charges each tier for the KV of tiers
+// that have not been loaded yet.
+//
+// An arch that carries no ssm.* keys is treated as fully dense, which is exact for
+// llama-family fronts and a conservative over-estimate for anything unknown.
+static bool tier_read_facts(const std::string & file, const std::string & prefix,
+                            uint32_t n_ctx, bool checkpoint_requested, uint32_t n_ubatch,
+                            duo_tier_facts & out) {
+    struct gguf_init_params gp = { /*.no_alloc =*/ true, /*.ctx =*/ NULL };
+    struct gguf_context * ctx = gguf_init_from_file(file.c_str(), gp);
+    if (!ctx) {
+        return false;
+    }
+
+    // tensor span: every tensor whose name carries this tier's prefix
+    uint64_t weight_bytes = 0;
+    const int64_t n_tensors = gguf_get_n_tensors(ctx);
+    for (int64_t i = 0; i < n_tensors; i++) {
+        const char * name = gguf_get_tensor_name(ctx, i);
+        if (prefix.empty() || strncmp(name, prefix.c_str(), prefix.size()) == 0) {
+            weight_bytes += gguf_get_tensor_size(ctx, i);
+        }
+    }
+
+    uint32_t n_vocab = 0;
+    {
+        const int64_t k = gguf_find_key(ctx, (prefix + "tokenizer.ggml.tokens").c_str());
+        if (k >= 0 && gguf_get_kv_type(ctx, k) == GGUF_TYPE_ARRAY) {
+            n_vocab = (uint32_t) gguf_get_arr_n(ctx, k);
+        }
+    }
+
+    std::string arch;
+    {
+        const int64_t k = gguf_find_key(ctx, (prefix + "general.architecture").c_str());
+        if (k >= 0 && gguf_get_kv_type(ctx, k) == GGUF_TYPE_STRING) {
+            arch = gguf_get_val_str(ctx, k);
+        }
+    }
+    if (arch.empty()) {
+        gguf_free(ctx);
+        return false;
+    }
+    const std::string ap = prefix + arch + ".";
+
+    uint32_t n_layer_all = 0, n_layer_nextn = 0;
+    uint32_t n_embd = 0, n_head = 0, n_head_kv = 0, n_embd_head_k = 0, n_embd_head_v = 0;
+    uint32_t full_attn_interval = 0;
+    uint32_t ssm_d_conv = 0, ssm_d_inner = 0, ssm_d_state = 0, ssm_n_group = 0;
+
+    if (!gguf_kv_u32(ctx, ap + "block_count", n_layer_all)) {
+        gguf_free(ctx);
+        return false;
+    }
+    gguf_kv_u32(ctx, ap + "nextn_predict_layers",       n_layer_nextn);
+    gguf_kv_u32(ctx, ap + "embedding_length",           n_embd);
+    gguf_kv_u32(ctx, ap + "attention.head_count",       n_head);
+    if (!gguf_kv_u32(ctx, ap + "attention.head_count_kv", n_head_kv)) {
+        n_head_kv = n_head;
+    }
+    if (!gguf_kv_u32(ctx, ap + "attention.key_length", n_embd_head_k)) {
+        n_embd_head_k = n_head > 0 ? n_embd / n_head : 0;
+    }
+    if (!gguf_kv_u32(ctx, ap + "attention.value_length", n_embd_head_v)) {
