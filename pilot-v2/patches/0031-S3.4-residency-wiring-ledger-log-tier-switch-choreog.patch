+// Tier-switch choreography. Called at the DECISION point, not at the first decode:
+// resume_async returns immediately and the manager thread installs the pins and the
+// first window while the front is still writing, so the overlap pays for the
+// activation. There is deliberately no barrier before the first decode -- a page
+// that has not arrived yet simply faults in, which is correct, just slower.
+//
+// Suspend is what keeps the ledger true: it bulk-evicts the outgoing tier INCLUDING
+// its pins, leaving only its (never-freed) KV charged against the incoming tier.
+// A tier that is not streamed is not part of this rotation at all: its weights are
+// already accounted as a static cross-term in every streamed tier's ledger.
+static void duo_switch_to(duo_state & s, duo_tier * in, const char * reason) {
+    if (!s.p.stream_weights || !in) {
+        return;
+    }
+    // TS_READY is also the memory barrier: duo_tier::residency is written by the
+    // loader thread inside the load, and the acquire here pairs with the release in
+    // tier_publish. Reading it before that would be a genuine data race, so a tier
+    // that is still loading is simply not switchable yet -- the tier_activate after
+    // the blocking acquire does the switch instead.
+    if (in->state.load(std::memory_order_acquire) != TS_READY || !in->residency) {
