+// The ledger's one adaptive decision, taken once per session: if this streamed
+// tier cannot be fitted while a RESIDENT tier holds its weights, demote that tier
+// to streamed and try again. Sticky (duo_state::demoted_easy) and loud. An
+// explicit --tier-policy easy=resident refuses to start instead: the operator
+// asked for a configuration that does not fit, and silently overriding them would
+// hide the very inequality they need to see.
+
+// A freshly built manager has already queued its pins and its first window. A tier
+// that is not the active one must not hold either: park it now, so that at most one
+// streamed tier is ever occupying RAM. suspend() clears the pending queue before
+// enqueuing the evicts, so almost none of that prefetch work is actually performed
+// -- the cost of the park is bounded by whatever single op the manager thread had
+// already started.
+static void duo_residency_park(duo_tier & t, const std::string & name) {
+    const llama_residency_info ri = llama_residency_get_info(t.residency);
+    fprintf(stderr, "[ledger] %s solved: config=%s pinned=%.1fMiB (%u blk) streamed=%.1fMiB (%u blk%s) W=%u\n",
+            name.c_str(), ri.head_pinned ? "head-pinned" : "head-streamed",
+            ri.pinned_bytes / 1048576.0, ri.n_pinned_layers,
+            ri.streamed_bytes / 1048576.0, ri.n_streamed_layers,
+            ri.head_pinned ? "" : "+head", ri.window);
+    jtrace("{\"type\":\"ledger\",\"tier\":\"%s\",\"event\":\"solved\",\"config\":\"%s\","
+           "\"pinned_mib\":%.1f,\"streamed_mib\":%.1f,\"window\":%u}",
+           name.c_str(), ri.head_pinned ? "head-pinned" : "head-streamed",
+           ri.pinned_bytes / 1048576.0, ri.streamed_bytes / 1048576.0, ri.window);
+
+    // Unconditional, and it has to be: this runs on the LOADER thread, and reading
+    // duo_state::active_streamed here would race main's writes to it. It is also
+    // provably the right thing -- main can only switch to a tier whose TS_READY it
+    // has observed, and this tier has not been published yet, so it cannot be the
+    // active one.
+    llama_residency_suspend(t.residency);
+}
