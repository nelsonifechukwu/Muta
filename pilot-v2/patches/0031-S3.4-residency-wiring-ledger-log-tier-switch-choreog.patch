+// Build llama_residency_params for `self` and print the derivation. Returns the
+// params; the caller decides what to do with a refusal.
+static llama_residency_params duo_ledger_terms(duo_state & s, const duo_tier & self,
+                                               const std::string & name, bool log) {
+    llama_residency_params rp = llama_residency_default_params();
+
+    uint64_t mlock_bytes    = 0;
+    uint64_t resident_bytes = 0;
+
+    std::vector<std::string> items;
+    char line[256];
+
+    for (const auto & t : s.tiers) {
+        if (&t == &self) {
+            continue;
+        }
+        const uint64_t w = duo_tier_resident_bytes(t);
+        if (t.policy == POL_MLOCK) {
+            mlock_bytes += w;
+            if (log && w > 0) {
+                snprintf(line, sizeof(line), "  mlock_front  %8.1f MiB  %s weights (lock range, header-inclusive)",
+                         w / 1048576.0, tier_role_name(t.role));
+                items.push_back(line);
+            }
+        } else if (w > 0) {
+            resident_bytes += w;
+            if (log) {
+                snprintf(line, sizeof(line), "  resident     %8.1f MiB  %s weights (policy=%s)",
+                         w / 1048576.0, tier_role_name(t.role), tier_policy_name(t.policy));
+                items.push_back(line);
+            }
+        }
+        if (t.facts.known && t.facts.kv_bytes > 0) {
+            resident_bytes += t.facts.kv_bytes;
+            if (log) {
+                snprintf(line, sizeof(line), "  resident     %8.1f MiB  %s kv (n_ctx %u x %u seq, %u attn + %u recr blk)%s",
+                         t.facts.kv_bytes / 1048576.0, tier_role_name(t.role), t.facts.n_ctx_eff,
+                         t.facts.n_seq_max, t.facts.n_layer_attn, t.facts.n_layer_recr,
+                         t.facts.n_seq_max > 1 ? " [checkpoint-doubled]" : "");
+                items.push_back(line);
+            }
+        }
+        // every tier's compute buffer is reserved at context creation and held for
+        // the life of the process, whether or not that tier is the one decoding
+        if (t.facts.known && t.facts.compute_bytes > 0) {
+            resident_bytes += t.facts.compute_bytes;
+            if (log) {
+                snprintf(line, sizeof(line), "  resident     %8.1f MiB  %s compute (vocab %u x ubatch)",
+                         t.facts.compute_bytes / 1048576.0, tier_role_name(t.role), t.facts.n_vocab);
+                items.push_back(line);
+            }
