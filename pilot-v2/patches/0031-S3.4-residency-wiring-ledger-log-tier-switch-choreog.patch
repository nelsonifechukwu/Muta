+// One line of state per switch (and at startup), from the manager itself rather
+// than from what duo asked for: this is the G8 evidence.
+static void duo_ledger_recap(const duo_state & s, const char * why) {
+    if (!s.active_streamed || !s.active_streamed->residency) {
+        return;
+    }
+    const llama_residency_info ri = llama_residency_get_info(s.active_streamed->residency);
+    fprintf(stderr, "[ledger] active=%s pinned=%.1fMiB streamed=%.1fMiB W=%u config=%s reason=%s\n",
+            tier_role_name(s.active_streamed->role),
+            ri.pinned_bytes / 1048576.0, ri.streamed_bytes / 1048576.0, ri.window,
+            ri.head_pinned ? "head-pinned" : "head-streamed", why);
+    jtrace("{\"type\":\"ledger\",\"event\":\"active\",\"tier\":\"%s\",\"pinned_mib\":%.1f,"
+           "\"streamed_mib\":%.1f,\"window\":%u,\"reason\":\"%s\"}",
+           tier_role_name(s.active_streamed->role), ri.pinned_bytes / 1048576.0,
+           ri.streamed_bytes / 1048576.0, ri.window, why);
+}
