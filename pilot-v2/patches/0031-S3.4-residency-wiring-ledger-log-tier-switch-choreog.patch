+    rp.max_ram_mib        = (uint32_t) std::max(0, s.p.max_ram_mib);
+    rp.prefetch_layers    = (uint32_t) std::max(0, s.p.prefetch_layers);
+    rp.mlock_front_mib    = (uint32_t) duo_ceil_mib(mlock_bytes);
+    rp.resident_other_mib = (uint32_t) duo_ceil_mib(resident_bytes);
+    rp.reserve_mib        = (uint32_t) (reserve_kv + (uint64_t) std::max(0, s.p.stream_reserve_mib));
