+// the resident weight footprint a tier charges to OTHER tiers' ledgers
+static uint64_t duo_tier_resident_bytes(const duo_tier & t) {
+    switch (t.policy) {
+        case POL_MLOCK:
+            // prefer the measured lock range; fall back to the tensor span when the
+            // tier is not loaded yet or the lock was refused (the pages are resident
+            // either way -- the load faulted them in)
+            if (t.state.load(std::memory_order_acquire) == TS_READY && t.m.model) {
+                const uint64_t locked = llama_model_mlock_bytes(t.m.model.get());
+                if (locked > 0) {
+                    return locked;
+                }
+            }
+            return t.facts.weight_bytes;
+        case POL_RESIDENT:
+            return t.facts.weight_bytes;
+        case POL_STREAMED:
+        case POL_AUTO:
+        default:
+            return 0;   // suspended while another streamed tier is active
+    }
+}
