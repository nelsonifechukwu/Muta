+// Teardown order for one tier, and the reason for it. The context's cb_eval points
+// at the manager, so the manager must outlive the context; the manager evicts
+// through the MODEL's mapping, so it must die before the model. Sampler first
+// (it only references the model), then ctx, then manager, then model. This is the
+// same ordering common_init_result gets from its member declaration order
+// (common.cpp: model, residency, context -- destroyed bottom-to-top).
+static void duo_tier_free(duo_tier & t) {
+    t.m.smpl.reset();
+    t.m.ctx.reset();
+    if (t.residency) {
+        // contract: no graph may be executing. Every caller is past the last decode
+        // (main's teardown, or a load that failed before its context existed).
+        llama_residency_free(t.residency);
+        t.residency = nullptr;
+    }
+    t.m.model.reset();
+}
