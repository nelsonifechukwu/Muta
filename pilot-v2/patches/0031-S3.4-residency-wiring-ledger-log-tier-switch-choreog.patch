+               "\"mlock_front_mib\":%u,\"resident_other_mib\":%u,\"reserve_mib\":%u,\"own_kv_mib\":%" PRIu64 "}",
+               name.c_str(), rp.max_ram_mib, rp.mlock_front_mib, rp.resident_other_mib,
+               rp.reserve_mib, reserve_kv);
+    }
+
+    return rp;
+}
