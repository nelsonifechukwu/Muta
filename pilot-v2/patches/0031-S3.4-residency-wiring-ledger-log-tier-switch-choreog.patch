+    if (log) {
+        fprintf(stderr, "[ledger] ---- %s (policy=%s) ----\n", name.c_str(), tier_policy_name(self.policy));
+        fprintf(stderr, "[ledger]   max_ram      %8d MiB\n", s.p.max_ram_mib);
+        for (const auto & it : items) {
+            fprintf(stderr, "[ledger] %s\n", it.c_str());
+        }
+        fprintf(stderr, "[ledger]   reserve      %8.1f MiB  own kv (n_ctx %u x %u seq, %u attn + %u recr blk)%s\n",
+                own_kv / 1048576.0, self.facts.n_ctx_eff, self.facts.n_seq_max,
+                self.facts.n_layer_attn, self.facts.n_layer_recr,
+                self.facts.n_seq_max > 1 ? " [checkpoint-doubled]" : "");
+        fprintf(stderr, "[ledger]   reserve      %8.1f MiB  own compute (vocab %u x ubatch)\n",
+                own_compute / 1048576.0, self.facts.n_vocab);
+        fprintf(stderr, "[ledger]   reserve      %8d MiB  slack (--stream-reserve-mib)\n",
+                s.p.stream_reserve_mib);
+        fprintf(stderr, "[ledger]   => residency_init(max_ram=%u, mlock_front=%u, resident_other=%u, "
+                "reserve=%u, W=%u, pin_budget=%s, D=%.3f GB/s)\n",
+                rp.max_ram_mib, rp.mlock_front_mib, rp.resident_other_mib, rp.reserve_mib,
+                rp.prefetch_layers, s.p.pin_budget.c_str(), (double) rp.disk_gbps);
