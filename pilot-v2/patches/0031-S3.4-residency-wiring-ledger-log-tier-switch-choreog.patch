--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -1728,6 +1728,21 @@ const llama_mmaps & llama_model::mappings() const {
     return pimpl->mappings;
 }
 
+size_t llama_model::mlock_bytes() const {
+    size_t total = 0;
+    // both lists: mlock_mmaps holds the locks grown over the mmap'ed ranges,
+    // mlock_bufs the ones over copied (non-mmap) tensor buffers. A model uses one
+    // or the other depending on its load mode; summing both keeps the accessor
+    // honest for either.
+    for (const auto & ml : pimpl->mlock_mmaps) {
+        total += ml->size();
+    }
+    for (const auto & ml : pimpl->mlock_bufs) {
+        total += ml->size();
+    }
+    return total;
+}
