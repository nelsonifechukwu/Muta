From ae76ab0695d4aa3c233402b3b9cff97339e010fe Mon Sep 17 00:00:00 2001
From: iitimii <timiiowolabi@gmail.com>
Date: Wed, 12 Aug 2026 22:29:06 +0100
Subject: [PATCH 21/24] S1b: propagate solver-chosen window, re-arm RANDOM
 after touch, PIN CAS

Four defects found by task review of the S1b module.

- CRITICAL: the ring ran at the REQUESTED window, not the one the ledger
  chose. res_solve() reduces W on a tight budget but recorded it only in
  info.window, while all four runtime consumers (init's first window,
  resume_async, on_gate_post, the selftest's ring-walk bound) read
  params.prefetch_layers. On any budget where W drops 2 -> 1 the state
  machine kept one whole b_layer_max more resident than the plan the ledger
  printed, and the selftest's own (W+2)*b limit inflated in lockstep so the
  assert could not fire. All four now read info.window; params.prefetch_layers
  is documented as the request and is read only by the solver.
- POSIX_MADV_RANDOM was lifted permanently: res_prefetch_hint() set NORMAL
  per range and nothing put it back, so after one ring cycle every streamed
  range stayed NORMAL and the compute path's own demand faults would read
  ahead into pages the manager had just evicted. New res_rearm_random()
  restores RANDOM over the same ranges immediately after the touch loop --
  the pages are already resident, so it only governs future faults.
- PIN settled its state with an unconditional store while PREFETCH used a
  CAS. suspend() enqueues an EVICT for pinned units too, so an in-flight PIN
  could land afterwards and clobber EVICTED back to RESIDENT with nothing to
  correct it. PIN now uses the same CAS(QUEUED -> RESIDENT).
- selftest: the pins-resident assert reported 0.00% and failed when the whole
  pinned set is smaller than one page (misc only, 10,240 B, invisible after
  inward alignment at 16 KiB). Zero resident of zero measurable is not a
  failure; it is now reported as unmeasurable and skipped. Found by the new
  reduced-W coverage below, which pins nothing but misc.

Coverage for the critical fix: the 4B solver reduces W 2 -> 1 for
--max-ram-mib in [1277.9, 1348.2) MiB. At 1300 the plan is head-streamed,
W = 1, 0 pinned layers, 33 ring units; the ring walk holds peak resident
567.6 MiB == head 497.3 + one layer 70.3, i.e. exactly W+1 units at the
CHOSEN W, against the chosen-W bound of 708.3 MiB.

Assisted-by: Claude Fable 5
---
 src/llama-residency.cpp | 89 ++++++++++++++++++++++++++++++++---------
 1 file changed, 69 insertions(+), 20 deletions(-)

diff --git a/src/llama-residency.cpp b/src/llama-residency.cpp
index 9c30ef7..2c11fd6 100644
--- a/src/llama-residency.cpp
+++ b/src/llama-residency.cpp
@@ -50,8 +50,9 @@
 //            ahead of it as a hint only. A3 measured the touch loop on a
 //            mapping with default advice; the streaming load sets
 //            POSIX_MADV_RANDOM over the whole mapping (S1a), which costs the
-//            touch loop 14.6x (341.6 vs 4991.5 MiB/s, gate container, S1b) --
-//            see res_prefetch_hint() for how that is bought back per range.
+//            touch loop ~12x (341.6 vs 4018.2 MiB/s, gate container, S1b) --
+//            see res_prefetch_hint()/res_rearm_random() for how that is bought
+//            back for the duration of one sweep and then handed straight back.
 //   PAGE     runtime sysconf(_SC_PAGESIZE) always (4 KiB in the gate container,
 //            16 KiB on the Apple Silicon host).
 //
@@ -106,6 +107,13 @@ struct res_op {
 };
 
 struct llama_residency {
+    // NOTE: params.prefetch_layers is the window the CALLER ASKED FOR. The solver
+    // may reduce it on a tight budget, and every runtime consumer of the window
+    // must read info.window (the CHOSEN one) instead -- running the ring at the
+    // requested W while the ledger budgeted for a smaller one keeps a whole extra
+    // b_layer_max resident, and inflates the selftest's own bound in lockstep so
+    // the assert cannot catch it. res_solve() is the only reader of
+    // params.prefetch_layers.
     llama_residency_params params = {};
 
     const llama_model * model    = nullptr;
@@ -650,14 +658,16 @@ static bool res_solve(llama_residency * r) {
 
 // Hints issued just ahead of the touch loop; neither one moves a page on its own.
 //
-//  - POSIX_MADV_NORMAL undoes, for this unit's ranges only, the whole-mapping
-//    POSIX_MADV_RANDOM the streaming load sets (S1a). RANDOM is right for the
-//    mapping as a whole -- nothing may read ahead into a range the manager did
-//    not ask for -- but it also suppresses readahead and fault-around *inside*
-//    the range being prefetched, which turns a whole-unit sweep into one
-//    synchronous single-page fault per page. Measured on the gate VM: 341.6
-//    MiB/s with RANDOM left in place. The overshoot this re-admits is one
-//    readahead window past each range end, which the ring's slack absorbs.
+//  - POSIX_MADV_NORMAL undoes, for this unit's ranges only and only for the
+//    duration of the sweep, the whole-mapping POSIX_MADV_RANDOM the streaming
+//    load sets (S1a). RANDOM is right for the mapping as a whole -- nothing may
+//    read ahead into a range the manager did not ask for -- but it also
+//    suppresses readahead and fault-around *inside* the range being prefetched,
+//    which turns a whole-unit sweep into one synchronous single-page fault per
+//    page. Measured on the gate VM: 341.6 MiB/s with RANDOM left in place. The
+//    overshoot this re-admits is one readahead window past each range end, which
+//    the ring's slack absorbs. res_rearm_random() puts RANDOM back the moment
+//    the sweep is done -- see the note there for why leaving it off is wrong.
 //  - MADV_WILLNEED is capped per call (A3 steps 4 and 4b: ~16 MiB/s chunked),
 //    so it is a queue-it-early hint, never the mechanism.
 static void res_prefetch_hint(llama_residency * r, const res_unit & u) {
@@ -681,6 +691,25 @@ static void res_prefetch_hint(llama_residency * r, const res_unit & u) {
     }
 }
 
+// Put POSIX_MADV_RANDOM back over the ranges res_prefetch_hint() lifted it from.
+// This runs AFTER the touch loop, so it costs nothing that was just paid for:
+// the pages are already resident and madvise only governs FUTURE faults. Leaving
+// NORMAL in place would be wrong in two ways -- after one ring cycle every
+// streamed range would be NORMAL for good, so the compute path's own demand
+// faults (S2/B3) would read ahead into pages this manager had just evicted, and
+// the mapping-wide RANDOM policy S1a installed would quietly cease to exist.
+static void res_rearm_random(llama_residency * r, const res_unit & u) {
+    const size_t end = res_align_up(r->map_size, r->page);
+
+    for (const auto & rg : u.ranges) {
+        const size_t first = res_align_down(rg.first, r->page);
+        const size_t last  = std::min(res_align_up(rg.last, r->page), end);
+        if (last > first) {
+            (void) posix_madvise(r->base + first, last - first, POSIX_MADV_RANDOM);
+        }
+    }
+}
+
 // THE prefetch mechanism: one volatile byte per page, outward aligned.
 static void res_touch(llama_residency * r, const res_unit & u) {
     const volatile uint8_t * p = (const volatile uint8_t *) r->base;
@@ -753,14 +782,22 @@ static void res_exec(llama_residency * r, const res_op & op) {
     res_unit & u = r->units[op.unit];
 
     switch (op.kind) {
+        // Both loading verbs settle their state with the same CAS. An
+        // unconditional store would be a latent accounting bug: suspend()
+        // enqueues an EVICT for pinned units too and marks them EVICTED at
+        // enqueue time, so a PIN already in flight would land afterwards and
+        // clobber EVICTED back to RESIDENT with nothing to correct it -- exactly
+        // the bookkeeping S3's tier switch has to trust.
         case RES_OP_PIN:
             {
                 res_prefetch_hint(r, u);
                 res_touch(r, u);
+                res_rearm_random(r, u);
                 if (r->params.mlock_pins) {
                     res_do_mlock(r, u);
                 }
-                r->states[op.unit].store(RES_RESIDENT);
+                uint8_t expected = RES_QUEUED;
+                r->states[op.unit].compare_exchange_strong(expected, (uint8_t) RES_RESIDENT);
                 if (r->params.verbose) {
                     LLAMA_LOG_INFO("residency: pin      %-8s %.1f MiB\n", u.name.c_str(), res_mib(u.bytes));
                 }
@@ -770,6 +807,7 @@ static void res_exec(llama_residency * r, const res_op & op) {
             {
                 res_prefetch_hint(r, u);
                 res_touch(r, u);
+                res_rearm_random(r, u);
                 // an evict queued behind this prefetch already moved the unit to
                 // EVICTED; it runs next, so let it win.
                 uint8_t expected = RES_QUEUED;
@@ -904,7 +942,7 @@ struct llama_residency * llama_residency_init(
                 res_enqueue(r, RES_OP_PIN, (int) u);
             }
         }
-        const size_t n = std::min<size_t>(r->params.prefetch_layers, r->ring.size());
+        const size_t n = std::min<size_t>(r->info.window, r->ring.size());
         for (size_t k = 0; k < n; k++) {
             res_enqueue(r, RES_OP_PREFETCH, r->ring[k]);
         }
@@ -989,7 +1027,7 @@ void llama_residency_resume_async(struct llama_residency * res) {
                 res_enqueue(res, RES_OP_PIN, (int) u);
             }
         }
-        const size_t n = std::min<size_t>(res->params.prefetch_layers, res->ring.size());
+        const size_t n = std::min<size_t>(res->info.window, res->ring.size());
         for (size_t k = 0; k < n; k++) {
             if (res->states[res->ring[k]].load() == RES_EVICTED) {
                 res_enqueue(res, RES_OP_PREFETCH, res->ring[k]);
@@ -1038,7 +1076,7 @@ void llama_residency_on_gate_post(struct llama_residency * res, int unit) {
 
     const int  n            = (int) res->ring.size();
     const int  pos          = res->cursor_pos[unit];
-    const int  W            = (int) std::min<size_t>(res->params.prefetch_layers, (size_t) (n - 1));
+    const int  W            = (int) std::min<size_t>(res->info.window, (size_t) (n - 1));
     // a unit that is itself in the ring has just executed and is already
     // resident; one that is not (a pinned layer, misc) leaves the window's first
     // unit still to be loaded.
@@ -1270,11 +1308,22 @@ bool llama_residency_selftest(struct llama_residency * res) {
                 total    += tu;
             }
         }
-        const double pct = total ? 100.0 * (double) resident / (double) total : 0.0;
-        LLAMA_LOG_INFO("residency selftest: pins resident %.2f%% (%.1f / %.1f MiB)\n",
-                pct, res_mib(resident), res_mib(total));
-        snprintf(msg, sizeof(msg), "pins resident %.2f%%, want >= 99.00%%", pct);
-        report(pct >= 99.0, true, msg);
+        if (total == 0) {
+            // On a budget so tight that only the misc unit is pinned, the whole
+            // pinned set can be smaller than one page -- inward alignment then
+            // leaves nothing mincore can be asked about, and 0 resident of 0 is
+            // not a failure, it is an unmeasurable quantity. (4B + 16 KiB pages:
+            // misc is 10,240 B and vanishes; at 4 KiB it keeps 2 pages.)
+            LLAMA_LOG_INFO("residency selftest: pins resident not measurable -- %.3f MiB pinned, "
+                    "no whole page survives inward alignment at %zu B\n",
+                    res_mib(r->info.pinned_bytes), r->page);
+        } else {
+            const double pins_pct = 100.0 * (double) resident / (double) total;
+            LLAMA_LOG_INFO("residency selftest: pins resident %.2f%% (%.1f / %.1f MiB)\n",
+                    pins_pct, res_mib(resident), res_mib(total));
+            snprintf(msg, sizeof(msg), "pins resident %.2f%%, want >= 99.00%%", pins_pct);
+            report(pins_pct >= 99.0, true, msg);
+        }
     }
 
     // ---- 4. touch -> evict -------------------------------------------------
@@ -1330,7 +1379,7 @@ bool llama_residency_selftest(struct llama_residency * res) {
     // ---- 6. simulated ring walk, 2 full cycles -----------------------------
 
     const int    n     = (int) r->ring.size();
-    const int    W     = (int) std::min<size_t>(r->params.prefetch_layers, (size_t) (n - 1));
+    const int    W     = (int) std::min<size_t>(r->info.window, (size_t) (n - 1));
     const size_t limit = (size_t) (W + 2) * (size_t) r->info.b_layer_max +
                          (r->info.head_pinned ? 0 : (size_t) r->info.head_bytes);
     // inward-aligned eviction leaves up to one partial page at each end of every
