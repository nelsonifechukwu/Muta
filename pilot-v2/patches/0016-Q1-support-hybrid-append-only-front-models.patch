From 01f58cd1f0d340e85a73cd4b1a349ab6eafe0362 Mon Sep 17 00:00:00 2001
From: iitimii <timiiowolabi@gmail.com>
Date: Sun, 9 Aug 2026 12:20:01 +0100
Subject: [PATCH 16/16] Q1: support hybrid (append-only) front models

Auto-detect recurrent/hybrid models and give any append-only author a
checkpoint sequence; verify drafts become provisional (checkpoint save,
draft, restore) since a hybrid front cannot rewind; routing decodes on a
checkpoint with a closed think block for thinking-family fronts; conf
monitor disabled for append-only authors (its truncation is illegal);
narrow the forced front resync to word-word/punct-punct correction joins.

Assisted-by: Claude Fable 5
---
 tools/duo/duo.cpp | 103 ++++++++++++++++++++++++++++++++++------------
 1 file changed, 77 insertions(+), 26 deletions(-)

diff --git a/tools/duo/duo.cpp b/tools/duo/duo.cpp
index 371965e..0e7fdbd 100644
--- a/tools/duo/duo.cpp
+++ b/tools/duo/duo.cpp
@@ -286,6 +286,13 @@ static bool load_duo_model(duo_model & m, const duo_params & p, const std::strin
     }
     m.vocab = llama_model_get_vocab(m.model.get());
 
+    // recurrent/hybrid state cannot partially rewind: such models are append-only and
+    // always get a checkpoint sequence so drafts and routing can be provisional
+    if (llama_model_is_recurrent(m.model.get()) || llama_model_is_hybrid(m.model.get())) {
+        m.append_only = true;
+        checkpoint_seq = true;
+    }
+
     llama_context_params cparams = llama_context_default_params();
     cparams.n_ctx           = n_ctx;
     cparams.n_threads       = p.n_threads;
@@ -435,6 +442,7 @@ struct gen_opts {
     float conf_threshold;
     bool  eos_ends_turn;    // false: EOS is treated as a handoff (front under --closer expert)
     bool  random_cut = false; // cut at ANY word boundary past seg_min (may be mid-sentence)
+    bool  provisional = false; // do not commit or rewind; the caller manages memory state (checkpointed drafts)
 };
 
 // segment ends immediately before whitespace: cut happens when the peeked token
@@ -496,7 +504,7 @@ static seg_stats gen_segment(duo_model & m, const gen_opts & opts) {
                 st.cut = "cap";
                 break;
             }
-            if (opts.conf_monitor && (int) lp_window.size() >= opts.conf_window) {
+            if (opts.conf_monitor && !m.append_only && (int) lp_window.size() >= opts.conf_window) {
                 double mean = 0.0;
                 for (double v : lp_window) mean += v;
                 mean /= (double) lp_window.size();
@@ -545,18 +553,34 @@ static seg_stats gen_segment(duo_model & m, const gen_opts & opts) {
     st.mean_lp  = buf_toks.empty() ? 0.0 : lp_sum_all / (double) buf_toks.size();
     st.t_us     = ggml_time_us() - t0;
 
-    if (m.append_only) {
-        // expert: sampled tokens stay; committed state extends by the emitted text
+    if (opts.provisional) {
+        // caller restores the memory via its checkpoint; nothing is committed here
+    } else if (m.append_only) {
+        // append-only author: sampled tokens stay; committed state extends by the emitted text
         m.committed_text += st.text;
         m.committed_tokens.insert(m.committed_tokens.end(), buf_toks.begin(), buf_toks.end());
-        // conf cuts never apply to the expert (buf never truncated), so text == decoded pieces
+        // conf cuts never truncate append-only buffers, so text == decoded pieces
     } else {
-        // front: rewind the whole segment; committed text is re-ingested canonically later
+        // dense author: rewind the whole segment; committed text is re-ingested canonically later
         llama_memory_seq_rm(llama_get_memory(m.ctx.get()), 0, n_past0, -1);
     }
     return st;
 }
 
+// checkpoint helpers: seq 1 snapshots seq 0 (copy-on-write for recurrent state)
+static void checkpoint_save(duo_model & m) {
+    llama_memory_seq_cp(llama_get_memory(m.ctx.get()), 0, 1, -1, -1);
+}
+static void checkpoint_restore(duo_model & m) {
+    llama_memory_t mem = llama_get_memory(m.ctx.get());
+    llama_memory_seq_rm(mem, 0, -1, -1);
+    llama_memory_seq_cp(mem, 1, 0, -1, -1);
+    llama_memory_seq_rm(mem, 1, -1, -1);
+}
+static void checkpoint_drop(duo_model & m) {
+    llama_memory_seq_rm(llama_get_memory(m.ctx.get()), 1, -1, -1);
+}
+
 // ---------- routing ----------
 
 // verdict token ids in the front vocab, resolved at startup from "A"/"B"
@@ -564,25 +588,38 @@ static llama_token g_id_easy = -1;
 static llama_token g_id_hard = -1;
 
 static float route_score(duo_model & front, const std::string & user) {
+    // a thinking-family front gets a closed think block so the verdict letter is the natural next token
+    const std::string think = front.append_only ? "<think>\n\n</think>\n\n" : "";
     const std::string prompt =
         "<|im_start|>system\n"
         "You classify questions by difficulty. Reply with exactly one letter.\n"
         "A = simple: greeting, chit-chat, a single fact, a one-line definition.\n"
         "B = hard: math with steps, physics/chemistry problems, essays, code, anything multi-step.\n"
         "<|im_end|>\n"
-        "<|im_start|>user\nQ: \"Hello, how are you?\" ->\n<|im_end|>\n<|im_start|>assistant\nA<|im_end|>\n"
-        "<|im_start|>user\nQ: \"Solve 3x + 5 = 20 and explain each step.\" ->\n<|im_end|>\n<|im_start|>assistant\nB<|im_end|>\n"
-        "<|im_start|>user\nQ: \"" + user + "\" ->\n<|im_end|>\n<|im_start|>assistant\n";
+        "<|im_start|>user\nQ: \"Hello, how are you?\" ->\n<|im_end|>\n<|im_start|>assistant\n" + think + "A<|im_end|>\n"
+        "<|im_start|>user\nQ: \"Solve 3x + 5 = 20 and explain each step.\" ->\n<|im_end|>\n<|im_start|>assistant\n" + think + "B<|im_end|>\n"
+        "<|im_start|>user\nQ: \"" + user + "\" ->\n<|im_end|>\n<|im_start|>assistant\n" + think;
 
     const int n_past0 = front.n_past();
+    const bool ckpt = front.append_only;
+    if (ckpt) {
+        checkpoint_save(front);
+    }
     std::vector<llama_token> toks = common_tokenize(front.vocab, prompt, false, true);
     if (!decode_tokens(front, toks)) {
+        if (ckpt) {
+            checkpoint_restore(front);
+        }
         return 0.0f;
     }
     const float * z = llama_get_logits_ith(front.ctx.get(), -1);
     const float s = z[g_id_hard] - z[g_id_easy];
 
-    llama_memory_seq_rm(llama_get_memory(front.ctx.get()), 0, n_past0, -1);
+    if (ckpt) {
+        checkpoint_restore(front);
+    } else {
+        llama_memory_seq_rm(llama_get_memory(front.ctx.get()), 0, n_past0, -1);
+    }
     return s;
 }
 
@@ -626,7 +663,7 @@ static std::string run_router_turn(duo_state & s, const std::string & user) {
 
     if (!hard) {
         // easy path: front answers with the confidence monitor armed
-        if (!sync_to(s.front, render_prompt(s.front, s.sys_front, s.history, user, true), true)) {
+        if (!sync_to(s.front, render_prompt(s.front, s.sys_front, s.history, user, false), true)) {
             return transcript;
         }
         gen_opts opts = { /*seg_min*/ 0, /*seg_max*/ 0, p.n_predict, /*conf*/ true, p.conf_window, p.conf_threshold, /*eos_ends*/ true };
@@ -693,7 +730,7 @@ static std::string run_codraft_turn(duo_state & s, const std::string & user) {
     const duo_params & p = s.p;
     const int64_t t0 = ggml_time_us();
 
-    const std::string front_prompt  = render_prompt(s.front,  s.sys_front,  s.history, user, true);
+    const std::string front_prompt  = render_prompt(s.front,  s.sys_front,  s.history, user, false);
     const std::string expert_prompt = render_prompt(s.expert, s.sys_expert, s.history, user, false);
 
     const bool random_mode = p.mode == "random";
@@ -803,7 +840,6 @@ static std::string run_verify_turn(duo_state & s, const std::string & user) {
     const int64_t t0 = ggml_time_us();
     duo_model & fr = s.front;
     duo_model & ex = s.expert;
-    llama_memory_t mem = llama_get_memory(ex.ctx.get());
     const int n_vocab = llama_vocab_n_tokens(ex.vocab);
     const bool greedy = p.verify_rule == "greedy";
 
@@ -811,7 +847,7 @@ static std::string run_verify_turn(duo_state & s, const std::string & user) {
     // rejection would wipe the expert state
     GGML_ASSERT(llama_n_seq_max(ex.ctx.get()) >= 2 && "verify mode needs the expert context loaded with checkpoint_seq");
 
-    const std::string front_prompt  = render_prompt(fr, s.sys_front,  s.history, user, true);
+    const std::string front_prompt  = render_prompt(fr, s.sys_front,  s.history, user, false);
     const std::string expert_prompt = render_prompt(ex, s.sys_expert, s.history, user, false);
 
     if (!sync_to(ex, expert_prompt, true)) {
@@ -837,7 +873,14 @@ static std::string run_verify_turn(duo_state & s, const std::string & user) {
         dopts.n_predict = p.n_predict - n_total;
         dopts.conf_window = p.conf_window; dopts.conf_threshold = p.conf_threshold;
         dopts.eos_ends_turn = !p.closer_expert;
-        seg_stats dst = gen_segment(fr, dopts);   // rewinds the front KV itself
+        dopts.provisional = fr.append_only;
+        if (fr.append_only) {
+            checkpoint_save(fr);
+        }
+        seg_stats dst = gen_segment(fr, dopts);   // dense fronts rewind their own KV
+        if (fr.append_only) {
+            checkpoint_restore(fr);
+        }
         const bool front_eos = dst.cut == "eos";
 
         int accepted = 0, m = 0;
@@ -846,7 +889,7 @@ static std::string run_verify_turn(duo_state & s, const std::string & user) {
             m = (int) d.size();
             n_drafted += m;
 
-            llama_memory_seq_cp(mem, 0, 1, -1, -1);
+            checkpoint_save(ex);
 
             llama_batch b = llama_batch_init(m, 0, 1);
             b.n_tokens = m;
@@ -888,7 +931,7 @@ static std::string run_verify_turn(duo_state & s, const std::string & user) {
 
             if (accepted == m) {
                 // full accept: state is already advanced; drop the checkpoint
-                llama_memory_seq_rm(mem, 1, -1, -1);
+                checkpoint_drop(ex);
                 prev_row.assign(llama_get_logits_ith(ex.ctx.get(), m - 1),
                                 llama_get_logits_ith(ex.ctx.get(), m - 1) + n_vocab);
                 ex.committed_tokens.insert(ex.committed_tokens.end(), d.begin(), d.end());
@@ -918,9 +961,7 @@ static std::string run_verify_turn(duo_state & s, const std::string & user) {
                 const bool c_ends = llama_vocab_is_eog(ex.vocab, c) || c_piece.empty();
 
                 // rollback to the checkpoint, then re-decode accepted prefix (+ correction) in one batch
-                llama_memory_seq_rm(mem, 0, -1, -1);
-                llama_memory_seq_cp(mem, 1, 0, -1, -1);
-                llama_memory_seq_rm(mem, 1, -1, -1);
+                checkpoint_restore(ex);
 
                 std::string acc_text;
                 for (int i = 0; i < accepted; i++) {
@@ -974,13 +1015,23 @@ static std::string run_verify_turn(duo_state & s, const std::string & user) {
                     continue;
                 }
 
-                // a non-whitespace-led correction can create a seam the front's incremental
-                // tokenizer would encode non-canonically; force it to re-ingest from scratch
-                if (!c_text.empty() && strchr(" \n\t", c_text[0]) == nullptr) {
-                    llama_memory_seq_rm(llama_get_memory(fr.ctx.get()), 0, 0, -1);
-                    fr.committed_text.clear();
-                    fr.committed_tokens.clear();
-                    fr.n_full_resync++;
+                // a correction gluing word-to-word or punct-to-punct can create a seam the
+                // front's incremental tokenizer would encode non-canonically (BPE can merge
+                // across it); force a re-ingest from scratch for exactly those joins
+                {
+                    const std::string & pre = !acc_text.empty() ? acc_text : transcript;
+                    if (!c_text.empty() && !pre.empty()) {
+                        const unsigned char a = (unsigned char) pre.back();
+                        const unsigned char b = (unsigned char) c_text[0];
+                        const bool word_join  = (isalnum(a) || a == '_' || a >= 0x80) && (isalnum(b) || b == '_' || b >= 0x80);
+                        const bool punct_join = ispunct(a) && ispunct(b);
+                        if (word_join || punct_join) {
+                            llama_memory_seq_rm(llama_get_memory(fr.ctx.get()), 0, 0, -1);
+                            fr.committed_text.clear();
+                            fr.committed_tokens.clear();
+                            fr.n_full_resync++;
+                        }
+                    }
                 }
 
                 // expert repair span, then hand the pen back to the front;
