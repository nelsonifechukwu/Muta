 // ---------- model plumbing ----------
 
+// bundle-manifest auto-discovery: reads bundle.count/bundle.{i}.prefix/bundle.{i}.role
+// with no_alloc=true, so tensor data is never touched -- metadata-only, milliseconds
+// regardless of bundle size. Returns false if the file has no manifest (not a bundle,
+// or an older file predating this scheme); callers fall back to the legacy front/expert
+// pair in that case.
+static bool discover_bundle_tiers(const std::string & bundle_path, std::vector<std::pair<tier_role, std::string>> & out) {
+    struct gguf_init_params params = {
+        /*.no_alloc =*/ true,
+        /*.ctx      =*/ NULL,
+    };
+    struct gguf_context * ctx = gguf_init_from_file(bundle_path.c_str(), params);
+    if (!ctx) {
+        return false;
+    }
+
+    const int64_t count_key = gguf_find_key(ctx, "bundle.count");
+    if (count_key < 0 || gguf_get_kv_type(ctx, count_key) != GGUF_TYPE_UINT32) {
+        gguf_free(ctx);
+        return false;
+    }
+    const uint32_t count = gguf_get_val_u32(ctx, count_key);
+
+    for (uint32_t i = 0; i < count; i++) {
+        const std::string prefix_key = "bundle." + std::to_string(i) + ".prefix";
+        const std::string role_key   = "bundle." + std::to_string(i) + ".role";
+        const int64_t pk = gguf_find_key(ctx, prefix_key.c_str());
+        const int64_t rk = gguf_find_key(ctx, role_key.c_str());
+        if (pk < 0 || rk < 0 || gguf_get_kv_type(ctx, pk) != GGUF_TYPE_STRING || gguf_get_kv_type(ctx, rk) != GGUF_TYPE_STRING) {
+            continue; // malformed manifest entry; skip rather than abort discovery
+        }
+        tier_role role;
+        if (!tier_role_from_str(gguf_get_val_str(ctx, rk), role)) {
+            continue; // unknown role string; skip
+        }
+        out.push_back({ role, gguf_get_val_str(ctx, pk) });
+    }
+
+    gguf_free(ctx);
+    return true;
+}
