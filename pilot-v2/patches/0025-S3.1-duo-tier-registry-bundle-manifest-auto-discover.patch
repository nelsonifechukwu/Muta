+// ---------- tier registry ----------
+//
+// A tier is one model slot in the bundle: which name it answers to (role), which
+// prefix/file it loads from, and how its weights should be kept in RAM (policy).
+// The registry replaces the old hardcoded front/expert pair so a bundle can carry
+// more than two models (S3 streaming tiers); this task only builds the registry and
+// keeps front+mid loading exactly as before -- policy is stored, not acted on, and
+// easy is registered but not loaded (S3.3 adds that).
+
+enum tier_role {
+    TIER_FRONT = 0,
+    TIER_EASY,
+    TIER_MID,
+    TIER_TOP,   // registry slot only; no bundle ships this tier yet
+};
+
+enum tier_policy {
+    POL_MLOCK = 0,
+    POL_RESIDENT,
+    POL_STREAMED,
+    POL_AUTO,
+};
+
+enum tier_state {
+    TS_UNLOADED = 0,
+    TS_LOADING,
+    TS_READY,
+};
+
+static const char * tier_role_name(tier_role role) {
+    switch (role) {
+        case TIER_FRONT: return "front";
+        case TIER_EASY:  return "easy";
+        case TIER_MID:   return "mid";
+        case TIER_TOP:   return "top";
+    }
+    return "?";
+}
+
+static bool tier_role_from_str(const std::string & s, tier_role & out) {
+    if (s == "front")  { out = TIER_FRONT; return true; }
+    if (s == "easy")   { out = TIER_EASY;  return true; }
+    if (s == "mid")    { out = TIER_MID;   return true; }
+    if (s == "top")    { out = TIER_TOP;   return true; }
+    if (s == "expert") { out = TIER_MID;   return true; } // legacy bundle-manifest role name
+    return false;
+}
+
+static bool tier_policy_from_str(const std::string & s, tier_policy & out) {
+    if (s == "mlock")    { out = POL_MLOCK;    return true; }
+    if (s == "resident") { out = POL_RESIDENT; return true; }
+    if (s == "streamed") { out = POL_STREAMED; return true; }
+    if (s == "auto")     { out = POL_AUTO;     return true; }
+    return false;
+}
+
+// role default residency policy; C4 wires these into actual mlock/streaming calls,
+// no residency/load_mode side effects happen from this yet
+static tier_policy tier_policy_default(tier_role role) {
+    switch (role) {
+        case TIER_FRONT: return POL_MLOCK;
+        case TIER_EASY:  return POL_RESIDENT;
+        case TIER_MID:
+        case TIER_TOP:
+        default:         return POL_STREAMED;
+    }
+}
+
+struct duo_tier {
+    tier_role   role  = TIER_FRONT;
+    std::string prefix;
+    std::string file;              // source gguf; defaults to p.bundle
+    tier_policy policy = POL_AUTO;
+    int32_t     n_ctx  = -1;       // -1 = role default (front 4096, easy/mid 8192)
+    float       temp   = 0.0f;
+    float       top_p  = 0.0f;
+    duo_model   m;
+    std::atomic<tier_state> state { TS_UNLOADED };
+    void *      residency = nullptr; // residency handle slot for C4
+
+    duo_tier() = default;
+
+    // std::atomic has no move constructor, so std::vector<duo_tier> needs one written
+    // by hand; state is loaded/stored rather than moved (harmless, this task never
+    // moves a tier concurrently with another thread touching its state)
+    duo_tier(duo_tier && other) noexcept
+        : role(other.role), prefix(std::move(other.prefix)), file(std::move(other.file)),
+          policy(other.policy), n_ctx(other.n_ctx), temp(other.temp), top_p(other.top_p),
+          m(std::move(other.m)), state(other.state.load()), residency(other.residency) {}
+
+    duo_tier & operator=(duo_tier && other) noexcept {
+        role = other.role; prefix = std::move(other.prefix); file = std::move(other.file);
+        policy = other.policy; n_ctx = other.n_ctx; temp = other.temp; top_p = other.top_p;
+        m = std::move(other.m); state.store(other.state.load()); residency = other.residency;
+        return *this;
+    }
+
+    duo_tier(const duo_tier &) = delete;
+    duo_tier & operator=(const duo_tier &) = delete;
+};
+
+// n_ctx == -1 resolves to the role default; front/mid stay wired to the legacy
+// --ctx-front/--ctx-expert flags so those keep working unchanged
+static int32_t tier_ctx_resolved(const duo_tier & t, const duo_params & p) {
+    if (t.n_ctx > 0) {
+        return t.n_ctx;
+    }
+    switch (t.role) {
+        case TIER_FRONT: return p.ctx_front;
+        case TIER_MID:   return p.ctx_expert;
+        default:         return 8192; // easy/top role default
+    }
+}
