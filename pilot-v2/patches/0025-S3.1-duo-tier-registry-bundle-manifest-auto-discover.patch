+// splits "NAME=VALUE" for --tier/--tier-file/--tier-ctx/--tier-policy
+static void parse_tier_kv(const char * flag, const std::string & raw, std::string & name, std::string & value) {
+    const size_t eq = raw.find('=');
+    if (eq == std::string::npos || eq == 0) {
+        fprintf(stderr, "error: %s expects NAME=VALUE (got '%s')\n", flag, raw.c_str());
+        exit(1);
+    }
+    name  = raw.substr(0, eq);
+    value = raw.substr(eq + 1);
+}
