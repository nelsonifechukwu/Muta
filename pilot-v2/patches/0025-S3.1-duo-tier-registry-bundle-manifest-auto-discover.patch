+// registry population: bundle-manifest auto-discovery first (see discover_bundle_tiers),
+// then explicit --tier*/--front-prefix/--expert-prefix overrides layer on top, matching
+// by role name (legacy "expert" maps to mid) and adding a role if the manifest didn't
+// carry it (this is how a future top tier gets registered as pure data, zero code change).
+static bool build_tier_registry(duo_state & s) {
+    const duo_params & p = s.p;
+
+    std::map<tier_role, std::string> prefix_ovr;
+    for (const auto & kv : p.tier_prefix_ovr) {
+        tier_role r;
+        if (!tier_role_from_str(kv.first, r)) {
+            fprintf(stderr, "error: --tier/--front-prefix/--expert-prefix: unknown tier name '%s'\n", kv.first.c_str());
+            return false;
+        }
+        prefix_ovr[r] = kv.second;
+    }
+    std::map<tier_role, std::string> file_ovr;
+    for (const auto & kv : p.tier_file_ovr) {
+        tier_role r;
+        if (!tier_role_from_str(kv.first, r)) {
+            fprintf(stderr, "error: --tier-file: unknown tier name '%s'\n", kv.first.c_str());
+            return false;
+        }
+        file_ovr[r] = kv.second;
+    }
+    std::map<tier_role, int32_t> ctx_ovr;
+    for (const auto & kv : p.tier_ctx_ovr) {
+        tier_role r;
+        if (!tier_role_from_str(kv.first, r)) {
+            fprintf(stderr, "error: --tier-ctx: unknown tier name '%s'\n", kv.first.c_str());
+            return false;
+        }
+        ctx_ovr[r] = kv.second;
+    }
+    std::map<tier_role, tier_policy> policy_ovr;
+    for (const auto & kv : p.tier_policy_ovr) {
+        tier_role r;
+        if (!tier_role_from_str(kv.first, r)) {
+            fprintf(stderr, "error: --tier-policy: unknown tier name '%s'\n", kv.first.c_str());
+            return false;
+        }
+        tier_policy pol;
+        if (!tier_policy_from_str(kv.second, pol)) {
+            fprintf(stderr, "error: --tier-policy %s=%s: unknown policy (want mlock|resident|streamed|auto)\n",
+                    kv.first.c_str(), kv.second.c_str());
+            return false;
+        }
+        policy_ovr[r] = pol;
+    }
+
+    std::vector<std::pair<tier_role, std::string>> discovered;
+    if (!discover_bundle_tiers(p.bundle, discovered)) {
+        // no manifest (older file predating the bundle-manifest scheme): fall back to
+        // the pre-registry front/expert pair so those files keep working unchanged
+        discovered = { { TIER_FRONT, "m0." }, { TIER_MID, "m1." } };
+    }
+
+    std::vector<tier_role> order;
+    std::map<tier_role, std::string> prefix_by_role;
+    for (const auto & d : discovered) {
+        if (prefix_by_role.find(d.first) == prefix_by_role.end()) {
+            order.push_back(d.first);
+        }
+        prefix_by_role[d.first] = d.second;
+    }
+    auto ensure_role = [&](tier_role r) {
+        if (prefix_by_role.find(r) == prefix_by_role.end()) {
+            order.push_back(r);
+            prefix_by_role[r] = "";
+        }
+    };
+    for (const auto & kv : prefix_ovr) { ensure_role(kv.first); }
+    for (const auto & kv : file_ovr)   { ensure_role(kv.first); }
+    for (const auto & kv : ctx_ovr)    { ensure_role(kv.first); }
+    for (const auto & kv : policy_ovr) { ensure_role(kv.first); }
+
+    s.tiers.resize(order.size());
+    for (size_t i = 0; i < order.size(); i++) {
+        duo_tier & t = s.tiers[i];
+        t.role   = order[i];
+        t.prefix = prefix_by_role[t.role];
+        t.file   = p.bundle;
+        t.policy = tier_policy_default(t.role);
+        t.n_ctx  = -1;
+
+        auto pit = prefix_ovr.find(t.role);
+        if (pit != prefix_ovr.end()) { t.prefix = pit->second; }
+        auto fit = file_ovr.find(t.role);
+        if (fit != file_ovr.end()) { t.file = fit->second; }
+        auto cit = ctx_ovr.find(t.role);
+        if (cit != ctx_ovr.end()) { t.n_ctx = cit->second; }
+        auto plit = policy_ovr.find(t.role);
+        if (plit != policy_ovr.end()) { t.policy = plit->second; }
+
+        // role sampling defaults: front keeps the --temp-front/--top-p-front flags,
+        // every other role keeps the --temp-expert/--top-p-expert flags (easy/top have
+        // no dedicated flags yet; this task never samples from them either way)
+        switch (t.role) {
+            case TIER_FRONT: t.temp = p.temp_front;  t.top_p = p.top_p_front;  break;
+            case TIER_MID:   t.temp = p.temp_expert; t.top_p = p.top_p_expert; break;
+            default:         t.temp = p.temp_expert; t.top_p = p.top_p_expert; break;
+        }
+    }
+
+    for (auto & t : s.tiers) {
+        switch (t.role) {
+            case TIER_FRONT: s.front = &t; break;
+            case TIER_EASY:  s.easy  = &t; break;
+            case TIER_MID:   s.mid   = &t; break;
+            default: break;
+        }
+    }
+    return true;
+}
