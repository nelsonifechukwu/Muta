From 83152f96656a7defbfa5fa958e43d1a8038365b1 Mon Sep 17 00:00:00 2001
From: iitimii <timiiowolabi@gmail.com>
Date: Sun, 9 Aug 2026 09:35:47 +0100
Subject: [PATCH 12/16] T-random: add random co-decode mode with author
 probabilities

Segments cut at any word boundary (may be mid-sentence) after a random
length drawn from [seg-min, seg-max]; the next author is drawn with
P(front) = --p-front, P(expert) = 1 - p (validated to sum to 1).
Whitespace seams keep tokenization exact; expert stays append-only.

Assisted-by: Claude Fable 5
---
 tools/duo/duo.cpp | 73 ++++++++++++++++++++++++++++++++++++++---------
 1 file changed, 60 insertions(+), 13 deletions(-)

diff --git a/tools/duo/duo.cpp b/tools/duo/duo.cpp
index e71c078..58d69f0 100644
--- a/tools/duo/duo.cpp
+++ b/tools/duo/duo.cpp
@@ -29,6 +29,7 @@
 #include <deque>
 #include <fstream>
 #include <iostream>
+#include <random>
 #include <string>
 #include <unistd.h>
 #include <vector>
@@ -58,6 +59,8 @@ struct duo_params {
     float top_p_expert = 0.95f;
     float route_threshold = 0.0f;
     float conf_threshold  = -2.5f;
+    float p_front  = 0.5f;   // random mode: P(next segment is front's)
+    float p_expert = -1.0f;  // derived as 1 - p_front unless given
 
     uint32_t seed = 42;
 
@@ -165,7 +168,7 @@ static void print_usage() {
            "  --bundle PATH           bundle gguf [bundle/muta-duo.gguf]\n"
            "  --front-prefix STR      [m0.]\n"
            "  --expert-prefix STR     [m1.]\n"
-           "  --mode router|codraft   [router]\n"
+           "  --mode router|codraft|random   [router]\n"
            "  -p, --prompt STR        user message (one turn)\n"
            "  --prompts-file PATH     one user message per line (multi-turn)\n"
            "  --ctx-front N           [4096]\n"
@@ -177,6 +180,7 @@ static void print_usage() {
            "  --conf-window N [16]  --conf-threshold F [-2.5]\n"
            "  --seg-min N [24]  --seg-max N [96]\n"
            "  --seg-min-expert N --seg-max-expert N   expert-only segment budgets [same]\n"
+           "  --p-front F [0.5] --p-expert F [1-p_front]   random mode author probabilities (sum to 1)\n"
            "  --route-only            print route scores only, do not answer\n"
            "  -q, --quiet             suppress library logs (traces stay)\n"
            "  --stream / --no-stream  live token output with per-model colors [auto: on in chat]\n"
@@ -221,6 +225,8 @@ static bool parse_args(int argc, char ** argv, duo_params & p) {
         else if (arg == "--seg-max")         { p.seg_max = atoi(need("--seg-max")); }
         else if (arg == "--seg-min-expert")  { p.seg_min_expert = atoi(need("--seg-min-expert")); }
         else if (arg == "--seg-max-expert")  { p.seg_max_expert = atoi(need("--seg-max-expert")); }
+        else if (arg == "--p-front")         { p.p_front = atof(need("--p-front")); }
+        else if (arg == "--p-expert")        { p.p_expert = atof(need("--p-expert")); }
         else if (arg == "--route-only")      { p.route_only = true; }
         else if (arg == "-q" || arg == "--quiet") { p.quiet = true; }
         else if (arg == "--stream")          { p.stream = 1; }
@@ -396,6 +402,7 @@ struct gen_opts {
     int   conf_window;
     float conf_threshold;
     bool  eos_ends_turn;    // false: EOS is treated as a handoff (front under --closer expert)
+    bool  random_cut = false; // cut at ANY word boundary past seg_min (may be mid-sentence)
 };
 
 // segment ends immediately before whitespace: cut happens when the peeked token
@@ -434,7 +441,12 @@ static seg_stats gen_segment(duo_model & m, const gen_opts & opts) {
         const bool ws_start = !piece.empty() && (piece[0] == ' ' || piece[0] == '\n' || piece[0] == '\t');
 
         // peek cut: commit buf without decoding this token
-        if (opts.seg_min > 0 && ws_start && !buf.empty()) {
+        if (opts.random_cut && opts.seg_min > 0 && ws_start && !buf.empty()) {
+            if ((int) buf_toks.size() >= opts.seg_min) {
+                st.cut = "rand";
+                break;
+            }
+        } else if (opts.seg_min > 0 && ws_start && !buf.empty()) {
             const bool boundary = at_boundary(buf);
             if (boundary) {
                 last_boundary = buf.size();
@@ -544,6 +556,7 @@ struct duo_state {
     duo_model expert;
     duo_params p;
     std::vector<chat_turn> history;
+    std::mt19937 rng;
 
     const char * sys_front  = "You are a helpful tutor. Continue the answer naturally and concisely.";
     const char * sys_expert = "You are the senior tutor. Continue the answer; if the draft so far has errors or drifts, correct course and steer it right, then continue.";
@@ -638,8 +651,15 @@ static std::string run_codraft_turn(duo_state & s, const std::string & user) {
     const std::string front_prompt  = render_prompt(s.front,  s.sys_front,  s.history, user, true);
     const std::string expert_prompt = render_prompt(s.expert, s.sys_expert, s.history, user, false);
 
+    const bool random_mode = p.mode == "random";
+    std::uniform_real_distribution<float> coin(0.0f, 1.0f);
+    std::uniform_int_distribution<int>    seg_len(p.seg_min, std::max(p.seg_min, p.seg_max));
+
     std::string transcript;
     duo_model * active = &s.front;
+    if (random_mode) {
+        active = coin(s.rng) < p.p_front ? &s.front : &s.expert;
+    }
     int k = 0;
     int n_total = 0, n_expert = 0;
     bool turn_open = true;
@@ -651,11 +671,20 @@ static std::string run_codraft_turn(duo_state & s, const std::string & user) {
         }
 
         gen_opts opts;
-        const bool exp_seg = active == &s.expert && p.seg_min_expert > 0;
-        opts.seg_min        = exp_seg ? p.seg_min_expert : p.seg_min;
-        opts.seg_max        = exp_seg ? p.seg_max_expert : p.seg_max;
+        if (random_mode) {
+            // random segment length, cut at any word boundary (may be mid-sentence)
+            const int len = seg_len(s.rng);
+            opts.seg_min    = len;
+            opts.seg_max    = len;
+            opts.random_cut = true;
+            opts.conf_monitor = false;
+        } else {
+            const bool exp_seg = active == &s.expert && p.seg_min_expert > 0;
+            opts.seg_min      = exp_seg ? p.seg_min_expert : p.seg_min;
+            opts.seg_max      = exp_seg ? p.seg_max_expert : p.seg_max;
+            opts.conf_monitor = (active == &s.front);
+        }
         opts.n_predict      = p.n_predict - n_total;
-        opts.conf_monitor   = (active == &s.front);
         opts.conf_window    = p.conf_window;
         opts.conf_threshold = p.conf_threshold;
         // under --closer expert a front EOS is a handoff, not an ending
@@ -674,6 +703,8 @@ static std::string run_codraft_turn(duo_state & s, const std::string & user) {
             turn_open = false;
         } else if (st.cut == "eos" && !st.turn_done) {
             active = &s.expert;    // front EOS handoff
+        } else if (random_mode) {
+            active = coin(s.rng) < p.p_front ? &s.front : &s.expert;
         } else {
             active = (active == &s.front) ? &s.expert : &s.front;
         }
@@ -682,13 +713,13 @@ static std::string run_codraft_turn(duo_state & s, const std::string & user) {
     const int64_t t_us = ggml_time_us() - t0;
     const double f = n_total > 0 ? (double) n_expert / n_total : 0.0;
     if (p.trace) {
-        fprintf(stderr, "[turn] mode=codraft segs=%d tokens=%d expert_share=%.2f ms=%.1f tok/s=%.1f ingest_front=%.1fms ingest_expert=%.1fms resync_front=%d resync_expert=%d\n",
-                k, n_total, f, t_us / 1e3, t_us > 0 ? n_total * 1e6 / (double) t_us : 0.0,
+        fprintf(stderr, "[turn] mode=%s segs=%d tokens=%d expert_share=%.2f ms=%.1f tok/s=%.1f ingest_front=%.1fms ingest_expert=%.1fms resync_front=%d resync_expert=%d\n",
+                p.mode.c_str(), k, n_total, f, t_us / 1e3, t_us > 0 ? n_total * 1e6 / (double) t_us : 0.0,
                 s.front.t_ingest_us / 1e3, s.expert.t_ingest_us / 1e3,
                 s.front.n_full_resync, s.expert.n_full_resync);
     }
-    jtrace("{\"type\":\"turn\",\"mode\":\"codraft\",\"segs\":%d,\"tokens\":%d,\"expert_share\":%.3f,\"ms\":%.1f,\"ingest_front_ms\":%.1f,\"ingest_expert_ms\":%.1f}",
-           k, n_total, f, t_us / 1e3, s.front.t_ingest_us / 1e3, s.expert.t_ingest_us / 1e3);
+    jtrace("{\"type\":\"turn\",\"mode\":\"%s\",\"segs\":%d,\"tokens\":%d,\"expert_share\":%.3f,\"ms\":%.1f,\"ingest_front_ms\":%.1f,\"ingest_expert_ms\":%.1f}",
+           p.mode.c_str(), k, n_total, f, t_us / 1e3, s.front.t_ingest_us / 1e3, s.expert.t_ingest_us / 1e3);
     return transcript;
 }
 
@@ -733,8 +764,24 @@ int main(int argc, char ** argv) {
         g_json = fopen(p.json_trace.c_str(), "w");
     }
 
+    if (p.mode != "router" && p.mode != "codraft" && p.mode != "random") {
+        fprintf(stderr, "error: unknown mode '%s' (want router|codraft|random)\n", p.mode.c_str());
+        return 1;
+    }
+    if (p.p_expert >= 0.0f) {
+        if (fabsf(p.p_front + p.p_expert - 1.0f) > 1e-3f) {
+            fprintf(stderr, "error: --p-front (%.3f) + --p-expert (%.3f) must sum to 1\n", p.p_front, p.p_expert);
+            return 1;
+        }
+    }
+    if (p.p_front < 0.0f || p.p_front > 1.0f) {
+        fprintf(stderr, "error: --p-front must be in [0, 1]\n");
+        return 1;
+    }
+
     duo_state s;
     s.p = p;
+    s.rng.seed(p.seed);
     s.expert.append_only = true;
     s.front.color  = "\033[36m";   // cyan
     s.expert.color = "\033[33m";   // yellow
@@ -775,8 +822,8 @@ int main(int argc, char ** argv) {
             fflush(stdout);
             return;
         }
-        std::string answer = p.mode == "codraft" ? run_codraft_turn(s, user)
-                                                 : run_router_turn(s, user);
+        std::string answer = p.mode == "router" ? run_router_turn(s, user)
+                                                : run_codraft_turn(s, user);
         if (g_stream.on) {
             stream_end_turn();  // answer already streamed
         } else {
@@ -784,7 +831,7 @@ int main(int argc, char ** argv) {
             fflush(stdout);
         }
 
-        if (p.selftest_seams && p.mode == "codraft") {
+        if (p.selftest_seams && p.mode != "router") {
             selftest_seams(s);
         }
         s.history.push_back({ user, answer });
