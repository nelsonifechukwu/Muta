     while (true) {
-        const llama_token tok = common_sampler_sample(m.smpl.get(), m.ctx.get(), -1);
+        // token source: amortizer queue (already decoded) > pending correction
+        // (not decoded; seeds the next round) > fresh sample. Queue/pending tokens
+        // are PEEKED here -- they are consumed only after every cut check passes,
+        // so a cut token is never half-taken.
