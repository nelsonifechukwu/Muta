@@ -1200,6 +1304,16 @@ static seg_stats gen_segment(duo_model & m, const gen_opts & opts) {
     st.mean_lp  = buf_toks.empty() ? 0.0 : lp_sum_all / (double) buf_toks.size();
     st.t_us     = ggml_time_us() - t0;
 
