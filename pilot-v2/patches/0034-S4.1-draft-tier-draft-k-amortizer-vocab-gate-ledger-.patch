+// ---------- spec-decode amortizer round state (S4.1) ----------
+//
+// One spec_run lives in duo_state and is re-armed per expert segment. The invariant
+// mirrors examples/speculative-simple exactly: the SEED token (gen_segment's sampled
+// or pending token) is NOT in the target state when a round starts; the round decodes
+// [seed, draft...] as ONE batch on both the target and the draft context (under
+// --stream-weights that is one streamed ring walk per round -- the amortization),
+// verifies with common_sampler_sample_and_accept_n, and on partial acceptance
+// restores the pre-round checkpoint and replays the accepted ids as the next draft
+// (the in-tree trick that avoids partially rewinding a hybrid context). A full-accept
+// round leaves the accepted tokens DECODED in both contexts, queued here for
+// gen_segment to consume through its normal cut checks without re-decoding; the
+// final correction token becomes `pending` (the next round's seed, not yet decoded).
+// If the segment cuts while the queue is non-empty (EOS inside the queue, token
+// limit), spec_rewind restores the pre-round checkpoint and batch-replays only the
+// consumed prefix -- state always equals committed + emitted text, the Q1 rule.
+struct spec_run {
+    common_speculative * spec    = nullptr;
+    llama_context      * ctx_dft = nullptr;
+    int   k = 8;
+
+    llama_tokens prompt;    // every token currently in the target state
+    int          n_past = 0;
+
+    std::deque<std::pair<llama_token, float>> q;  // accepted tokens (+ logprob), already decoded
+    llama_token pending    = -1;                  // correction token, NOT decoded
+    float       pending_lp = 0.0f;
+    bool        have_pending = false;
+
+    common_prompt_checkpoint ckpt;      // pre-round state (target + draft)
+    common_sampler_ptr       smpl_save; // pre-round sampler snapshot
+    llama_tokens             round_kept; // seed + queue tokens consumed this round
+    llama_batch              batch = {};
+
+    int  n_rounds = 0, n_drafted = 0, n_accepted = 0;
+    bool failed = false;
+};
+
+static bool spec_round (spec_run & sp, duo_model & m, llama_token seed);
+static void spec_rewind(spec_run & sp, duo_model & m);
+
