+            // the kept prefix, so state == committed + emitted (the Q1 rule)
+            spec_rewind(*sp, m);
+        }
+        sp->have_pending = false;  // an undecoded pending token is simply dropped
+    }
+
     if (opts.provisional) {
         // caller restores the memory via its checkpoint; nothing is committed here
     } else if (m.append_only && st.cut == "conf") {
@@ -1244,6 +1358,160 @@ static bool has_checkpoint(const duo_model & m) {
 // drop everything resident on seq 0 AND the bookkeeping that claims it is resident; the two
 // must move together or sync_to() will ingest a delta against a context that no longer holds
 // the prefix it assumes
+static double logprob_row(const float * z, int n, llama_token tok);
+
+// One amortizer round. Entry invariant: target state == sp.prompt, `seed` NOT yet
+// decoded. Exit (true): state == sp.prompt == old + seed + accepted; sp.q holds the
+// accepted tokens, sp.pending the correction. Mirrors examples/speculative-simple:
+// on partial acceptance the pre-round checkpoint is restored and the accepted ids
+// (correction included) replay as the next draft -- a hybrid context cannot rewind
+// partially, so rejected-but-decoded draft tokens are removed by restoring state
+// instead of trimming it.
+static bool spec_round(spec_run & sp, duo_model & m, llama_token seed) {
+    llama_memory_t mem_tgt = llama_get_memory(m.ctx.get());
+    llama_memory_t mem_dft = llama_get_memory(sp.ctx_dft);
+
+    sp.ckpt.update_pos((int64_t) sp.prompt.size(),
+                       llama_memory_seq_pos_min(mem_tgt, 0),
+                       llama_memory_seq_pos_max(mem_tgt, 0));
+    sp.ckpt.update_tgt(m.ctx.get(), 0, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+    sp.ckpt.update_dft(sp.ctx_dft,  0, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+    sp.smpl_save.reset(common_sampler_clone(m.smpl.get()));
+
+    llama_tokens draft;
+    for (int iter = 0; ; iter++) {
+        if (iter > 4 * sp.k + 8) {
+            // replay must terminate (each replay's ids are target-sampled, so the next
+            // verify accepts them); this bound only trips if that invariant breaks
+            fprintf(stderr, "error: spec_round replay did not converge\n");
+            return false;
+        }
+        if (draft.empty()) {
+            common_speculative_get_draft_params(sp.spec, 0) = {
+                /* .drafting = */ true,
+                /* .n_max    = */ -1,
+                /* .n_past   = */ sp.n_past,
+                /* .id_last  = */ seed,
+                /* .prompt   = */ &sp.prompt,
+                /* .result   = */ &draft,
+            };
+            common_speculative_draft(sp.spec);
+            sp.n_rounds++;
+            sp.n_drafted += (int) draft.size();
+            // drafting decoded the draft tokens into ctx_dft autoregressively; restore
+            // it to the pre-draft state so the verify batch below re-decodes the same
+            // positions cleanly (mirrors the load_dft+seq_rm step in speculative-simple)
+            sp.ckpt.load_dft(sp.ctx_dft, 0, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+            llama_memory_seq_rm(mem_dft, 0, sp.ckpt.pos_max + 1, -1);
+        }
+
+        common_sampler_ptr smpl_iter(common_sampler_clone(m.smpl.get()));
+
+        common_batch_clear(sp.batch);
+        common_batch_add(sp.batch, seed, sp.n_past, { 0 }, true);
+        for (size_t i = 0; i < draft.size(); i++) {
+            common_batch_add(sp.batch, draft[i], sp.n_past + 1 + (llama_pos) i, { 0 }, true);
+        }
+        if (llama_decode(m.ctx.get(), sp.batch) != 0) {
+            fprintf(stderr, "error: spec_round: target decode failed (batch %d tokens at n_past %d)\n",
+                    sp.batch.n_tokens, sp.n_past);
+            return false;
+        }
+        if (llama_decode(sp.ctx_dft, sp.batch) != 0) {
+            fprintf(stderr, "error: spec_round: draft-ctx decode failed (batch %d tokens at n_past %d)\n",
+                    sp.batch.n_tokens, sp.n_past);
+            return false;
+        }
+
+        auto ids = common_sampler_sample_and_accept_n(m.smpl.get(), m.ctx.get(), draft);
+        if (ids.empty()) {
+            fprintf(stderr, "error: spec_round: sample_and_accept_n returned no tokens\n");
+            return false;
+        }
+
+        if (ids.size() - 1 < draft.size()) {
+            // partial acceptance: restore both contexts and the sampler, replay ids
+            sp.ckpt.load_tgt(m.ctx.get(), 0, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+            llama_memory_seq_rm(mem_tgt, 0, sp.ckpt.pos_max + 1, -1);
+            sp.ckpt.load_dft(sp.ctx_dft, 0, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+            llama_memory_seq_rm(mem_dft, 0, sp.ckpt.pos_max + 1, -1);
+            sp.prompt.resize((size_t) sp.ckpt.n_tokens);
+            sp.n_past = (int) sp.prompt.size();
+            m.smpl = std::move(smpl_iter);
+            draft = std::move(ids);
+            continue;
+        }
+
+        // full acceptance: the batch's tokens stay decoded; queue them for consumption
+        common_speculative_accept(sp.spec, 0, (uint16_t) (ids.size() - 1));
+        sp.n_accepted += (int) ids.size() - 1;
+
+        const int n_vocab = llama_vocab_n_tokens(m.vocab);
+        sp.q.clear();
+        for (size_t j = 0; j + 1 < ids.size(); j++) {
+            const float * row = llama_get_logits_ith(m.ctx.get(), (int) j);
+            sp.q.emplace_back(ids[j], (float) logprob_row(row, n_vocab, ids[j]));
+        }
+        {
+            const float * row = llama_get_logits_ith(m.ctx.get(), (int) ids.size() - 1);
+            sp.pending      = ids.back();
+            sp.pending_lp   = (float) logprob_row(row, n_vocab, ids.back());
+            sp.have_pending = true;
+        }
+
+        sp.prompt.push_back(seed);
+        for (size_t j = 0; j + 1 < ids.size(); j++) {
+            sp.prompt.push_back(ids[j]);
+        }
+        sp.n_past = (int) sp.prompt.size();
+        // no-op on full accept (nothing decoded past n_past); kept to mirror the
+        // in-tree loop's cleanup exactly
+        llama_memory_seq_rm(mem_tgt, 0, sp.n_past, -1);
+        llama_memory_seq_rm(mem_dft, 0, sp.n_past, -1);
+        return true;
+    }
+}
+
+// Restore the pre-round checkpoint and batch-replay only the round tokens that the
+// segment actually consumed (seed + queue prefix). Called when a segment ends while
+// sp.q is non-empty -- the state then holds tokens past the emitted text.
+static void spec_rewind(spec_run & sp, duo_model & m) {
+    llama_memory_t mem_tgt = llama_get_memory(m.ctx.get());
+    llama_memory_t mem_dft = llama_get_memory(sp.ctx_dft);
+
+    sp.ckpt.load_tgt(m.ctx.get(), 0, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+    llama_memory_seq_rm(mem_tgt, 0, sp.ckpt.pos_max + 1, -1);
+    sp.ckpt.load_dft(sp.ctx_dft, 0, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+    llama_memory_seq_rm(mem_dft, 0, sp.ckpt.pos_max + 1, -1);
+    sp.prompt.resize((size_t) sp.ckpt.n_tokens);
+
+    // sampler: pre-round snapshot advanced by exactly the kept tokens
+    m.smpl.reset(common_sampler_clone(sp.smpl_save.get()));
+    for (llama_token t : sp.round_kept) {
+        common_sampler_accept(m.smpl.get(), t, true);
+    }
+
+    if (!sp.round_kept.empty()) {
+        common_batch_clear(sp.batch);
+        for (size_t i = 0; i < sp.round_kept.size(); i++) {
+            common_batch_add(sp.batch, sp.round_kept[i],
+                             (llama_pos) sp.prompt.size() + (llama_pos) i, { 0 },
+                             i + 1 == sp.round_kept.size());
+        }
+        if (llama_decode(m.ctx.get(), sp.batch) != 0 ||
+            llama_decode(sp.ctx_dft, sp.batch) != 0) {
+            fprintf(stderr, "error: spec_rewind replay decode failed\n");
+            sp.failed = true;
+        }
+        for (llama_token t : sp.round_kept) {
+            sp.prompt.push_back(t);
+        }
+    }
+    sp.n_past = (int) sp.prompt.size();
+    sp.q.clear();
+    sp.round_kept.clear();
+}
+
 static void front_reset(duo_model & m) {
     llama_memory_seq_rm(llama_get_memory(m.ctx.get()), 0, -1, -1);
