From 876504a044711a5e80888dc6ba799183b03b20a0 Mon Sep 17 00:00:00 2001
From: iitimii <timiiowolabi@gmail.com>
Date: Wed, 12 Aug 2026 20:58:23 +0100
Subject: [PATCH 19/24] S1a: fix sweep primitives, scope madvise policy to
 streamed loads

Task review found the eviction sweep never reclaimed a byte, and a
performance regression in the flag-less bundle-load path. Both are
fixed here, plus a gate-consistency bug the same review caught.

Critical: discard_range() used posix_madvise(POSIX_MADV_DONTNEED)
alone. POSIX defines that advice as non-destructive, a different
contract from Linux's actual MADV_DONTNEED -- scripts/stream_probe.c,
the instrument that validated this primitive in Task A3, calls the
raw madvise(2) syscall, never posix_madvise. Worse, even the correct
primitive is only half the mechanism: docs/DISCOVERY.md S0.3 step 2
measured madvise(DONTNEED) alone at delta=0 (uncharges nothing); the
key measurement (step 3, confirmed by the step 3b ordering control) is
posix_fadvise(DONTNEED) issued strictly after madvise(DONTNEED). The
fadvise half was entirely missing, and llama_mmap held no fd to make
the call with.

discard_range() now issues the raw madvise(MADV_DONTNEED) syscall
under __linux__ (an honest no-op elsewhere; Darwin's MADV_DONTNEED is
advisory-only and never evicts, per S0.3's own macOS run). A new
sibling llama_mmap::fadvise_discard(fd, first, last) issues
posix_fadvise(DONTNEED), also Linux-only. The load_all_data() call
site now sequences discard_range() -> unmap_fragment() (the
pre-existing unconditional munmap) -> fadvise_discard(), strictly
after the PTEs are gone, mirroring S0.3 step 3b-iv. The fd comes from
files.at(idx)->file_id(), already in scope at the call site.

Important: the RANDOM/NOHUGEPAGE/skip-SEQUENTIAL access-pattern policy
was applied to every bundle load, not just genuinely streamed ones. A
plain --bundle-prefix load with no --stream-weights (llama-duo's
default path) wants ordinary sequential readahead; forcing
POSIX_MADV_RANDOM onto it only hurts. init_mappings() now passes
stream_weights (not stream_no_populate()) as the llama_mmap ctor's
stream argument. Populate/WILLNEED suppression (the prefetch argument)
is unchanged, still keyed on stream_no_populate() -- B3's bundle-wide
cgroup-fairness rationale does not depend on the access-pattern hint.

Important: the sweep's own gate was !bundle_prefix.empty(), so a
--stream-weights load of a plain single-file model never got swept,
contradicting the intended stream_no_populate() predicate. Gate
changed to stream_no_populate() directly; no separate magnitude check
needed since discard_range()/fadvise_discard() already collapse to a
zero-length, page-aligned no-op (same align_range() idiom
unmap_fragment() uses) whenever the outside range is empty or
sub-page, which is what a genuine single-model load's near-full-file
used range naturally produces.

Assisted-by: Claude Fable 5
---
 src/llama-mmap.cpp         | 62 ++++++++++++++++++++++++++++++++++++--
 src/llama-mmap.h           |  7 ++++-
 src/llama-model-loader.cpp | 37 ++++++++++++++++++++---
 3 files changed, 98 insertions(+), 8 deletions(-)

diff --git a/src/llama-mmap.cpp b/src/llama-mmap.cpp
index 9bd61a9..43fc98c 100644
--- a/src/llama-mmap.cpp
+++ b/src/llama-mmap.cpp
@@ -540,8 +540,18 @@ struct llama_mmap::impl {
         mapped_fragments = std::move(new_mapped_fragments);
     }
 
-    // evict the page-cache pages backing [first, last) without touching the mapping itself
+    // Drop this mapping's PTEs over [first, last) -- half of the eviction
+    // primitive (docs/DISCOVERY.md S0.3): must run before fadvise_discard(),
+    // which is a silent no-op on pages still mapped by a live PTE (step 3b).
+    // glibc's posix_madvise(POSIX_MADV_DONTNEED) is not the same call as raw
+    // madvise(MADV_DONTNEED) -- POSIX forbids that advice from being
+    // destructive, so use the raw syscall, matching what stream_probe.c
+    // actually measured. MADV_DONTNEED is advisory-only on Darwin (mincore
+    // stayed 100% resident through every S0.3 step there) and there is no fd
+    // to fall back to fadvise with either, so this is an honest no-op off
+    // Linux rather than a call that silently does nothing.
     void discard_range(size_t first, size_t last) {
+#ifdef __linux__
         int page_size = sysconf(_SC_PAGESIZE);
         align_range(&first, &last, page_size);
         size_t len = last - first;
@@ -552,9 +562,39 @@ struct llama_mmap::impl {
 
         void * range_start = (uint8_t *) addr + first;
 
-        if (posix_madvise(range_start, len, POSIX_MADV_DONTNEED)) {
-            LLAMA_LOG_WARN("warning: posix_madvise(.., POSIX_MADV_DONTNEED) failed: %s\n", strerror(errno));
+        if (madvise(range_start, len, MADV_DONTNEED)) {
+            LLAMA_LOG_WARN("warning: madvise(.., MADV_DONTNEED) failed: %s\n", strerror(errno));
+        }
+#else
+        GGML_UNUSED(first);
+        GGML_UNUSED(last);
+#endif
+    }
+
+    // Evict the page-cache pages backing [first, last) of the underlying
+    // file via fd -- the other half of the eviction primitive. Must run
+    // after this range's PTEs are already gone (discard_range() and/or
+    // unmap_fragment()); see docs/DISCOVERY.md S0.3 step 3b ("PTEs-first
+    // ordering"). addr-offset == file-offset since the mapping is
+    // whole-file-at-0. No posix_fadvise on Darwin, honest no-op there.
+    void fadvise_discard(int fd, size_t first, size_t last) {
+#ifdef __linux__
+        int page_size = sysconf(_SC_PAGESIZE);
+        align_range(&first, &last, page_size);
+        size_t len = last - first;
+
+        if (len == 0) {
+            return;
+        }
+
+        if (posix_fadvise(fd, (off_t) first, (off_t) len, POSIX_FADV_DONTNEED)) {
+            LLAMA_LOG_WARN("warning: posix_fadvise(.., POSIX_FADV_DONTNEED) failed: %s\n", strerror(errno));
         }
+#else
+        GGML_UNUSED(fd);
+        GGML_UNUSED(first);
+        GGML_UNUSED(last);
+#endif
     }
 
     ~impl() {
@@ -622,6 +662,12 @@ struct llama_mmap::impl {
         GGML_UNUSED(last);
     }
 
+    void fadvise_discard(int fd, size_t first, size_t last) {
+        GGML_UNUSED(fd);
+        GGML_UNUSED(first);
+        GGML_UNUSED(last);
+    }
+
     ~impl() {
         if (hMapping) {
             if (addr) {
@@ -659,6 +705,14 @@ struct llama_mmap::impl {
 
         throw std::runtime_error("mmap not supported");
     }
+
+    void fadvise_discard(int fd, size_t first, size_t last) {
+        GGML_UNUSED(fd);
+        GGML_UNUSED(first);
+        GGML_UNUSED(last);
+
+        throw std::runtime_error("mmap not supported");
+    }
 #endif
 
     void * addr;
@@ -675,6 +729,8 @@ void llama_mmap::unmap_fragment(size_t first, size_t last) { pimpl->unmap_fragme
 
 void llama_mmap::discard_range(size_t first, size_t last) { pimpl->discard_range(first, last); }
 
+void llama_mmap::fadvise_discard(int fd, size_t first, size_t last) { pimpl->fadvise_discard(fd, first, last); }
+
 #if defined(_POSIX_MEMLOCK_RANGE) || defined(_WIN32)
 const bool llama_mmap::SUPPORTED  = true;
 #else
diff --git a/src/llama-mmap.h b/src/llama-mmap.h
index 79df66b..d7df4f5 100644
--- a/src/llama-mmap.h
+++ b/src/llama-mmap.h
@@ -50,8 +50,13 @@ struct llama_mmap {
 
     void unmap_fragment(size_t first, size_t last);
 
-    // drop cached pages over [first, last) without unmapping (page-cache eviction only)
+    // Eviction primitive, two halves that must run in order (docs/DISCOVERY.md S0.3):
+    // 1. discard_range() drops this mapping's PTEs over [first, last).
+    // 2. fadvise_discard() then evicts the now-unmapped page-cache pages via fd.
+    // Calling fadvise_discard() before this range's PTEs are gone (discard_range()
+    // and/or unmap_fragment()) is a silent no-op (S0.3 step 3b).
     void discard_range(size_t first, size_t last);
+    void fadvise_discard(int fd, size_t first, size_t last);
 
     static const bool SUPPORTED;
 
diff --git a/src/llama-model-loader.cpp b/src/llama-model-loader.cpp
index 6daf46b..973a414 100644
--- a/src/llama-model-loader.cpp
+++ b/src/llama-model-loader.cpp
@@ -1377,8 +1377,15 @@ void llama_model_loader::init_mappings(bool prefetch, llama_mlocks * mlock_mmaps
                 }
             }
 
+            // Populate/WILLNEED suppression applies to any bundle member (B3): a
+            // non-streamed tier populating the whole shared file would still charge
+            // the cgroup for every other tier's bytes. The RANDOM/NOHUGEPAGE/no-SEQ
+            // access-pattern policy is narrower: it only helps a genuinely streamed
+            // load's random-touch pattern, and actively hurts a plain bundle load's
+            // sequential read (llama-duo's default path wants readahead), so it is
+            // keyed on stream_weights alone, not stream_no_populate().
             std::unique_ptr<llama_mmap> mapping = std::make_unique<llama_mmap>(
-                    file.get(), (prefetch && !stream_no_populate()) ? -1 : 0, is_numa, stream_no_populate());
+                    file.get(), (prefetch && !stream_no_populate()) ? -1 : 0, is_numa, stream_weights);
             mmaps_used.emplace_back(mapping->size(), 0);
             if (mlock_mmaps) {
                 std::unique_ptr<llama_mlock> mlock_mmap(new llama_mlock());
@@ -1703,18 +1710,40 @@ bool llama_model_loader::load_all_data(
             for (uint32_t idx = 0; idx < mappings.size(); idx++) {
                 const auto & mmap_used = mmaps_used.at(idx);
                 auto & mapping = mappings.at(idx);
-                if (!bundle_prefix.empty()) {
-                    // bundle members share one file: evict this model's foreign
-                    // page-cache charge before trimming the mapping (S1a/B3)
+
+                // Any load that shares its file's page cache with a sibling load
+                // (bundle members) or wants tight RAM control (stream_weights)
+                // sweeps its unused range out of the cgroup's charge. A plain
+                // single-model load naturally no-ops here: its used range already
+                // covers ~the whole file, so both halves below collapse to a
+                // zero-length, page-aligned range and do nothing (S1a/B3, B1
+                // review finding 3).
+                const bool sweep = stream_no_populate();
+
+                // Eviction primitive, in order (docs/DISCOVERY.md S0.3): drop this
+                // range's PTEs first (discard_range(), then unmap_fragment() which
+                // was already unconditional here), THEN evict the now-unmapped
+                // page-cache pages via fd (fadvise_discard()) -- fadvise before the
+                // PTEs are gone is a silent no-op (S0.3 step 3b).
+                if (sweep) {
                     mapping->discard_range(0, mmap_used.first);
                     if (mmap_used.second != 0) {
                         mapping->discard_range(mmap_used.second, mapping->size());
                     }
                 }
+
                 mapping->unmap_fragment(0, mmap_used.first);
                 if (mmap_used.second != 0) {
                     mapping->unmap_fragment(mmap_used.second, mapping->size());
                 }
+
+                if (sweep) {
+                    int fd = files.at(idx)->file_id();
+                    mapping->fadvise_discard(fd, 0, mmap_used.first);
+                    if (mmap_used.second != 0) {
+                        mapping->fadvise_discard(fd, mmap_used.second, mapping->size());
+                    }
+                }
             }
         }
         if (progress_callback) {
