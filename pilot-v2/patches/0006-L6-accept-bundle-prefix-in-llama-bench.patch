From b1c6958808219d038ea826388fa61c7c4218b2c9 Mon Sep 17 00:00:00 2001
From: iitimii <timiiowolabi@gmail.com>
Date: Sun, 9 Aug 2026 08:10:07 +0100
Subject: [PATCH 06/16] L6: accept --bundle-prefix in llama-bench

Assisted-by: Claude Fable 5
---
 tools/llama-bench/llama-bench.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/tools/llama-bench/llama-bench.cpp b/tools/llama-bench/llama-bench.cpp
index c17a27b..124363a 100644
--- a/tools/llama-bench/llama-bench.cpp
+++ b/tools/llama-bench/llama-bench.cpp
@@ -319,6 +319,9 @@ static std::vector<int> parse_int_range(const std::string & s, bool allow_negati
     return result;
 }
 
+// bundle sub-model prefix, applies to all test instances
+static std::string g_bundle_prefix;
+
 struct cmd_params {
     std::vector<std::string>         model;
     std::vector<std::string>         hf_repo;
@@ -563,6 +566,12 @@ static cmd_params parse_cmd_params(int argc, char ** argv) {
                     break;
                 }
                 params.hf_token = argv[i];
+            } else if (arg == "--bundle-prefix") {
+                if (++i >= argc) {
+                    invalid_param = true;
+                    break;
+                }
+                g_bundle_prefix = argv[i];
             } else if (arg == "--offline") {
                 params.offline = true;
             } else if (arg == "-p" || arg == "--n-prompt") {
@@ -1216,6 +1225,9 @@ struct cmd_params_instance {
     llama_model_params to_llama_mparams() const {
         llama_model_params mparams = llama_model_default_params();
 
+        if (!g_bundle_prefix.empty()) {
+            mparams.bundle_prefix = g_bundle_prefix.c_str();
+        }
         mparams.n_gpu_layers = n_gpu_layers;
         if (!devices.empty()) {
             mparams.devices = const_cast<ggml_backend_dev_t *>(devices.data());
-- 
