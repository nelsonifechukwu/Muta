{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muta.local/schemas/offline-unit-v1.json",
  "title": "Muta offline interactive unit",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "topic", "title", "summary", "estimated_minutes", "sections", "checkpoint", "citations"],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "topic": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 160},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "estimated_minutes": {"type": "integer", "minimum": 1, "maximum": 180},
    "sections": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "markdown"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 160},
          "markdown": {"type": "string", "maxLength": 10000},
          "visualization": {
            "type": "object",
            "required": ["version", "library", "renderer", "kind", "family", "title", "aria_label", "text_fallback", "height", "budget"],
            "properties": {
              "version": {"const": 2},
              "library": {"type": "string", "enum": ["d3", "three", "gsap", "motion", "anime", "canvas"]},
              "renderer": {"type": "string", "enum": ["svg", "canvas2d", "webgl"]},
              "kind": {"type": "string", "minLength": 1},
              "family": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1},
              "aria_label": {"type": "string", "minLength": 1},
              "text_fallback": {"type": "string", "minLength": 1},
              "height": {"type": "integer", "minimum": 220, "maximum": 720},
              "budget": {"type": "object"}
            }
          }
        }
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "instructions", "questions"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "instructions": {"type": "string", "minLength": 1, "maxLength": 1000},
        "questions": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "prompt", "feedback"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
              "prompt": {"type": "string", "minLength": 1, "maxLength": 1000},
              "feedback": {"type": "string", "minLength": 1, "maxLength": 1000}
            }
          }
        }
      }
    },
    "citations": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "url", "note"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 300},
          "url": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2000},
          "note": {"type": "string", "maxLength": 1000}
        }
      }
    }
  }
}
