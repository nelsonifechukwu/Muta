{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muta.local/schemas/course-v2.json",
  "title": "Muta portable offline course",
  "description": "Declarative, non-executable course package stored with a .muta extension.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "id", "title", "subject", "level", "description", "estimated_minutes", "exams", "author", "license", "concepts", "chapters", "activities", "games", "playgrounds", "sources"],
  "properties": {
    "version": {"const": 2},
    "kind": {"const": "course"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 180},
    "subject": {"enum": ["Artificial Intelligence", "Mathematics", "Physical Science", "Life Science", "History"]},
    "level": {"type": "string", "minLength": 1, "maxLength": 100},
    "description": {"type": "string", "minLength": 1, "maxLength": 700},
    "estimated_minutes": {"type": "integer", "minimum": 5, "maximum": 600},
    "exams": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 40}},
    "author": {"$ref": "#/$defs/credit"},
    "license": {"$ref": "#/$defs/credit"},
    "concepts": {"type": "array", "minItems": 1, "maxItems": 80, "items": {"$ref": "#/$defs/concept"}},
    "chapters": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"$ref": "#/$defs/chapter"}},
    "activities": {"type": "array", "minItems": 3, "maxItems": 120, "items": {"$ref": "#/$defs/activity"}},
    "games": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/game"}},
    "playgrounds": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/playground"}},
    "sources": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "credit": {
      "type": "object", "additionalProperties": false, "required": ["name", "url"],
      "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 120}, "url": {"type": "string", "maxLength": 2000}}
    },
    "concept": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "prerequisites"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"}, "title": {"type": "string", "minLength": 1, "maxLength": 140}, "prerequisites": {"type": "array", "maxItems": 12, "items": {"type": "string"}}}
    },
    "chapter": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "summary", "concept_ids", "blocks"],
      "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "summary": {"type": "string"}, "concept_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "blocks": {"type": "array", "minItems": 1, "maxItems": 40, "items": {"type": "object"}}}
    },
    "activity": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "concept_id", "prompt", "explanation"],
      "properties": {"id": {"type": "string"}, "type": {"enum": ["mcq", "numeric"]}, "concept_id": {"type": "string"}, "prompt": {"type": "string"}, "options": {"type": "array", "items": {"type": "string"}}, "answer": {}, "tolerance": {"type": "number", "minimum": 0}, "explanation": {"type": "string"}, "exam_style": {"enum": ["WAEC-style", "JAMB-style", "Course practice"]}, "difficulty": {"type": "string"}}
    },
    "game": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "title", "description", "concept_id", "rounds"],
      "properties": {"id": {"type": "string"}, "type": {"const": "challenge"}, "title": {"type": "string"}, "description": {"type": "string"}, "concept_id": {"type": "string"}, "rounds": {"type": "array", "minItems": 3, "maxItems": 12, "items": {"type": "object"}}}
    },
    "playground": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "description", "concept_id", "spec"],
      "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "description": {"type": "string"}, "concept_id": {"type": "string"}, "spec": {"type": "object"}}
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["title", "url", "note", "license"],
      "properties": {"title": {"type": "string"}, "url": {"type": "string", "pattern": "^https://"}, "note": {"type": "string"}, "license": {"type": "string"}}
    }
  }
}
