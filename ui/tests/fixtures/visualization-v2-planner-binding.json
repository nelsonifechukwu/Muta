          {"id": "circle_radius", "label": "Circle radius", "type": "range", "value": 22, "min": 10, "max": 50, "step": 2, "binding": {"target_label": "sample circle", "effect": "radius"}},
          {"id": "rect_x", "label": "Rectangle horizontal position", "type": "range", "value": 0, "min": -80, "max": 80, "step": 10, "binding": {"target_label": "sample rectangle", "effect": "translate_x"}},
          {"id": "rect_y", "label": "Rectangle vertical position", "type": "range", "value": 0, "min": -80, "max": 80, "step": 10, "binding": {"target_label": "sample rectangle", "effect": "translate_y"}},
          {"id": "rect_scale", "label": "Rectangle scale", "type": "range", "value": 1, "min": 0.5, "max": 1.5, "step": 0.1, "binding": {"target_label": "sample rectangle", "effect": "scale"}}
