{
  "schema_version": 1,
  "count": 6,
  "cases": [
    {
      "id": "planner-binding-001",
      "spec": {
        "version": 2,
        "library": "d3",
        "renderer": "svg",
        "kind": "scene2d",
        "family": "semantic_composition",
        "title": "Mangrove food web",
        "aria_label": "A mangrove food web with adjustable crab height.",
        "text_fallback": "Energy flows from algae to crab to heron; the crab height control moves the crab and its links.",
        "height": 420,
        "controls": [
          {
            "id": "crab_height",
            "label": "Crab height",
            "type": "range",
            "value": 0,
            "min": -80,
            "max": 80,
            "step": 10,
            "binding": {
              "target_label": "Crab",
              "effect": "translate_y"
            }
          },
          {
            "id": "play",
            "label": "Play",
            "type": "button",
            "value": 0
          },
          {
            "id": "pause",
            "label": "Pause",
            "type": "button",
            "value": 0
          },
          {
            "id": "restart",
            "label": "Restart",
            "type": "button",
            "value": 0
          }
        ],
        "budget": {
          "max_points": 512,
          "max_triangles": 1,
          "max_fps": 20
        },
        "scene": {
          "coordinate_system": "screen",
          "animation": {
            "mode": "guided_reveal",
            "duration": 4
          },
          "layers": [
            {
              "type": "axes",
              "x_label": "trophic level",
              "y_label": "height",
              "grid": false
            },
            {
              "type": "node",
              "id": "algae",
              "x": 120,
              "y": 300,
              "width": 110,
              "height": 54,
              "label": "Algae",
              "color": "green"
            },
            {
              "type": "node",
              "id": "crab",
              "x": 350,
              "y": 210,
              "width": 110,
              "height": 54,
              "label": "Crab",
              "color": "orange"
            },
            {
              "type": "node",
              "id": "heron",
              "x": 580,
              "y": 110,
              "width": 110,
              "height": 54,
              "label": "Heron",
              "color": "blue"
            },
            {
              "type": "link",
              "from": "algae",
              "to": "crab",
              "arrow": true,
              "label": "energy"
            },
            {
              "type": "link",
              "from": "crab",
              "to": "heron",
              "arrow": true,
              "label": "energy"
            }
          ]
        }
      }
    },
    {
      "id": "planner-binding-svg-curves-nodes-arrows",
      "spec": {
        "version": 2,
        "library": "d3",
        "renderer": "svg",
        "kind": "scene2d",
        "family": "binding_matrix_svg_a",
        "title": "SVG binding matrix A",
        "aria_label": "A curve, node, and arrow with bounded translation and scale controls.",
        "text_fallback": "Each control changes its labelled SVG geometry inside a stable coordinate frame.",
        "height": 420,
        "controls": [
          {"id": "curve_x", "label": "Curve horizontal position", "type": "range", "value": 0, "min": -2, "max": 2, "step": 0.25, "binding": {"target_label": "response curve", "effect": "translate_x"}},
          {"id": "curve_y", "label": "Curve vertical position", "type": "range", "value": 0, "min": -2, "max": 2, "step": 0.25, "binding": {"target_label": "response curve", "effect": "translate_y"}},
          {"id": "curve_scale", "label": "Curve scale", "type": "range", "value": 1, "min": 0.5, "max": 1.5, "step": 0.1, "binding": {"target_label": "response curve", "effect": "scale"}},
          {"id": "node_x", "label": "Node horizontal position", "type": "range", "value": 0, "min": -80, "max": 80, "step": 10, "binding": {"target_label": "process node", "effect": "translate_x"}},
          {"id": "node_y", "label": "Node vertical position", "type": "range", "value": 0, "min": -80, "max": 80, "step": 10, "binding": {"target_label": "process node", "effect": "translate_y"}},
          {"id": "node_scale", "label": "Node scale", "type": "range", "value": 1, "min": 0.5, "max": 1.5, "step": 0.1, "binding": {"target_label": "process node", "effect": "scale"}},
          {"id": "arrow_x", "label": "Arrow horizontal position", "type": "range", "value": 0, "min": -80, "max": 80, "step": 10, "binding": {"target_label": "process arrow", "effect": "translate_x"}},
          {"id": "arrow_y", "label": "Arrow vertical position", "type": "range", "value": 0, "min": -80, "max": 80, "step": 10, "binding": {"target_label": "process arrow", "effect": "translate_y"}}
        ],
        "budget": {"max_points": 64, "max_triangles": 1, "max_fps": 20},
        "scene": {
          "coordinate_system": "screen",
          "layers": [
            {"type": "axes", "x_label": "input", "y_label": "output", "grid": true},
            {"type": "polyline", "label": "response curve", "points": [[0, 0], [1, 2], [2, 1]], "color": "teal"},
            {"type": "node", "id": "process", "x": 340, "y": 180, "width": 130, "height": 56, "label": "process node", "color": "orange"},
            {"type": "arrow", "from": [120, 300], "to": [260, 240], "label": "process arrow", "color": "blue"}
          ]
        }
      }
    },
