          "layers": [
            {"type": "arrow", "from": [100, 310], "to": [280, 190], "label": "force arrow", "color": "blue"},
            {"type": "circle", "x": 390, "y": 170, "r": 22, "label": "sample circle", "color": "teal"},
            {"type": "rect", "x": 520, "y": 260, "width": 120, "height": 70, "label": "sample rectangle", "color": "orange"}
          ]
        }
      }
