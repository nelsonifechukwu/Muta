    {
      "id": "followup-pythagoras",
      "spec": {
        "version": 2,
        "library": "d3",
        "renderer": "svg",
        "kind": "scene2d",
        "family": "pythagoras",
        "title": "Animated: Pythagoras",
        "aria_label": "Interactive pythagoras visualization with labelled relationships and controls.",
        "text_fallback": "Pythagoras. Visible layers: right triangle; square on a; square on b; square on c. Adjustable controls: A, B.",
        "height": 420,
        "controls": [
          {
            "id": "a",
            "label": "A",
            "type": "range",
            "value": 3,
            "min": 1,
            "max": 10,
            "step": 0.1
          },
          {
            "id": "b",
            "label": "B",
            "type": "range",
            "value": 4,
            "min": 1,
            "max": 10,
            "step": 0.1
          },
          {
            "id": "play",
            "label": "Play",
            "type": "button",
            "value": 0
          },
          {
            "id": "pause",
            "label": "Pause",
            "type": "button",
            "value": 0
          },
          {
            "id": "restart",
            "label": "Restart",
            "type": "button",
            "value": 0
          }
        ],
        "budget": {
          "max_points": 4096,
          "max_triangles": 32000,
          "max_fps": 30
        },
        "scene": {
          "coordinate_system": "cartesian2d",
          "layers": [
            {
              "type": "axes",
              "x_label": "x",
              "y_label": "y",
              "grid": true
            },
            {
              "type": "polyline",
              "label": "right triangle",
              "points": [
