# One env file switches the whole system between serving profiles (TDD §10.5).
#
#   PROFILE=classroom   6 slots x 2048 ctx, Piper TTS, no mlock, vision on demand
#   PROFILE=solo-demo   2 slots x 4096 ctx, Kokoro resident, mlock'd weights (D9)
#
# Everything below is read by runtime/profiles.py; nothing in the code hardcodes a slot
# count or a context size. `install.sh` rewrites PROFILE= and copies this to /opt/tutor/etc.
PROFILE=classroom
TUTOR_ROOT=/opt/tutor

# --- Engine binary (D4: A guaranteed, B/C only after they win a bench on the target box) --
TUTOR_ENGINE_VARIANT=A
TUTOR_LLAMA_SERVER_BIN=${TUTOR_ROOT}/bin/llama-server-core

# --- Ports (TDD §3) ----------------------------------------------------------------------
TUTOR_GATEWAY_PORT=8080
TUTOR_CORE_PORT=8081
TUTOR_VISION_PORT=8082
TUTOR_EMBED_PORT=8083
TUTOR_ASR_PORT=8084
TUTOR_TTS_PORT=8085
TUTOR_DRAFT_PORT=8086

# --- Threads: 0 = derive from the §6.4 table for this box's physical core count -----------
TUTOR_CORE_THREADS=0
TUTOR_CORE_THREADS_BATCH=0
TUTOR_VISION_THREADS=0

# --- Gates that are still open (TDD §14) --------------------------------------------------
# D2 speculation: c (none) is the default; b (draft model) only after it clears 1.43x/GiB.
TUTOR_SPECULATION=c
# D5 premium TTS: piper everywhere; kokoro only in solo-demo, and only if RSS allows.
TUTOR_TTS_ENGINE=piper
# D6 KV cache type: q8_0 ships; the ladder (f16/q8_0/q5_1) is swept in bench week.
TUTOR_KV_TYPE=q8_0
# D9 mlock: off in classroom (reclaim pathologies under a strict cgroup cap), on in solo-demo.
TUTOR_MLOCK=0
