# GATEWAY — the only LAN-exposed surface (TDD §7.1, §13). Also owns the degradation ladder,
# the CORE-VISION process manager and the tool subprocess pools, so its cap has to cover the
# FAISS mmap and the Python heap that has a documented tendency to creep (§16 risk row).
[Unit]
Description=Tutor gateway (FastAPI)
After=tutor-core.service tutor-embed.service tutor-audio.service
Wants=tutor-core.service tutor-embed.service

[Service]
Type=exec
Slice=tutor.slice
WorkingDirectory=@ROOT@/gw
EnvironmentFile=@ROOT@/etc/profile.env
Environment=TUTOR_ROOT=@ROOT@
ExecStart=@ROOT@/gw/venv/bin/python -m uvicorn orchestrator.main:app --host 0.0.0.0 --port 8080 --workers 1
Restart=on-failure
RestartSec=2

MemoryMax=600M
MemoryHigh=540M
CPUWeight=400
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=@ROOT@/data
# The gateway spawns CORE-VISION as a transient scope (systemd-run) and tool subprocesses,
# so it may not be locked down further than this.
