# AUDIO — sherpa-onnx ASR + VAD + TTS (TDD §6.6, §10.4).
#
# CPUAffinity is not tuning, it is judge-perception: an audio dropout mid-sentence is far
# more visible than 5% off the decode rate, so this service gets a core that the core-text
# prefill storm cannot take. Pin it to the last core; the thread table (§6.4) leaves it free.
[Unit]
Description=Tutor audio (sherpa-onnx ASR/TTS websockets)
After=network-online.target

[Service]
Type=exec
Slice=tutor.slice
WorkingDirectory=@ROOT@/gw
EnvironmentFile=@ROOT@/etc/profile.env
Environment=TUTOR_ROOT=@ROOT@
ExecStart=@ROOT@/gw/venv/bin/python -m orchestrator.audio.service
Restart=on-failure
RestartSec=2

MemoryMax=450M
MemoryHigh=405M
CPUWeight=300
CPUAffinity=@AUDIO_CPU@
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=@ROOT@/data
