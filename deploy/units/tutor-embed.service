# EMBED — bge-small on its own llama-server (TDD §6.7). Tiny, but its own process so RAG
# latency never queues behind a 1200-token tutoring answer on the core server.
[Unit]
Description=Tutor embedding server (llama-server --embeddings)
After=network-online.target

[Service]
Type=exec
Slice=tutor.slice
WorkingDirectory=@ROOT@/gw
EnvironmentFile=@ROOT@/etc/profile.env
Environment=TUTOR_ROOT=@ROOT@
ExecStart=@ROOT@/gw/venv/bin/python -m runtime.profiles exec embed
Restart=on-failure
RestartSec=2

MemoryMax=150M
MemoryHigh=135M
CPUWeight=100
NoNewPrivileges=yes
ProtectSystem=strict
