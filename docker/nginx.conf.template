# Frontend nginx: static UI + same-origin reverse proxy for the /v1 contract.
# Same-origin means no CORS anywhere; SSE needs buffering off; the voice loop needs
# WebSocket upgrade passthrough.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# The frontend container serves `/` itself, so FastAPI's `/ui` cache policy never sees these
# responses. Keep authored HTML/CSS/JS and their pinned dependencies as one load-time revision;
# the bundle is small and local, while a mixed cached revision can break auth and layout.
map $uri $muta_cache_control {
    default "no-store, max-age=0";
    ~^/v1/ "";
}

# Security headers, applied to every response (static, proxied, and errors) via `always`.
# Kept in one place and pulled into the server with `include` so they cannot drift between
# locations.
#
# CSP notes (verified against ui/index.html + app.js):
#   script-src 'self'      — every <script> is a vendored src=; there is NO inline JS.
#   style-src  'unsafe-inline' — KaTeX sets inline style="" attributes on rendered math.
#   img-src    blob: data: — image previews use URL.createObjectURL (blob:).
#   connect-src ws: wss:   — the voice loop opens a same-origin WebSocket.
# 'unsafe-inline' is scoped to STYLES only (cannot execute JS); scripts stay locked to self,
# so this is the real backstop behind DOMPurify, not a rubber stamp.

server {
    listen 80;
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=(self)" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ws: wss:; media-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header Cache-Control $muta_cache_control always;

    location /v1/ {
        # ${BACKEND_UPSTREAM} is substituted by the nginx image's envsubst entrypoint at
        # container start (default set in docker-compose.yml). Docker mode: backend:8000.
        # Native mode (run.sh --native): host.docker.internal:8000 — the gateway on the host.
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        # WS when upgrading, plain keepalive otherwise (the map above).
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        # Correlation id: reuse an inbound one or let nginx mint $request_id, and pass it to
        # the gateway so one turn is traceable browser → nginx → gateway (orchestrator logs).
        proxy_set_header X-Request-ID $request_id;
        # SSE: flush frames through instead of buffering a "complete" response.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # Image guard allows 8 MiB; audio uploads can be larger. Default 1m would 413.
        client_max_body_size 32m;
    }

    location / {
        try_files $uri /index.html;
    }
}

# --- TLS for LAN / classroom deployment (opt-in) ---------------------------------------
# The mic (getUserMedia) and the voice WebSocket require a SECURE CONTEXT. Browsers treat
# http://localhost as secure but NOT http://<lan-ip>, so over the classroom LAN the flagship
# voice loop is dead on plain :80 — every phone that is not the host machine gets the mic
# refused. Serving :443 with a locally-trusted cert fixes it, fully offline (no public CA).
#
# To enable (documented in RUN.md / docs/tls-lan.md):
#   1. Generate a local CA + server cert (e.g. mkcert, or the helper in scripts/) and mount
#      them at /etc/nginx/certs/ (fullchain.pem + privkey.pem).
#   2. Install the local CA on each classroom device once (the one-time trust step).
#   3. Uncomment the block below and redeploy; keep :80 only to redirect to :443.
#
# server {
#     listen 443 ssl;
#     http2 on;
#     server_name _;
#     ssl_certificate     /etc/nginx/certs/fullchain.pem;
#     ssl_certificate_key /etc/nginx/certs/privkey.pem;
#     ssl_protocols TLSv1.2 TLSv1.3;
#     root /usr/share/nginx/html;
#     include /etc/nginx/snippets/muta-headers.conf;   # the add_header set above, extracted
#     # ... same location /v1/ and location / blocks as the :80 server ...
# }
# server { listen 80; server_name _; return 301 https://$host$request_uri; }
